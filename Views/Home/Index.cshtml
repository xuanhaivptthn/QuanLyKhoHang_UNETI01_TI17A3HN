@model IEnumerable<QuanLyKhoHang_UNETI01_TI17A3HN.Models.TaiKhoan>
@inject QuanLyKhoHang_UNETI01_TI17A3HN.Models.DatabaseInfo DbInfo
@{
    ViewData["Title"] = "Trang chủ - Hệ thống Quản lý Kho hàng";
}

<!-- Database Connection Status Notification -->
@if (DbInfo != null)
{
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body py-3 px-4 d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div class="d-flex align-items-center gap-3">
                @if (DbInfo.IsRemote)
                {
                    <span class="d-inline-flex p-2 bg-success bg-opacity-10 text-success rounded-circle">
                        <i class="bi bi-cloud-check-fill fs-4"></i>
                    </span>
                    <div>
                        <div class="fw-bold text-success mb-0 d-flex align-items-center gap-2">
                            <span>Đang kết nối Server CSDL Chung (Azure SQL)</span>
                            <span class="badge bg-success">Đồng bộ</span>
                        </div>
                        <small class="text-muted">Máy chủ: @DbInfo.ServerName | Cơ sở dữ liệu: @DbInfo.DatabaseName</small>
                    </div>
                }
                else
                {
                    <span class="d-inline-flex p-2 bg-warning bg-opacity-10 text-warning rounded-circle">
                        <i class="bi bi-hdd-fill fs-4"></i>
                    </span>
                    <div>
                        <div class="fw-bold text-warning mb-0 d-flex align-items-center gap-2">
                            <span>Đang sử dụng CSDL Cục bộ (LocalDB)</span>
                            <span class="badge bg-warning text-dark">Chế độ Fallback</span>
                        </div>
                        <small class="text-muted">Hệ thống sẽ tự động chuyển đổi sang server chung khi kết nối khả dụng.</small>
                    </div>
                }
            </div>
            <div class="small text-muted font-monospace">
                Trạng thái: Hoạt động bình thường
            </div>
        </div>
    </div>
}

<!-- Test Accounts Card (Kiểm thử chức năng phân quyền) -->
<div class="card border-0 shadow-sm rounded-2">
    <div class="card-header bg-white py-3 d-flex align-items-center justify-content-between">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-shield-check text-primary fs-5"></i>
            <h5 class="fw-bold mb-0">Tài khoản</h5>
        </div>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">Tên đăng nhập</th>
                        <th>Mật khẩu</th>
                        <th>Họ và tên</th>
                        <th>Vai trò</th>
                        <th>Trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle bg-light d-flex align-items-center justify-content-center text-secondary" style="width: 32px; height: 32px;">
                                            <i class="bi bi-person"></i>
                                        </div>
                                        <strong>@item.TenDangNhap</strong>
                                    </div>
                                </td>
                                <td>
                                    <span class="font-monospace bg-light px-2 py-1 rounded border text-muted">@item.MatKhau</span>
                                </td>
                                <td>@item.HoTen</td>
                                <td>
                                    @if (item.VaiTro == "Admin")
                                    {
                                        <span class="badge bg-danger"><i class="bi bi-person-fill-gear me-1"></i> Quản trị viên (Admin)</span>
                                    }
                                    else if (item.VaiTro == "NhanVienKho")
                                    {
                                        <span class="badge bg-primary"><i class="bi bi-person-badge me-1"></i> Nhân viên kho</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@item.VaiTro</span>
                                    }
                                </td>
                                <td>
                                    @if (item.TrangThai)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">
                                            <i class="bi bi-check-circle-fill me-1"></i> Hoạt động
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                            <i class="bi bi-slash-circle me-1"></i> Bị khóa
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">Chưa có dữ liệu tài khoản.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>