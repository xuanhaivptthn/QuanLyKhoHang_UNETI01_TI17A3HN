@*
    Họ và tên: Trần Xuân Hải
    Mã sinh viên: 23103100135
    Phụ trách Module 1: Tài khoản, Đăng nhập, Phân quyền, Loại hàng & Đơn vị tính
*@
@{
    ViewData["Title"] = "Không có quyền truy cập";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-7 col-lg-6 text-center">
        <div class="card shadow-sm border-0 rounded-2">
            <div class="card-body p-5">
                <div class="text-danger mb-3">
                    <i class="bi bi-shield-lock-fill" style="font-size: 4.5rem;"></i>
                </div>
                <h2 class="text-danger fw-bold mb-3">Truy Cập Bị Từ Chối</h2>
                <p class="text-muted mb-4">
                    Tài khoản của bạn không có đủ quyền hạn để truy cập vào trang này. Vui lòng liên hệ Quản trị viên hệ thống (Admin) nếu bạn cần cấp quyền.
                </p>
                <div class="d-flex justify-content-center gap-2">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                        <i class="bi bi-house"></i> Về trang chủ
                    </a>
                    <a asp-controller="TaiKhoans" asp-action="DangXuat" class="btn btn-outline-danger">
                        <i class="bi bi-box-arrow-right"></i> Đăng nhập tài khoản khác
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
