@*
    Họ và tên: Nguyễn Thị Cúc
    Mã sinh viên: 23103100178
    Phụ trách Module 2: Quản lý Kho, Hàng hóa & Tra cứu dữ liệu cửa hàng
*@
@model QuanLyKhoHang_UNETI01_TI17A3HN.Models.Kho

@{
    ViewData["Title"] = "Chi tiết Kho hàng - " + Model.TenKho;
    var danhSachTon = ViewBag.DanhSachTonKho as List<QuanLyKhoHang_UNETI01_TI17A3HN.Models.TonKho> ?? new List<QuanLyKhoHang_UNETI01_TI17A3HN.Models.TonKho>();
    var tongSoLuongTon = danhSachTon.Sum(t => t.SoLuongTon);
}

<div class="page-header">
    <div>
        <h2 class="page-title"><i class="bi bi-building text-primary"></i> Chi Tiết Kho Hàng</h2>
        <p class="page-subtitle">Thông tin kho và danh sách hàng hóa thực tế đang lưu trữ</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.MaKho" class="btn btn-primary">
            <i class="bi bi-pencil-square"></i> Chỉnh sửa
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Quay lại
        </a>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-header bg-white py-3">
                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-info-circle text-primary me-2"></i> Hồ Sơ Kho Hàng</h5>
            </div>
            <div class="card-body p-4">
                <div class="mb-3">
                    <span class="badge bg-light text-primary border font-monospace px-2 py-1">Mã kho: #@Model.MaKho</span>
                    <h4 class="fw-bold text-dark mt-2 mb-1">@Model.TenKho</h4>
                </div>
                <hr class="text-secondary opacity-25" />
                <dl class="row gy-3 mb-0">
                    <dt class="col-sm-4 text-muted">Địa điểm:</dt>
                    <dd class="col-sm-8 fw-semibold"><i class="bi bi-geo-alt text-danger me-1"></i>@(string.IsNullOrEmpty(Model.DiaDiem) ? "Chưa cập nhật" : Model.DiaDiem)</dd>

                    <dt class="col-sm-4 text-muted">Mô tả:</dt>
                    <dd class="col-sm-8 text-muted">@(string.IsNullOrEmpty(Model.MoTa) ? "---" : Model.MoTa)</dd>

                    <dt class="col-sm-4 text-muted">Trạng thái:</dt>
                    <dd class="col-sm-8">
                        @if (Model.TrangThai)
                        {
                            <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i> Đang hoạt động</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary"><i class="bi bi-pause-circle me-1"></i> Ngừng hoạt động</span>
                        }
                    </dd>
                </dl>
            </div>
        </div>
    </div>

    <!-- Thống kê nhanh mặt hàng đang có trong kho -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-box-seam text-success me-2"></i> Thống Kê Hàng Hóa Trong Kho (@danhSachTon.Count mặt hàng)
                </h5>
                <span class="badge bg-primary fs-6">
                    Tổng tồn: @tongSoLuongTon món
                </span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th class="ps-4">Mã hàng</th>
                                <th>Tên hàng hóa</th>
                                <th class="text-center">Số lượng tồn</th>
                                <th class="text-end pe-4">Cập nhật</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (danhSachTon.Any())
                            {
                                foreach (var item in danhSachTon)
                                {
                                    <tr>
                                        <td class="ps-4 font-monospace text-muted">#@item.MaHang</td>
                                        <td class="fw-semibold">@(item.HangHoa?.TenHang ?? "Mặt hàng #" + item.MaHang)</td>
                                        <td class="text-center font-monospace fw-bold fs-6 text-primary">
                                            @item.SoLuongTon
                                        </td>
                                        <td class="text-end pe-4 text-muted small">
                                            @item.NgayCapNhat.ToString("dd/MM/yyyy HH:mm")
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-4">
                                        Kho hiện chưa có hàng hóa lưu trữ.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
