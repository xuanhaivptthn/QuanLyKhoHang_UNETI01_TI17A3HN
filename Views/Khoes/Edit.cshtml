@*
    Họ và tên: Nguyễn Thị Cúc
    Mã sinh viên: 23103100178
    Phụ trách Module 2: Quản lý Kho, Hàng hóa & Tra cứu dữ liệu cửa hàng
*@
@model QuanLyKhoHang_UNETI01_TI17A3HN.Models.Kho

@{
    ViewData["Title"] = "Chỉnh sửa kho hàng - " + Model.TenKho;
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="page-header">
            <div>
                <h2 class="page-title"><i class="bi bi-pencil-square text-primary"></i> Chỉnh Sửa Kho Hàng</h2>
                <p class="page-subtitle">Cập nhật thông tin mã kho #@Model.MaKho: <strong>@Model.TenKho</strong></p>
            </div>
            <div>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Quay lại danh sách
                </a>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-2">
            <div class="card-body p-4 p-md-5">
                <form asp-action="Edit" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4 py-2" role="alert"></div>
                    <input type="hidden" asp-for="MaKho" />

                    <div class="row g-3">
                        <div class="col-md-12">
                            <label asp-for="TenKho" class="form-label fw-semibold">
                                <i class="bi bi-building me-1 text-primary"></i> Tên kho hàng <span class="text-danger">*</span>
                            </label>
                            <input asp-for="TenKho" class="form-control" />
                            <span asp-validation-for="TenKho" class="text-danger small"></span>
                        </div>

                        <div class="col-md-12">
                            <label asp-for="DiaDiem" class="form-label fw-semibold">
                                <i class="bi bi-geo-alt me-1 text-primary"></i> Địa điểm / Địa chỉ kho
                            </label>
                            <input asp-for="DiaDiem" class="form-control" />
                            <span asp-validation-for="DiaDiem" class="text-danger small"></span>
                        </div>

                        <div class="col-md-12">
                            <label asp-for="MoTa" class="form-label fw-semibold">
                                <i class="bi bi-card-text me-1 text-primary"></i> Mô tả
                            </label>
                            <textarea asp-for="MoTa" rows="3" class="form-control"></textarea>
                            <span asp-validation-for="MoTa" class="text-danger small"></span>
                        </div>

                        <div class="col-md-12">
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" role="switch" asp-for="TrangThai" id="chkEditTrangThaiKho" />
                                <label class="form-check-label fw-semibold" for="chkEditTrangThaiKho">
                                    Đang hoạt động
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary">Hủy bỏ</a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-check-circle-fill"></i> Cập nhật thay đổi
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
