@*
    Họ và tên: Nguyễn Thị Cúc
    Mã sinh viên: 23103100178
    Phụ trách Module 2: Quản lý Kho, Hàng hóa & Tra cứu dữ liệu cửa hàng
*@
@model QuanLyKhoHang_UNETI01_TI17A3HN.Models.Kho

@{
    ViewData["Title"] = "Xác nhận xóa kho hàng";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card border-danger shadow-sm rounded-2 overflow-hidden">
            <div class="card-header bg-danger text-white p-3 d-flex align-items-center gap-2">
                <i class="bi bi-exclamation-triangle-fill fs-4"></i>
                <h5 class="mb-0 fw-bold">Xác Nhận Xóa Kho Hàng</h5>
            </div>
            <div class="card-body p-4">
                <div asp-validation-summary="All" class="alert alert-danger" role="alert" style="display: @(ViewData.ModelState.IsValid ? "none" : "block")"></div>

                <p class="text-danger fw-semibold">
                    Cảnh báo: Bạn có chắc chắn muốn xóa kho hàng này không? Nếu kho đã chứa tồn kho hoặc đã phát sinh chứng từ nhập/xuất, hệ thống sẽ ngăn chặn thao tác xóa để đảm bảo toàn vẹn dữ liệu.
                </p>

                <div class="bg-light p-3 rounded-2 border mb-4">
                    <dl class="row gy-2 mb-0">
                        <dt class="col-sm-4 text-muted">Mã kho:</dt>
                        <dd class="col-sm-8 font-monospace fw-bold">#@Model.MaKho</dd>

                        <dt class="col-sm-4 text-muted">Tên kho:</dt>
                        <dd class="col-sm-8 fw-bold">@Model.TenKho</dd>

                        <dt class="col-sm-4 text-muted">Địa điểm:</dt>
                        <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.DiaDiem) ? "---" : Model.DiaDiem)</dd>
                    </dl>
                </div>

                <form asp-action="Delete" method="post" class="d-flex justify-content-end gap-2">
                    <input type="hidden" asp-for="MaKho" />
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-x-circle"></i> Hủy bỏ
                    </a>
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash-fill"></i> Xác nhận xóa kho
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
