@*
    Họ và tên: Nguyễn Thị Cúc
    Mã sinh viên: 23103100178
    Phụ trách Module 2: Quản lý Kho, Hàng hóa & Tra cứu dữ liệu cửa hàng
*@
@model QuanLyKhoHang_UNETI01_TI17A3HN.Models.Kho

@{
    ViewData["Title"] = "Thêm kho hàng mới";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="page-header">
            <div>
                <h2 class="page-title"><i class="bi bi-building-add text-primary"></i> Khai Báo Kho Hàng Mới</h2>
                <p class="page-subtitle">Nhập thông tin chi nhánh / điểm kho lưu trữ hàng hóa</p>
            </div>
            <div>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Quay lại danh sách
                </a>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-2">
            <div class="card-body p-4 p-md-5">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4 py-2" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-md-12">
                            <label asp-for="TenKho" class="form-label fw-semibold">
                                <i class="bi bi-building me-1 text-primary"></i> Tên kho hàng <span class="text-danger">*</span>
                            </label>
                            <input asp-for="TenKho" class="form-control" placeholder="Ví dụ: Kho Tổng UNETI Lĩnh Nam..." />
                            <span asp-validation-for="TenKho" class="text-danger small"></span>
                        </div>

                        <div class="col-md-12">
                            <label asp-for="DiaDiem" class="form-label fw-semibold">
                                <i class="bi bi-geo-alt me-1 text-primary"></i> Địa điểm / Địa chỉ kho
                            </label>
                            <input asp-for="DiaDiem" class="form-control" placeholder="Số nhà, đường, quận/huyện, tỉnh/thành..." />
                            <span asp-validation-for="DiaDiem" class="text-danger small"></span>
                        </div>

                        <div class="col-md-12">
                            <label asp-for="MoTa" class="form-label fw-semibold">
                                <i class="bi bi-card-text me-1 text-primary"></i> Mô tả
                            </label>
                            <textarea asp-for="MoTa" rows="3" class="form-control" placeholder="Ghi chú về diện tích, người phụ trách kho..."></textarea>
                            <span asp-validation-for="MoTa" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="TrangThai" class="form-label fw-semibold">
                                <i class="bi bi-toggle-on me-1 text-primary"></i> Trạng thái
                            </label>
                            <select asp-for="TrangThai" class="form-select">
                                <option value="true">Đang hoạt động</option>
                                <option value="false">Ngừng hoạt động</option>
                            </select>
                            <span asp-validation-for="TrangThai" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary">Hủy bỏ</a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-check-circle-fill"></i> Tạo kho hàng
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
