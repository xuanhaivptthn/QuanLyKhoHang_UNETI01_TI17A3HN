@model IEnumerable<QuanLyKhoHang_UNETI01_TI17A3HN.Models.Kho>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Tạo mới kho</a>
</p>

<form asp-action="Index" method="get" class="mb-3">
    <div class="input-group">
        <input type="text" name="searchString" value="@ViewBag.SearchString" class="form-control" placeholder="Tìm kiếm theo tên kho..." />
        <button type="submit" class="btn btn-outline-primary">Tìm kiếm</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Tất cả</a>
    </div>
</form>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.TenKho)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DiaDiem)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MoTa)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TrangThai)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.TenKho)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DiaDiem)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.MoTa)
            </td>
            <td>
                @(item.TrangThai ? "Đang hoạt động" : "Ngừng hoạt động")
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.MaKho">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.MaKho">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.MaKho">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
