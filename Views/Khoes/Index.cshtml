@*
    Họ và tên: Nguyễn Thị Cúc
    Mã sinh viên: 23103100178
    Phụ trách Module 2: Quản lý Kho, Hàng hóa & Tra cứu dữ liệu cửa hàng
*@
@model IEnumerable<QuanLyKhoHang_UNETI01_TI17A3HN.Models.Kho>

@{
    ViewData["Title"] = "Quản lý Kho hàng";
}

<div class="page-header">
    <div>
        <h2 class="page-title"><i class="bi bi-building-fill text-primary"></i> Quản Lý Kho Hàng</h2>
        <p class="page-subtitle">Hệ thống kho tổng và các kho chi nhánh, điểm bán hàng</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-circle-fill"></i> Tạo mới kho hàng
        </a>
    </div>
</div>

<!-- Bộ lọc tìm kiếm kho -->
<div class="card border-0 shadow-sm rounded-2 mb-4">
    <div class="card-body p-3">
        <form asp-action="Index" method="get">
            <div class="row g-2 align-items-center">
                <div class="col-md-8 col-lg-6">
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-search"></i></span>
                        <input type="text" name="searchString" value="@ViewBag.SearchString" class="form-control border-start-0 ps-0" placeholder="Tìm kiếm theo tên kho..." />
                    </div>
                </div>
                <div class="col-md-4 col-lg-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-filter"></i> Tìm kiếm
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Tất cả</a>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Danh sách kho hàng -->
<div class="card border-0 shadow-sm rounded-2">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <span class="fw-semibold text-secondary">
            <i class="bi bi-houses me-1"></i> Tổng số kho: <strong>@(Model?.Count() ?? 0)</strong>
        </span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">Mã kho</th>
                        <th>Tên kho hàng</th>
                        <th>Địa điểm / Địa chỉ</th>
                        <th>Mô tả chi tiết</th>
                        <th class="text-center">Trạng thái</th>
                        <th class="text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 font-monospace text-muted">#@item.MaKho</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle bg-info bg-opacity-10 text-info d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                                            <i class="bi bi-building"></i>
                                        </div>
                                        <div>
                                            <strong class="text-dark d-block">@item.TenKho</strong>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.DiaDiem))
                                    {
                                        <span class="text-muted"><i class="bi bi-geo-alt text-danger me-1"></i>@item.DiaDiem</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">---</span>
                                    }
                                </td>
                                <td>
                                    <span class="text-muted small">@(string.IsNullOrEmpty(item.MoTa) ? "---" : item.MoTa)</span>
                                </td>
                                <td class="text-center">
                                    @if (item.TrangThai)
                                    {
                                        <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i> Hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary"><i class="bi bi-pause-circle me-1"></i> Ngừng HĐ</span>
                                    }
                                </td>
                                <td class="text-end pe-4 text-nowrap">
                                    <div class="d-inline-flex gap-1" role="group">
                                        <a asp-action="Details" asp-route-id="@item.MaKho" class="btn btn-outline-info btn-sm text-nowrap" title="Xem danh sách tồn kho">
                                            <i class="bi bi-eye me-1"></i> Xem tồn kho
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.MaKho" class="btn btn-outline-primary btn-sm text-nowrap" title="Chỉnh sửa thông tin kho">
                                            <i class="bi bi-pencil-square me-1"></i> Sửa kho
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.MaKho" class="btn btn-outline-danger btn-sm text-nowrap" title="Xóa kho">
                                            <i class="bi bi-trash me-1"></i> Xóa
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">Chưa có kho nào được tạo.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
