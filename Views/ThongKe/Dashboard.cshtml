@*
    Họ và tên: Nguyễn Văn Cường
    Mã sinh viên: 23103100132
    Nội dung thực hiện: Tồn kho, cảnh báo tồn, lịch sử nhập xuất, Dashboard và thống kê LINQ.
*@
@model QuanLyKhoHang_UNETI01_TI17A3HN.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard & Báo Cáo Thống Kê Kho";
    var baoCao = Model.BaoCao;
    var danhSachKho = ViewBag.DanhSachKho as List<QuanLyKhoHang_UNETI01_TI17A3HN.Models.Kho> ?? new();
    int chenhLechSL = baoCao.TongSoLuongNhap - baoCao.TongSoLuongXuat;
    decimal chenhLechGiaTri = baoCao.TongGiaTriNhap - baoCao.TongGiaTriXuat;
}

<!-- Tiêu đề trang & Thanh điều hướng -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Trang chủ</a></li>
                <li class="breadcrumb-item active" aria-current="page">Dashboard</li>
            </ol>
        </nav>
        <h3 class="fw-bold mb-0 text-dark">
            <i class="bi bi-speedometer2 text-primary me-2"></i>Trung Tâm Điều Hành &amp; Báo Cáo Thống Kê Toàn Diện Bằng LINQ
        </h3>
        <p class="text-muted small mb-0 mt-1">
            Tổng hợp dữ liệu điều hành hàng ngày và phân tích thống kê Nhập - Xuất - Tồn bằng LINQ
        </p>
    </div>
    <div class="d-flex gap-2 no-print">
        <button type="button" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2" onclick="window.print()">
            <i class="bi bi-printer"></i> <span>In báo cáo</span>
        </button>
        <a asp-controller="TonKho" asp-action="CanhBao" class="btn btn-outline-warning d-inline-flex align-items-center gap-2">
            <i class="bi bi-exclamation-triangle"></i> <span>Cảnh báo tồn</span>
        </a>
        <a asp-controller="TonKho" asp-action="LichSu" class="btn btn-outline-info d-inline-flex align-items-center gap-2">
            <i class="bi bi-clock-history"></i> <span>Lịch sử kho</span>
        </a>
    </div>
</div>

<!-- Khối 4 Thẻ KPI Chỉ số chính Hệ thống Hôm Nay -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <a asp-controller="HangHoas" asp-action="Index" class="text-decoration-none">
            <div class="kpi-card kpi-primary h-100">
                <span class="kpi-icon"><i class="bi bi-box-seam"></i></span>
                <div class="kpi-label">Tổng Hàng Hóa</div>
                <div class="kpi-value">@Model.TongSoHangHoa</div>
                <small class="d-block mt-2"><i class="bi bi-arrow-right me-1"></i>Xem danh mục mặt hàng</small>
            </div>
        </a>
    </div>

    <div class="col-sm-6 col-xl-3">
        <a asp-controller="Khoes" asp-action="Index" class="text-decoration-none">
            <div class="kpi-card kpi-success h-100">
                <span class="kpi-icon"><i class="bi bi-building"></i></span>
                <div class="kpi-label">Kho Đang Hoạt Động</div>
                <div class="kpi-value">@Model.TongSoKho</div>
                <small class="d-block mt-2"><i class="bi bi-arrow-right me-1"></i>Hệ thống điểm kho bãi</small>
            </div>
        </a>
    </div>

    <div class="col-sm-6 col-xl-3">
        <a asp-controller="PhieuNhaps" asp-action="Index" class="text-decoration-none">
            <div class="kpi-card kpi-info h-100">
                <span class="kpi-icon"><i class="bi bi-box-arrow-in-down"></i></span>
                <div class="kpi-label">Phiếu Nhập Hôm Nay</div>
                <div class="kpi-value">@Model.SoPhieuNhapTrongNgay</div>
                <small class="d-block mt-2"><i class="bi bi-arrow-right me-1"></i>Quản lý nhập kho</small>
            </div>
        </a>
    </div>

    <div class="col-sm-6 col-xl-3">
        <a asp-controller="PhieuXuats" asp-action="Index" class="text-decoration-none">
            <div class="kpi-card kpi-danger h-100">
                <span class="kpi-icon"><i class="bi bi-box-arrow-up-right"></i></span>
                <div class="kpi-label">Phiếu Xuất Hôm Nay</div>
                <div class="kpi-value">@Model.SoPhieuXuatTrongNgay</div>
                <small class="d-block mt-2"><i class="bi bi-arrow-right me-1"></i>Quản lý xuất kho</small>
            </div>
        </a>
    </div>
</div>

<!-- Khối Cảnh Báo Tồn Kho Khẩn Cấp -->
<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-2 border-start border-danger border-4">
            <div class="card-body p-3 d-flex justify-content-between align-items-center">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <i class="bi bi-x-octagon-fill text-danger fs-5"></i>
                        <h6 class="fw-bold mb-0 text-dark">Cảnh Báo Hết Hàng</h6>
                    </div>
                    <p class="text-muted small mb-0">Hiện có <strong>@Model.SoHangHet</strong> sản phẩm có lượng tồn bằng 0.</p>
                </div>
                <a asp-controller="TonKho" asp-action="CanhBao" class="btn btn-danger btn-sm text-nowrap">
                    Xem chi tiết <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-2 border-start border-warning border-4">
            <div class="card-body p-3 d-flex justify-content-between align-items-center">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <i class="bi bi-exclamation-triangle-fill text-warning fs-5"></i>
                        <h6 class="fw-bold mb-0 text-dark">Cảnh Báo Sắp Hết Hàng</h6>
                    </div>
                    <p class="text-muted small mb-0">Hiện có <strong>@Model.SoHangSapHet</strong> sản phẩm chạm hoặc dưới mức tối thiểu.</p>
                </div>
                <a asp-controller="TonKho" asp-action="CanhBao" class="btn btn-warning btn-sm text-dark text-nowrap">
                    Xem chi tiết <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- BÁO CÁO THỐNG KÊ TOÀN DIỆN BẰNG LINQ -->
<!-- ========================================================================= -->

<!-- Bộ Lọc Thời Gian & Kho Hàng (LINQ Filtering) -->
<div class="card border-0 shadow-sm rounded-2 mb-4 no-print">
    <div class="card-header bg-white py-3">
        <h5 class="fw-bold mb-0 text-primary">
            <i class="bi bi-funnel-fill me-2"></i>Bộ Lọc Báo Cáo Thống Kê LINQ
        </h5>
    </div>
    <div class="card-body p-4">
        <form asp-action="Dashboard" method="get" id="filterForm">
            <div class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label for="baoCaoTuNgay" class="form-label small fw-semibold text-secondary">
                        <i class="bi bi-calendar-event me-1"></i>Từ ngày
                    </label>
                    <input type="date" id="baoCaoTuNgay" name="tuNgay" value="@ViewBag.TuNgay" class="form-control" />
                </div>

                <div class="col-md-3">
                    <label for="baoCaoDenNgay" class="form-label small fw-semibold text-secondary">
                        <i class="bi bi-calendar-check me-1"></i>Đến ngày
                    </label>
                    <input type="date" id="baoCaoDenNgay" name="denNgay" value="@ViewBag.DenNgay" class="form-control" />
                </div>

                <div class="col-md-3">
                    <label for="baoCaoKho" class="form-label small fw-semibold text-secondary">
                        <i class="bi bi-building me-1"></i>Kho hàng
                    </label>
                    <select id="baoCaoKho" name="maKho" class="form-select">
                        <option value="">-- Tất cả các kho --</option>
                        @foreach (var k in danhSachKho)
                        {
                            <option value="@k.MaKho" selected="@(baoCao.MaKho == k.MaKho)">@k.TenKho</option>
                        }
                    </select>
                </div>

                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100 d-inline-flex align-items-center justify-content-center gap-2">
                        <i class="bi bi-funnel-fill"></i> <span>Tổng hợp số liệu LINQ</span>
                    </button>
                </div>
            </div>

            <!-- Các nút chọn nhanh khoảng thời gian -->
            <div class="d-flex flex-wrap align-items-center gap-2 mt-3 pt-3 border-top">
                <span class="small text-muted fw-semibold me-1"><i class="bi bi-lightning-charge me-1"></i>Lọc nhanh:</span>
                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="setQuickDate('thisMonth')">Tháng này</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="setQuickDate('last3Months')">3 tháng gần đây</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="setQuickDate('thisYear')">Năm nay</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="setQuickDate('allTime')">Toàn bộ dữ liệu</button>
                @if (baoCao.MaKho.HasValue)
                {
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle ms-auto">
                        <i class="bi bi-funnel me-1"></i>Đang lọc theo kho: @baoCao.TenKhoChon
                    </span>
                }
            </div>
        </form>
    </div>
</div>

<!-- Khối 4 Thẻ KPI Tóm Tắt Tình Hình Nhập - Xuất - Tồn Trong Kỳ -->
<div class="row g-3 mb-4">
    <!-- KPI Nhập -->
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-2 h-100 border-start border-4 border-success">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <span class="text-success small fw-bold text-uppercase">Tổng Nhập Trong Kỳ</span>
                        <h4 class="fw-bold text-success mb-1 mt-1 font-monospace">+@baoCao.TongSoLuongNhap.ToString("#,##0")</h4>
                        <div class="text-muted small">@baoCao.TongGiaTriNhap.ToString("#,##0") VNĐ</div>
                    </div>
                    <span class="badge bg-success-subtle text-success p-2 rounded-circle">
                        <i class="bi bi-box-arrow-in-down fs-5"></i>
                    </span>
                </div>
                <small class="text-muted d-block mt-2">
                    <i class="bi bi-receipt me-1"></i>@baoCao.TongSoPhieuNhap phiếu nhập phát sinh
                </small>
            </div>
        </div>
    </div>

    <!-- KPI Xuất -->
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-2 h-100 border-start border-4 border-danger">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <span class="text-danger small fw-bold text-uppercase">Tổng Xuất Trong Kỳ</span>
                        <h4 class="fw-bold text-danger mb-1 mt-1 font-monospace">-@baoCao.TongSoLuongXuat.ToString("#,##0")</h4>
                        <div class="text-muted small">@baoCao.TongGiaTriXuat.ToString("#,##0") VNĐ</div>
                    </div>
                    <span class="badge bg-danger-subtle text-danger p-2 rounded-circle">
                        <i class="bi bi-box-arrow-up-right fs-5"></i>
                    </span>
                </div>
                <small class="text-muted d-block mt-2">
                    <i class="bi bi-receipt-cutoff me-1"></i>@baoCao.TongSoPhieuXuat phiếu xuất phát sinh
                </small>
            </div>
        </div>
    </div>

    <!-- KPI Cân đối biến động -->
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-2 h-100 border-start border-4 border-info">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <span class="text-info small fw-bold text-uppercase">Cân Đối Biến Động</span>
                        <h4 class="fw-bold @(chenhLechSL >= 0 ? "text-primary" : "text-warning") mb-1 mt-1 font-monospace">
                            @(chenhLechSL >= 0 ? "+" : "")@chenhLechSL.ToString("#,##0")
                        </h4>
                        <div class="text-muted small">@(chenhLechGiaTri >= 0 ? "+" : "")@chenhLechGiaTri.ToString("#,##0") VNĐ</div>
                    </div>
                    <span class="badge bg-info-subtle text-info p-2 rounded-circle">
                        <i class="bi bi-arrow-left-right fs-5"></i>
                    </span>
                </div>
                <small class="text-muted d-block mt-2">
                    <i class="bi bi-graph-up-arrow me-1"></i>Nhập trừ Xuất trong kỳ
                </small>
            </div>
        </div>
    </div>

    <!-- KPI Tồn hiện tại -->
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-2 h-100 border-start border-4 border-primary">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <span class="text-primary small fw-bold text-uppercase">Tổng Tồn Hiện Tại</span>
                        <h4 class="fw-bold text-primary mb-1 mt-1 font-monospace">@baoCao.TongSoLuongTon.ToString("#,##0")</h4>
                        <div class="text-muted small">@baoCao.TongGiaTriTon.ToString("#,##0") VNĐ</div>
                    </div>
                    <span class="badge bg-primary-subtle text-primary p-2 rounded-circle">
                        <i class="bi bi-boxes fs-5"></i>
                    </span>
                </div>
                <small class="text-muted d-block mt-2">
                    <i class="bi bi-database me-1"></i>@baoCao.DanhSachTonHienTai.Count mặt hàng lưu kho
                </small>
            </div>
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- 5 TAB THỐNG KÊ CHI TIẾT BẰNG LINQ -->
<!-- ========================================================================= -->
<ul class="nav nav-pills mb-3 gap-2 no-print" id="pills-tab" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="pills-top-tab" data-bs-toggle="pill" data-bs-target="#pills-top" type="button" role="tab" aria-selected="true">
            <i class="bi bi-trophy me-1"></i> Xếp Hạng Top &amp; Đối Tác
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="pills-nhap-tab" data-bs-toggle="pill" data-bs-target="#pills-nhap" type="button" role="tab" aria-selected="false">
            <i class="bi bi-box-arrow-in-down me-1"></i> Tổng Nhập (Hàng / Kho / Tháng)
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="pills-xuat-tab" data-bs-toggle="pill" data-bs-target="#pills-xuat" type="button" role="tab" aria-selected="false">
            <i class="bi bi-box-arrow-up-right me-1"></i> Tổng Xuất (Hàng / Kho / Tháng)
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="pills-ton-tab" data-bs-toggle="pill" data-bs-target="#pills-ton" type="button" role="tab" aria-selected="false">
            <i class="bi bi-boxes me-1"></i> Tồn Kho Hiện Tại
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="pills-status-tab" data-bs-toggle="pill" data-bs-target="#pills-status" type="button" role="tab" aria-selected="false">
            <i class="bi bi-pie-chart me-1"></i> Số Phiếu Theo Trạng Thái
        </button>
    </li>
</ul>

<div class="tab-content" id="pills-tabContent">

    <!-- TAB 1: XẾP HẠNG TOP & ĐỐI TÁC -->
    <div class="tab-pane fade show active" id="pills-top" role="tabpanel">
        <div class="row g-4 mb-4">
            <!-- Top Hàng Nhập Nhiều Nhất -->
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm rounded-2 h-100">
                    <div class="card-header bg-white py-3 d-flex align-items-center justify-content-between">
                        <h6 class="fw-bold mb-0 text-success">
                            <i class="bi bi-trophy-fill me-2"></i> Hàng Nhập Nhiều Nhất (Top 10)
                        </h6>
                        <span class="badge bg-success-subtle text-success border border-success-subtle">LINQ OrderByDescending</span>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-3" style="width: 50px;">Top</th>
                                        <th>Tên hàng hóa</th>
                                        <th>Loại / ĐVT</th>
                                        <th class="text-end pe-3">Số lượng nhập</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (baoCao.TopHangNhap.Any())
                                    {
                                        int stt = 1;
                                        foreach (var item in baoCao.TopHangNhap)
                                        {
                                            <tr>
                                                <td class="ps-3 font-monospace">
                                                    @if (stt == 1) { <span class="badge bg-warning text-dark"><i class="bi bi-trophy-fill me-1"></i>#1</span> }
                                                    else if (stt == 2) { <span class="badge bg-secondary text-white">#2</span> }
                                                    else if (stt == 3) { <span class="badge bg-dark-subtle text-dark">#3</span> }
                                                    else { <span class="text-muted">#@stt</span> }
                                                </td>
                                                <td>
                                                    <span class="fw-semibold text-dark">@item.TenHang</span>
                                                    <div class="small text-muted">@item.TongGiaTri.ToString("#,##0") VNĐ</div>
                                                </td>
                                                <td>
                                                    <span class="badge bg-light text-secondary border">@item.LoaiHang</span>
                                                    <small class="text-muted d-block">ĐVT: @item.DonViTinh</small>
                                                </td>
                                                <td class="text-end pe-3 font-monospace fw-bold text-success fs-6">
                                                    +@item.TongSoLuong.ToString("#,##0")
                                                </td>
                                            </tr>
                                            stt++;
                                        }
                                    }
                                    else
                                    {
                                        <tr><td colspan="4" class="text-center text-muted py-4">Chưa có giao dịch nhập nào hoàn tất trong kỳ.</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Top Hàng Xuất Nhiều Nhất -->
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm rounded-2 h-100">
                    <div class="card-header bg-white py-3 d-flex align-items-center justify-content-between">
                        <h6 class="fw-bold mb-0 text-danger">
                            <i class="bi bi-fire me-2"></i> Hàng Xuất Nhiều Nhất (Top 10)
                        </h6>
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">LINQ OrderByDescending</span>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-3" style="width: 50px;">Top</th>
                                        <th>Tên hàng hóa</th>
                                        <th>Loại / ĐVT</th>
                                        <th class="text-end pe-3">Số lượng xuất</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (baoCao.TopHangXuat.Any())
                                    {
                                        int stt = 1;
                                        foreach (var item in baoCao.TopHangXuat)
                                        {
                                            <tr>
                                                <td class="ps-3 font-monospace">
                                                    @if (stt == 1) { <span class="badge bg-danger text-white"><i class="bi bi-fire me-1"></i>#1</span> }
                                                    else if (stt == 2) { <span class="badge bg-warning text-dark">#2</span> }
                                                    else if (stt == 3) { <span class="badge bg-secondary text-white">#3</span> }
                                                    else { <span class="text-muted">#@stt</span> }
                                                </td>
                                                <td>
                                                    <span class="fw-semibold text-dark">@item.TenHang</span>
                                                    <div class="small text-muted">@item.TongGiaTri.ToString("#,##0") VNĐ</div>
                                                </td>
                                                <td>
                                                    <span class="badge bg-light text-secondary border">@item.LoaiHang</span>
                                                    <small class="text-muted d-block">ĐVT: @item.DonViTinh</small>
                                                </td>
                                                <td class="text-end pe-3 font-monospace fw-bold text-danger fs-6">
                                                    -@item.TongSoLuong.ToString("#,##0")
                                                </td>
                                            </tr>
                                            stt++;
                                        }
                                    }
                                    else
                                    {
                                        <tr><td colspan="4" class="text-center text-muted py-4">Chưa có giao dịch xuất nào hoàn tất trong kỳ.</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Hàng 2: Nhà Cung Cấp Lớn & Bộ Phận Nhận Nhiều -->
        <div class="row g-4">
            <!-- Nhà cung cấp có giá trị nhập lớn -->
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm rounded-2 h-100">
                    <div class="card-header bg-white py-3 d-flex align-items-center justify-content-between">
                        <h6 class="fw-bold mb-0 text-primary">
                            <i class="bi bi-truck me-2"></i> Nhà Cung Cấp Có Giá Trị Nhập Lớn
                        </h6>
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Theo tổng giá trị</span>
                    </div>
