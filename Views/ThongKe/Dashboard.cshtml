                        <h6 class="fw-bold mb-0 text-success">
                            <i class="bi bi-box-arrow-in-down me-2"></i> Phiếu Nhập Theo Trạng Thái
                        </h6>
                        <span class="badge bg-light text-dark border">Tổng cộng: @baoCao.TongSoPhieuNhap phiếu</span>
                    </div>
                    <div class="card-body p-4">
                        <div class="table-responsive mb-4">
                            <table class="table align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Trạng thái chứng từ</th>
                                        <th class="text-center">Số lượng</th>
                                        <th class="text-end">Tỷ lệ</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var st in baoCao.SoPhieuNhapTheoTrangThai)
                                    {
                                        <tr>
                                            <td><span class="badge @st.BadgeClass px-2 py-1">@st.TenTrangThai</span></td>
                                            <td class="text-center font-monospace fw-bold">@st.SoLuong</td>
