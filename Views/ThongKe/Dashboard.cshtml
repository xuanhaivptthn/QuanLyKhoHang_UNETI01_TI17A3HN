@*
    Họ và tên: Nguyễn Văn Cường
    Mã sinh viên: 23103100132
    Phụ trách Module 5: Cảnh báo hàng tồn & Lịch sử biến động kho
*@
@model QuanLyKhoHang_UNETI01_TI17A3HN.ViewModels.DashboardViewModel
@using System.Text.Json

@{
    ViewData["Title"] = "Dashboard Thống kê Kho Hàng";
    decimal tongGiaTri = ViewBag.TongGiaTriTonKho != null ? (decimal)ViewBag.TongGiaTriTonKho : 0;
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Trang chủ</a></li>
                <li class="breadcrumb-item active" aria-current="page">Dashboard</li>
            </ol>
        </nav>
        <h3 class="fw-bold mb-0 text-dark">Trung Tâm Điều Hành &amp; Thống Kê Kho</h3>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="BaoCaoNhapXuat" class="btn btn-outline-primary d-inline-flex align-items-center gap-2">
            <i class="bi bi-file-earmark-bar-graph"></i>
            <span>Báo cáo tổng hợp Nhập - Xuất</span>
        </a>
    </div>
</div>

<!-- Khối 4 Thẻ KPI Chỉ số chính -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <a asp-controller="HangHoas" asp-action="Index" class="text-decoration-none">
            <div class="kpi-card kpi-primary h-100">
                <span class="kpi-icon"><i class="bi bi-box-seam"></i></span>
                <div class="kpi-label">Tổng Hàng Hóa</div>
                <div class="kpi-value">@Model.TongSoHangHoa</div>
                <small class="d-block mt-2"><i class="bi bi-arrow-right me-1"></i>Xem danh mục mặt hàng</small>
            </div>
        </a>
    </div>

    <div class="col-sm-6 col-xl-3">
        <a asp-controller="Khoes" asp-action="Index" class="text-decoration-none">
            <div class="kpi-card kpi-success h-100">
                <span class="kpi-icon"><i class="bi bi-building"></i></span>
                <div class="kpi-label">Kho Đang Hoạt Động</div>
                <div class="kpi-value">@Model.TongSoKho</div>
                <small class="d-block mt-2"><i class="bi bi-arrow-right me-1"></i>Hệ thống điểm kho bãi</small>
            </div>
        </a>
    </div>

    <div class="col-sm-6 col-xl-3">
        <a asp-controller="PhieuNhaps" asp-action="Index" class="text-decoration-none">
            <div class="kpi-card kpi-info h-100">
                <span class="kpi-icon"><i class="bi bi-box-arrow-in-down"></i></span>
                <div class="kpi-label">Phiếu Nhập Hôm Nay</div>
                <div class="kpi-value">@Model.SoPhieuNhapTrongNgay</div>
                <small class="d-block mt-2"><i class="bi bi-arrow-right me-1"></i>Quản lý nhập kho</small>
            </div>
        </a>
    </div>

    <div class="col-sm-6 col-xl-3">
        <a asp-controller="PhieuXuats" asp-action="Index" class="text-decoration-none">
            <div class="kpi-card kpi-danger h-100">
                <span class="kpi-icon"><i class="bi bi-box-arrow-up-right"></i></span>
                <div class="kpi-label">Phiếu Xuất Hôm Nay</div>
                <div class="kpi-value">@Model.SoPhieuXuatTrongNgay</div>
                <small class="d-block mt-2"><i class="bi bi-arrow-right me-1"></i>Quản lý xuất kho</small>
            </div>
        </a>
    </div>
</div>

<!-- Khối Cảnh Báo Tồn Kho Khẩn Cấp -->
<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-2 border-start border-danger border-4">
            <div class="card-body p-4 d-flex justify-content-between align-items-center">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <i class="bi bi-x-octagon-fill text-danger fs-4"></i>
                        <h5 class="fw-bold mb-0 text-dark">Cảnh Báo Hết Hàng</h5>
                    </div>
                    <p class="text-muted small mb-0">Hiện có <strong>@Model.SoHangHet</strong> sản phẩm có lượng tồn bằng 0.</p>
                </div>
                <a asp-controller="TonKho" asp-action="CanhBao" class="btn btn-danger btn-sm text-nowrap">
                    Xem chi tiết <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-2 border-start border-warning border-4">
            <div class="card-body p-4 d-flex justify-content-between align-items-center">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <i class="bi bi-exclamation-triangle-fill text-warning fs-4"></i>
                        <h5 class="fw-bold mb-0 text-dark">Cảnh Báo Sắp Hết Hàng</h5>
                    </div>
                    <p class="text-muted small mb-0">Hiện có <strong>@Model.SoHangSapHet</strong> sản phẩm chạm hoặc dưới mức tối thiểu.</p>
                </div>
                <a asp-controller="TonKho" asp-action="CanhBao" class="btn btn-warning btn-sm text-dark text-nowrap">
                    Xem chi tiết <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Hàng Biểu Đồ Trực Quan -->
<div class="row g-4 mb-4">
    <!-- Biểu đồ cột: So sánh Nhập - Xuất 7 ngày gần nhất -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-2 h-100">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-bar-chart-line-fill text-primary me-2"></i> Xu Hướng Nhập &amp; Xuất (7 Ngày Gần Nhất)
                </h5>
                <span class="badge bg-light text-secondary border">Chứng từ</span>
            </div>
            <div class="card-body p-4">
                <div style="position: relative; height: 320px; width: 100%;">
                    <canvas id="barChartNhapXuat"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Biểu đồ tròn: Cơ cấu theo loại hàng -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-2 h-100">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-pie-chart-fill text-success me-2"></i> Cơ Cấu Theo Loại Hàng
                </h5>
                <span class="badge bg-light text-secondary border">Danh mục</span>
            </div>
            <div class="card-body p-4">
                <div style="position: relative; height: 320px; width: 100%;">
                    <canvas id="pieChartLoaiHang"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Thống kê Giá Trị Kho Hàng -->
<div class="card border-0 shadow-sm rounded-2 mb-4 bg-light">
    <div class="card-body p-4 d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div class="d-flex align-items-center gap-3">
            <i class="bi bi-cash-stack fs-1 text-primary"></i>
            <div>
                <h5 class="fw-bold mb-1 text-dark">Tổng Trị Giá Hàng Hóa Tồn Kho Ước Tính</h5>
                <small class="text-muted">Tính theo công thức: &Sigma; (Số lượng tồn &times; Giá nhập tham khảo)</small>
            </div>
        </div>
        <div class="text-end">
            <div class="fs-3 fw-bold text-primary font-monospace">@tongGiaTri.ToString("#,##0") VNĐ</div>
            <span class="badge bg-success-subtle text-success border border-success-subtle">
                <i class="bi bi-shield-check me-1"></i> Đối soát tài chính kho
            </span>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/chartjs/chart.umd.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Dữ liệu từ controller
            const daysLabels = @Html.Raw(JsonSerializer.Serialize(ViewBag.ChartDaysLabels ?? new List<string>()));
            const nhapData = @Html.Raw(JsonSerializer.Serialize(ViewBag.ChartNhapData ?? new List<int>()));
            const xuatData = @Html.Raw(JsonSerializer.Serialize(ViewBag.ChartXuatData ?? new List<int>()));

            const loaiLabels = @Html.Raw(JsonSerializer.Serialize(ViewBag.LoaiHangLabels ?? new List<string>()));
            const loaiData = @Html.Raw(JsonSerializer.Serialize(ViewBag.LoaiHangData ?? new List<int>()));

            function getThemeConfig() {
                const isDark = (document.documentElement.getAttribute("data-theme") || "") === "dark";
                return {
                    textColor: isDark ? "#c1bce2" : "#46406e",
                    gridColor: isDark ? "rgba(255, 255, 255, 0.08)" : "rgba(80, 70, 140, 0.08)",
                    doughnutBorder: isDark ? "#1e2130" : "#ffffff"
                };
            }

            let barChartInstance = null;
            let pieChartInstance = null;

            function initCharts() {
                const cfg = getThemeConfig();

                // 1. Biểu đồ Bar Nhập - Xuất
                const ctxBar = document.getElementById("barChartNhapXuat");
                if (ctxBar) {
                    if (barChartInstance) barChartInstance.destroy();
                    barChartInstance = new Chart(ctxBar, {
                        type: 'bar',
                        data: {
                            labels: daysLabels.length ? daysLabels : ['Hôm nay'],
                            datasets: [
                                {
                                    label: 'Phiếu Nhập',
                                    data: nhapData.length ? nhapData : [0],
                                    backgroundColor: 'rgba(91, 142, 230, 0.85)',
                                    borderColor: '#4a76c9',
                                    borderWidth: 1,
                                    borderRadius: 6
                                },
                                {
                                    label: 'Phiếu Xuất',
                                    data: xuatData.length ? xuatData : [0],
                                    backgroundColor: 'rgba(224, 108, 130, 0.85)',
                                    borderColor: '#c14f67',
                                    borderWidth: 1,
                                    borderRadius: 6
                                }
                            ]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: {
                                    position: 'top',
                                    labels: {
                                        color: cfg.textColor,
                                        font: { family: "Inter, system-ui, sans-serif", weight: '500' }
                                    }
                                }
                            },
                            scales: {
                                x: {
                                    ticks: { color: cfg.textColor },
                                    grid: { color: cfg.gridColor }
                                },
                                y: {
                                    beginAtZero: true,
                                    ticks: {
                                        color: cfg.textColor,
                                        stepSize: 1
                                    },
                                    grid: { color: cfg.gridColor }
                                }
                            }
                        }
                    });
                }

                // 2. Biểu đồ Doughnut / Pie Loại Hàng
                const ctxPie = document.getElementById("pieChartLoaiHang");
                if (ctxPie) {
                    if (pieChartInstance) pieChartInstance.destroy();
                    const backgroundColors = [
                        '#5b8ee6', '#4cb584', '#e3a24a', '#9272d1', '#e06c82', '#4bb3bd', '#8884ab'
                    ];
                    pieChartInstance = new Chart(ctxPie, {
                        type: 'doughnut',
                        data: {
                            labels: loaiLabels.length ? loaiLabels : ['Chưa có loại'],
                            datasets: [{
                                data: loaiData.length ? loaiData : [1],
                                backgroundColor: backgroundColors.slice(0, loaiLabels.length || 1),
                                borderWidth: 2,
                                borderColor: cfg.doughnutBorder
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: {
                                    position: 'bottom',
                                    labels: {
                                        color: cfg.textColor,
                                        font: { family: "Inter, system-ui, sans-serif", weight: '500' }
                                    }
                                }
                            }
                        }
                    });
                }
            }

            initCharts();

            // Re-render charts when theme changes
            window.addEventListener("themechange", function () {
                initCharts();
            });
        });
    </script>
}