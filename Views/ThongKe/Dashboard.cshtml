        font-size: 2.2rem;
        font-weight: 700;
        letter-spacing: -0.5px;
    }
    .chart-container-card {
        border-radius: 12px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    }
    .card-header-custom {
        background-color: #f8fafc;
