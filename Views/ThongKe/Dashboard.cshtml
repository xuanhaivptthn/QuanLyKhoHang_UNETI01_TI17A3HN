                            {
                                string bgClass = st.TrangThaiId switch {
                                    0 => "bg-secondary",
                                    1 => "bg-warning",
                                    2 => "bg-success",
                                    3 => "bg-danger",
                                    _ => "bg-primary"
                                };
                                <div class="progress" role="progressbar" style="width: @st.TiLePhanTram%" aria-valuenow="@st.TiLePhanTram" aria-valuemin="0" aria-valuemax="100" title="@st.TenTrangThai: @st.SoLuong (@st.TiLePhanTram%)">
                                    <div class="progress-bar @bgClass">@st.TiLePhanTram%</div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function setQuickDate(type) {
            const today = new Date();
            const tuInput = document.getElementById('baoCaoTuNgay');
            const denInput = document.getElementById('baoCaoDenNgay');
            
            function formatDate(d) {
                const year = d.getFullYear();
                const month = String(d.getMonth() + 1).padStart(2, '0');
                const day = String(d.getDate()).padStart(2, '0');
                return `${year}-${month}-${day}`;
            }

            denInput.value = formatDate(today);

            if (type === 'thisMonth') {
                const startMonth = new Date(today.getFullYear(), today.getMonth(), 1);
                tuInput.value = formatDate(startMonth);
            } else if (type === 'last3Months') {
                const threeMonthsAgo = new Date(today.getFullYear(), today.getMonth() - 3, 1);
                tuInput.value = formatDate(threeMonthsAgo);
            } else if (type === 'thisYear') {
                const startYear = new Date(today.getFullYear(), 0, 1);
                tuInput.value = formatDate(startYear);
            } else if (type === 'allTime') {
                tuInput.value = '2020-01-01';
            }

            document.getElementById('filterForm').submit();
        }
    </script>
}
