@*
    Họ và tên: Nguyễn Thị Cúc
    Mã sinh viên: 23103100178
    Phụ trách Module 2: Quản lý Kho, Hàng hóa & Tra cứu dữ liệu cửa hàng
*@
@model QuanLyKhoHang_UNETI01_TI17A3HN.Models.HangHoa

@{
    ViewData["Title"] = "Thêm hàng hóa mới";
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="page-header">
            <div>
                <h2 class="page-title"><i class="bi bi-plus-circle-fill text-primary"></i> Thêm Hàng Hóa Mới</h2>
                <p class="page-subtitle">Nhập thông tin sản phẩm và thiết lập định mức lưu kho</p>
            </div>
            <div>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Quay lại danh sách
                </a>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4 p-md-5">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4 py-2" role="alert"></div>

                    <div class="row g-3">
                        <!-- Tên hàng hóa -->
                        <div class="col-md-12">
                            <label asp-for="TenHang" class="form-label fw-semibold">
                                <i class="bi bi-box-seam me-1 text-primary"></i> Tên hàng hóa <span class="text-danger">*</span>
                            </label>
                            <input asp-for="TenHang" class="form-control" placeholder="Ví dụ: Nồi cơm điện tử Sharp 1.8L..." />
                            <span asp-validation-for="TenHang" class="text-danger small"></span>
                        </div>

                        <!-- Loại hàng & Đơn vị tính -->
                        <div class="col-md-6">
                            <label asp-for="MaLoaiHang" class="form-label fw-semibold">
                                <i class="bi bi-tags me-1 text-primary"></i> Loại hàng hóa <span class="text-danger">*</span>
                            </label>
                            <select asp-for="MaLoaiHang" class="form-select" asp-items="ViewBag.MaLoaiHang">
                                <option value="">-- Chọn loại hàng --</option>
                            </select>
                            <span asp-validation-for="MaLoaiHang" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="MaDonViTinh" class="form-label fw-semibold">
                                <i class="bi bi-rulers me-1 text-primary"></i> Đơn vị tính <span class="text-danger">*</span>
                            </label>
                            <select asp-for="MaDonViTinh" class="form-select" asp-items="ViewBag.MaDonViTinh">
                                <option value="">-- Chọn đơn vị tính --</option>
                            </select>
                            <span asp-validation-for="MaDonViTinh" class="text-danger small"></span>
                        </div>

                        <!-- Giá nhập tham khảo & Mức tồn tối thiểu -->
                        <div class="col-md-6">
                            <label asp-for="GiaNhapThamKhao" class="form-label fw-semibold">
                                <i class="bi bi-currency-dollar me-1 text-primary"></i> Giá nhập tham khảo (VNĐ) <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <input asp-for="GiaNhapThamKhao" type="number" min="0" step="any" class="form-control" placeholder="0" />
                                <span class="input-group-text bg-light text-muted">VNĐ</span>
                            </div>
                            <span asp-validation-for="GiaNhapThamKhao" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="MucTonToiThieu" class="form-label fw-semibold">
                                <i class="bi bi-exclamation-triangle me-1 text-warning"></i> Mức tồn tối thiểu (Cảnh báo) <span class="text-danger">*</span>
                            </label>
                            <input asp-for="MucTonToiThieu" type="number" min="0" class="form-control" placeholder="10" />
                            <span asp-validation-for="MucTonToiThieu" class="text-danger small"></span>
                        </div>

                        <!-- Mô tả -->
                        <div class="col-md-12">
                            <label asp-for="MoTa" class="form-label fw-semibold">
                                <i class="bi bi-card-text me-1 text-primary"></i> Mô tả chi tiết
                            </label>
                            <textarea asp-for="MoTa" rows="3" class="form-control" placeholder="Thông số kỹ thuật, quy cách đóng gói..."></textarea>
                            <span asp-validation-for="MoTa" class="text-danger small"></span>
                        </div>

                        <!-- Trạng thái -->
                        <div class="col-md-12">
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" role="switch" asp-for="TrangThai" checked id="chkTrangThaiHang" />
                                <label class="form-check-label fw-semibold" for="chkTrangThaiHang">
                                    Đang kinh doanh (Cho phép phát sinh phiếu nhập/xuất)
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary">Hủy bỏ</a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-check-circle-fill"></i> Lưu hàng hóa
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
