@model IEnumerable<QuanLyKhoHang_UNETI01_TI17A3HN.Models.HangHoa>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Thêm mới hàng hóa</a>
</p>

<form asp-action="Index" method="get" class="card p-3 mb-3 bg-light">
    <div class="row g-2">
        <div class="col-md-3">
            <input type="text" name="searchString" value="@ViewBag.SearchString" class="form-control" placeholder="Mã hoặc tên hàng..." />
        </div>
        <div class="col-md-2">
            <select name="maLoaiHang" class="form-select" asp-items="ViewBag.LoaiHangs">
                <option value="">-- Loại hàng --</option>
            </select>
        </div>
        <div class="col-md-2">
            <select name="maDonViTinh" class="form-select" asp-items="ViewBag.DonViTinhs">
                <option value="">-- Đơn vị tính --</option>
            </select>
        </div>
        <div class="col-md-2">
            <select name="trangThai" class="form-select">
                <option value="">-- Trạng thái --</option>
                <option value="true" selected="@(ViewBag.TrangThai == true)">Hoạt động</option>
                <option value="false" selected="@(ViewBag.TrangThai == false)">Ngừng HĐ</option>
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Lọc</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Tất cả</a>
        </div>
    </div>
</form>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.TenHang)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.LoaiHang)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DonViTinh)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.GiaNhapThamKhao)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MucTonToiThieu)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MoTa)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TrangThai)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.TenHang)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.LoaiHang.TenLoaiHang)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DonViTinh.TenDonViTinh)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.GiaNhapThamKhao)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.MucTonToiThieu)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.MoTa)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TrangThai)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.MaHang">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.MaHang">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.MaHang">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>

@{
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 0;

    // Giữ nguyên điều kiện tìm kiếm, lọc, sắp xếp khi chuyển trang
    Func<int, Dictionary<string, string?>> routeFor = p => new Dictionary<string, string?>
    {
        ["searchString"] = ViewBag.SearchString,
        ["maLoaiHang"] = ViewBag.MaLoaiHang?.ToString(),
        ["maDonViTinh"] = ViewBag.MaDonViTinh?.ToString(),
        ["trangThai"] = ViewBag.TrangThai?.ToString().ToLower(),
        ["giaTu"] = ViewBag.GiaTu?.ToString(),
        ["giaDen"] = ViewBag.GiaDen?.ToString(),
        ["sortOrder"] = ViewBag.SortOrder,
        ["page"] = p.ToString()
    };
}

@if (totalPages > 1)
{
    <nav>
        <ul class="pagination">
            <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-all-route-data="routeFor(currentPage - 1)">Trước</a>
            </li>
            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == currentPage ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-all-route-data="routeFor(i)">@i</a>
                </li>
            }
            <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-all-route-data="routeFor(currentPage + 1)">Sau</a>
            </li>
        </ul>
    </nav>
    <p class="text-muted">Trang @currentPage / @totalPages (tổng @ViewBag.TotalItems hàng hóa)</p>
}
