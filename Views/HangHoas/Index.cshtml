@*
    Họ và tên: Nguyễn Thị Cúc
    Mã sinh viên: 23103100178
    Phụ trách Module 2: Quản lý Kho, Hàng hóa & Tra cứu dữ liệu cửa hàng
*@
@model IEnumerable<QuanLyKhoHang_UNETI01_TI17A3HN.Models.HangHoa>

@{
    ViewData["Title"] = "Quản lý hàng hóa";
    var tongTonDict = (Dictionary<int, int>?)ViewBag.TongTon ?? new Dictionary<int, int>();
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Trang chủ</a></li>
                <li class="breadcrumb-item active" aria-current="page">Hàng hóa</li>
            </ol>
        </nav>
        <h3 class="fw-bold mb-0 text-dark">Quản Lý Danh Mục Hàng Hóa</h3>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Create" class="btn btn-primary d-inline-flex align-items-center gap-2">
            <i class="bi bi-plus-lg"></i>
            <span>Thêm hàng hóa mới</span>
        </a>
    </div>
</div>

<!-- Bộ lọc tìm kiếm & Phân loại nâng cao -->
<div class="card border-0 shadow-sm rounded-2 mb-4">
    <div class="card-body p-3">
        <form asp-action="Index" method="get" class="row g-2 align-items-end">
            <!-- Tìm kiếm theo tên / mô tả -->
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-secondary mb-1">Tìm kiếm</label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="searchString" value="@ViewBag.SearchString" class="form-control border-start-0" placeholder="Tên hàng hóa, quy cách..." />
                </div>
            </div>

            <!-- Loại hàng -->
            <div class="col-md-2">
                <label class="form-label small fw-semibold text-secondary mb-1">Loại hàng</label>
                <select name="maLoaiHang" class="form-select" asp-items="ViewBag.LoaiHangs">
                    <option value="">-- Tất cả loại hàng --</option>
                </select>
            </div>

            <!-- Đơn vị tính -->
            <div class="col-md-2">
                <label class="form-label small fw-semibold text-secondary mb-1">Đơn vị tính</label>
                <select name="maDonViTinh" class="form-select" asp-items="ViewBag.DonViTinhs">
                    <option value="">-- Tất cả ĐVT --</option>
                </select>
            </div>

            <!-- Kho hàng -->
            <div class="col-md-2">
                <label class="form-label small fw-semibold text-secondary mb-1">Kho lưu trữ</label>
                <select name="maKho" class="form-select" asp-items="ViewBag.Khos">
                    <option value="">-- Tất cả kho --</option>
                </select>
            </div>

            <!-- Trạng thái -->
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-secondary mb-1">Trạng thái hàng</label>
                <select name="trangThai" class="form-select">
                    <option value="">-- Tất cả trạng thái --</option>
                    <option value="true" selected="@(ViewBag.TrangThai == true)">Đang hoạt động</option>
                    <option value="false" selected="@(ViewBag.TrangThai == false)">Ngừng hoạt động</option>
                </select>
            </div>

            <!-- Khoảng giá từ -->
            <div class="col-md-2">
                <label class="form-label small fw-semibold text-secondary mb-1">Giá từ (VNĐ)</label>
                <input type="number" name="giaTu" min="0" step="any" value="@ViewBag.GiaTu" class="form-control" placeholder="Tối thiểu" />
            </div>

            <!-- Khoảng giá đến -->
            <div class="col-md-2">
                <label class="form-label small fw-semibold text-secondary mb-1">Giá đến (VNĐ)</label>
                <input type="number" name="giaDen" min="0" step="any" value="@ViewBag.GiaDen" class="form-control" placeholder="Tối đa" />
            </div>

            <!-- Cảnh báo tồn -->
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-secondary mb-1">Tình trạng tồn</label>
                <select name="canhBao" class="form-select">
                    <option value="">-- Tất cả tình trạng --</option>
                    <option value="canh_bao" selected="@(ViewBag.CanhBao == "canh_bao")">Cảnh báo (Tồn &le; Mức tối thiểu)</option>
                    <option value="binh_thuong" selected="@(ViewBag.CanhBao == "binh_thuong")">Đủ an toàn</option>
                </select>
            </div>

            <!-- Sắp xếp -->
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-secondary mb-1">Sắp xếp</label>
                <select name="sortOrder" class="form-select">
                    <option value="">-- Mặc định --</option>
                    <option value="ten_tang_dan" selected="@(ViewBag.SortOrder == "ten_tang_dan")">Tên A &rarr; Z</option>
                    <option value="ten_giam_dan" selected="@(ViewBag.SortOrder == "ten_giam_dan")">Tên Z &rarr; A</option>
                    <option value="gia_tang_dan" selected="@(ViewBag.SortOrder == "gia_tang_dan")">Giá thấp &rarr; Cao</option>
                    <option value="gia_giam_dan" selected="@(ViewBag.SortOrder == "gia_giam_dan")">Giá cao &rarr; Thấp</option>
                    <option value="muc_ton_tang" selected="@(ViewBag.SortOrder == "muc_ton_tang")">Mức tối thiểu &uarr;</option>
                    <option value="muc_ton_giam" selected="@(ViewBag.SortOrder == "muc_ton_giam")">Mức tối thiểu &darr;</option>
                    <option value="ton_tang" selected="@(ViewBag.SortOrder == "ton_tang")">Tồn kho &uarr;</option>
                    <option value="ton_giam" selected="@(ViewBag.SortOrder == "ton_giam")">Tồn kho &darr;</option>
                </select>
            </div>

            <!-- Nút bấm -->
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary d-inline-flex align-items-center gap-1 flex-grow-1 justify-content-center">
                    <i class="bi bi-funnel-fill"></i> Lọc
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary d-inline-flex align-items-center gap-1">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-2">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <span class="fw-semibold text-secondary">
            <i class="bi bi-boxes me-1"></i> Danh sách: <strong>@(ViewBag.TotalItems ?? Model?.Count() ?? 0)</strong> sản phẩm
        </span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">Mã</th>
                        <th>Tên hàng hóa</th>
                        <th>Loại hàng</th>
                        <th>ĐVT</th>
                        <th class="text-end">Giá tham khảo</th>
                        <th class="text-center">Tối thiểu</th>
                        <th class="text-center">Tổng tồn</th>
                        <th class="text-center">Trạng thái</th>
                        <th class="text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            var tongTon = tongTonDict.GetValueOrDefault(item.MaHang);
                            <tr>
                                <td class="ps-4 font-monospace text-muted">#@item.MaHang</td>
                                <td>
                                    <span class="fw-bold text-dark d-block">@item.TenHang</span>
                                    @if (!string.IsNullOrEmpty(item.MoTa))
                                    {
                                        <small class="text-muted text-truncate d-inline-block" style="max-width: 250px;">@item.MoTa</small>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        @(item.LoaiHang?.TenLoaiHang ?? "---")
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-secondary-subtle text-secondary">
                                        @(item.DonViTinh?.TenDonViTinh ?? "---")
                                    </span>
                                </td>
                                <td class="text-end fw-semibold text-primary">
                                    @item.GiaNhapThamKhao.ToString("#,##0") VNĐ
                                </td>
                                <td class="text-center text-muted font-monospace">
                                    @item.MucTonToiThieu
                                </td>
                                <td class="text-center">
                                    @if (tongTon == 0)
                                    {
                                        <span class="badge bg-danger">
                                            <i class="bi bi-x-circle-fill me-1"></i> Hết hàng (0)
                                        </span>
                                    }
                                    else if (tongTon <= item.MucTonToiThieu)
                                    {
                                        <span class="badge bg-warning text-dark">
                                            <i class="bi bi-exclamation-triangle-fill me-1"></i> Sắp hết (@tongTon)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">
                                            <i class="bi bi-check-circle-fill me-1"></i> An toàn (@tongTon)
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (item.TrangThai)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">Hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-muted border">Ngừng HĐ</span>
                                    }
                                </td>
                                <td class="text-end pe-4 text-nowrap">
                                    <div class="d-inline-flex gap-1" role="group">
                                        <a asp-action="Details" asp-route-id="@item.MaHang" class="btn btn-outline-info btn-sm text-nowrap" title="Xem phân bổ kho">
                                            <i class="bi bi-eye me-1"></i> Chi tiết
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.MaHang" class="btn btn-outline-primary btn-sm text-nowrap" title="Chỉnh sửa hàng">
                                            <i class="bi bi-pencil-square me-1"></i> Sửa
                                        </a>
                                        <form asp-action="DoiTrangThai" asp-route-id="@item.MaHang" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-outline-secondary btn-sm text-nowrap" title="Đổi trạng thái hoạt động">
                                                <i class="bi bi-arrow-repeat me-1"></i> @(item.TrangThai ? "Ngừng" : "Bật")
                                            </button>
                                        </form>
                                        <a asp-action="Delete" asp-route-id="@item.MaHang" class="btn btn-outline-danger btn-sm text-nowrap" title="Xóa hàng">
                                            <i class="bi bi-trash me-1"></i> Xóa
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center text-muted py-5">
                                <i class="bi bi-inbox fs-1 d-block text-secondary opacity-50 mb-2"></i>
                                Không tìm thấy hàng hóa nào phù hợp với bộ lọc.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Phân trang Server-side chuẩn LINQ -->
    @{
        int currentPage = ViewBag.CurrentPage ?? 1;
        int totalPages = ViewBag.TotalPages ?? 0;

        Func<int, Dictionary<string, string?>> routeFor = p => new Dictionary<string, string?>
        {
            ["searchString"] = ViewBag.SearchString,
            ["maLoaiHang"] = ViewBag.MaLoaiHang?.ToString(),
            ["maDonViTinh"] = ViewBag.MaDonViTinh?.ToString(),
            ["trangThai"] = ViewBag.TrangThai?.ToString()?.ToLower(),
            ["giaTu"] = ViewBag.GiaTu?.ToString(),
            ["giaDen"] = ViewBag.GiaDen?.ToString(),
            ["maKho"] = ViewBag.MaKho?.ToString(),
            ["canhBao"] = ViewBag.CanhBao,
            ["sortOrder"] = ViewBag.SortOrder,
            ["page"] = p.ToString()
        };
    }

    @if (totalPages > 1)
    {
        <div class="card-footer bg-white py-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span class="text-muted small">
                Hiển thị trang <strong>@currentPage</strong> / <strong>@totalPages</strong> (Tổng cộng: @ViewBag.TotalItems hàng hóa)
            </span>
            <nav aria-label="Page navigation">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-all-route-data="routeFor(currentPage - 1)">
                            <i class="bi bi-chevron-left"></i> Trước
                        </a>
                    </li>
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-all-route-data="routeFor(i)">@i</a>
                        </li>
                    }
                    <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-all-route-data="routeFor(currentPage + 1)">
                            Sau <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
