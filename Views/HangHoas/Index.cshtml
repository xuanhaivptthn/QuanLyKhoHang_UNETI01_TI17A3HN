@model IEnumerable<QuanLyKhoHang_UNETI01_TI17A3HN.Models.HangHoa>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Thêm mới hàng hóa</a>
</p>

<form asp-action="Index" method="get" class="card p-3 mb-3 bg-light">
    <div class="row g-2">
        <div class="col-md-3">
            <input type="text" name="searchString" value="@ViewBag.SearchString" class="form-control" placeholder="Mã, tên hàng, loại hàng hoặc tên kho..." />
        </div>
        <div class="col-md-2">
            <select name="maLoaiHang" class="form-select" asp-items="ViewBag.LoaiHangs">
                <option value="">-- Loại hàng --</option>
            </select>
        </div>
        <div class="col-md-2">
            <select name="maDonViTinh" class="form-select" asp-items="ViewBag.DonViTinhs">
                <option value="">-- Đơn vị tính --</option>
            </select>
        </div>
        <div class="col-md-2">
            <select name="maKho" class="form-select" asp-items="ViewBag.Khos">
                <option value="">-- Kho --</option>
            </select>
        </div>
        <div class="col-md-3">
            <select name="trangThai" class="form-select">
                <option value="">-- Trạng thái hàng --</option>
                <option value="true" selected="@(ViewBag.TrangThai == true)">Đang hoạt động</option>
                <option value="false" selected="@(ViewBag.TrangThai == false)">Ngừng hoạt động</option>
            </select>
        </div>
        <div class="col-md-2">
            <input type="number" name="giaTu" min="0" step="any" value="@ViewBag.GiaTu" class="form-control" placeholder="Giá từ" />
        </div>
        <div class="col-md-2">
            <input type="number" name="giaDen" min="0" step="any" value="@ViewBag.GiaDen" class="form-control" placeholder="Giá đến" />
        </div>
        <div class="col-md-3">
            <select name="canhBao" class="form-select">
                <option value="">-- Cảnh báo tồn --</option>
                <option value="canh_bao" selected="@(ViewBag.CanhBao == "canh_bao")">Cảnh báo (tồn &lt;= mức tối thiểu)</option>
                <option value="binh_thuong" selected="@(ViewBag.CanhBao == "binh_thuong")">Bình thường</option>
            </select>
        </div>
        <div class="col-md-3">
            <select name="sortOrder" class="form-select">
                <option value="">-- Sắp xếp --</option>
                <option value="ten_tang_dan" selected="@(ViewBag.SortOrder == "ten_tang_dan")">Tên hàng A → Z</option>
                <option value="ten_giam_dan" selected="@(ViewBag.SortOrder == "ten_giam_dan")">Tên hàng Z → A</option>
                <option value="gia_tang_dan" selected="@(ViewBag.SortOrder == "gia_tang_dan")">Giá tăng dần</option>
                <option value="gia_giam_dan" selected="@(ViewBag.SortOrder == "gia_giam_dan")">Giá giảm dần</option>
                <option value="muc_ton_tang" selected="@(ViewBag.SortOrder == "muc_ton_tang")">Mức tồn tối thiểu tăng</option>
                <option value="muc_ton_giam" selected="@(ViewBag.SortOrder == "muc_ton_giam")">Mức tồn tối thiểu giảm</option>
                <option value="ton_tang" selected="@(ViewBag.SortOrder == "ton_tang")">Số lượng tồn tăng</option>
                <option value="ton_giam" selected="@(ViewBag.SortOrder == "ton_giam")">Số lượng tồn giảm</option>
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Lọc</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Tất cả</a>
        </div>
    </div>
</form>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.TenHang)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.LoaiHang)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DonViTinh)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.GiaNhapThamKhao)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MucTonToiThieu)
            </th>
            <th>Tồn</th>
            <th>
                @Html.DisplayNameFor(model => model.MoTa)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TrangThai)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.TenHang)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.LoaiHang.TenLoaiHang)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DonViTinh.TenDonViTinh)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.GiaNhapThamKhao)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.MucTonToiThieu)
            </td>
            <td>
                @{
                    var tongTon = ((Dictionary<int, int>)ViewBag.TongTon).GetValueOrDefault(item.MaHang);
                }
                @tongTon
                @if (tongTon <= item.MucTonToiThieu)
                {
                    <span class="badge bg-danger">Cảnh báo</span>
                }
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.MoTa)
            </td>
            <td>
                @(item.TrangThai ? "Đang hoạt động" : "Ngừng hoạt động")
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.MaHang">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.MaHang">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.MaHang">Delete</a> |
                <form asp-action="DoiTrangThai" asp-route-id="@item.MaHang" method="post" class="d-inline">
                    <button type="submit" class="btn btn-link p-0 align-baseline">@(item.TrangThai ? "Ngừng HĐ" : "Kích hoạt")</button>
                </form>
            </td>
        </tr>
}
    </tbody>
</table>

@{
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 0;

    // Giữ nguyên điều kiện tìm kiếm, lọc, sắp xếp khi chuyển trang
    Func<int, Dictionary<string, string?>> routeFor = p => new Dictionary<string, string?>
    {
        ["searchString"] = ViewBag.SearchString,
        ["maLoaiHang"] = ViewBag.MaLoaiHang?.ToString(),
        ["maDonViTinh"] = ViewBag.MaDonViTinh?.ToString(),
        ["trangThai"] = ViewBag.TrangThai?.ToString().ToLower(),
        ["giaTu"] = ViewBag.GiaTu?.ToString(),
        ["giaDen"] = ViewBag.GiaDen?.ToString(),
        ["maKho"] = ViewBag.MaKho?.ToString(),
        ["canhBao"] = ViewBag.CanhBao,
        ["sortOrder"] = ViewBag.SortOrder,
        ["page"] = p.ToString()
    };
}

@if (totalPages > 1)
{
    <nav>
        <ul class="pagination">
            <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-all-route-data="routeFor(currentPage - 1)">Trước</a>
            </li>
            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == currentPage ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-all-route-data="routeFor(i)">@i</a>
                </li>
            }
            <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-all-route-data="routeFor(currentPage + 1)">Sau</a>
            </li>
        </ul>
    </nav>
    <p class="text-muted">Trang @currentPage / @totalPages (tổng @ViewBag.TotalItems hàng hóa)</p>
}
