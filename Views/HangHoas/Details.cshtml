@*
    Họ và tên: Nguyễn Thị Cúc
    Mã sinh viên: 23103100178
    Phụ trách Module 2: Quản lý Kho, Hàng hóa & Tra cứu dữ liệu cửa hàng
*@
@model QuanLyKhoHang_UNETI01_TI17A3HN.Models.HangHoa

@{
    ViewData["Title"] = "Chi tiết Hàng hóa - " + Model.TenHang;
    var tonKhos = (Model?.DanhSachTonKho ?? new List<QuanLyKhoHang_UNETI01_TI17A3HN.Models.TonKho>())
        .OrderBy(t => t.Kho?.TenKho)
        .ToList();
    var tongTonHeThong = tonKhos.Sum(t => t.SoLuongTon);
}

<div class="page-header">
    <div>
        <h2 class="page-title"><i class="bi bi-box-seam-fill text-primary"></i> Chi Tiết Hàng Hóa</h2>
        <p class="page-subtitle">Xem thông số chi tiết và phân bổ số lượng tồn trên toàn hệ thống kho</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model?.MaHang" class="btn btn-primary">
            <i class="bi bi-pencil-square"></i> Chỉnh sửa
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Quay lại
        </a>
    </div>
</div>

<div class="row g-4">
    <!-- Cột Thông tin cơ bản -->
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm rounded-2 h-100">
            <div class="card-header bg-white py-3">
                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-info-circle text-primary me-2"></i> Thông Tin Sản Phẩm</h5>
            </div>
            <div class="card-body p-4">
                <div class="mb-3">
                    <span class="badge bg-light text-primary border font-monospace px-2 py-1">Mã hàng: #@Model?.MaHang</span>
                    <h4 class="fw-bold text-dark mt-2 mb-1">@Model?.TenHang</h4>
                    <p class="text-muted small">@(string.IsNullOrEmpty(Model?.MoTa) ? "Chưa có mô tả chi tiết." : Model.MoTa)</p>
                </div>

                <hr class="text-secondary opacity-25" />

                <dl class="row gy-3 mb-0">
                    <dt class="col-sm-5 text-muted">Loại hàng:</dt>
                    <dd class="col-sm-7 fw-semibold"><span class="badge bg-light text-dark border">@Model?.LoaiHang?.TenLoaiHang</span></dd>

                    <dt class="col-sm-5 text-muted">Đơn vị tính:</dt>
                    <dd class="col-sm-7 fw-semibold"><span class="badge bg-secondary-subtle text-secondary">@Model?.DonViTinh?.TenDonViTinh</span></dd>

                    <dt class="col-sm-5 text-muted">Giá nhập tham khảo:</dt>
                    <dd class="col-sm-7 fw-bold text-primary fs-5">@Model?.GiaNhapThamKhao.ToString("#,##0") VNĐ</dd>

                    <dt class="col-sm-5 text-muted">Mức tồn tối thiểu:</dt>
                    <dd class="col-sm-7 font-monospace fw-bold text-danger">@Model?.MucTonToiThieu @Model?.DonViTinh?.TenDonViTinh</dd>

                    <dt class="col-sm-5 text-muted">Trạng thái kinh doanh:</dt>
                    <dd class="col-sm-7">
                        @if (Model != null && Model.TrangThai)
                        {
                            <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i> Đang kinh doanh</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary"><i class="bi bi-pause-circle me-1"></i> Ngừng kinh doanh</span>
                        }
                    </dd>
                </dl>
            </div>
        </div>
    </div>

    <!-- Cột Bảng phân bổ tồn kho tại các chi nhánh/kho hàng -->
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm rounded-2 h-100">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-building text-success me-2"></i> Phân Bổ Tồn Kho Tại Các Chi Nhánh
                </h5>
                <span class="badge @(tongTonHeThong <= (Model?.MucTonToiThieu ?? 0) ? "bg-warning text-dark" : "bg-success")">
                    Tổng tồn: @tongTonHeThong @Model?.DonViTinh?.TenDonViTinh
                </span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th class="ps-4">Kho lưu trữ</th>
                                <th class="text-center">Số lượng tồn</th>
                                <th>Mức cảnh báo</th>
                                <th class="text-end pe-4">Thời điểm cập nhật</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (tonKhos.Any())
                            {
                                foreach (var t in tonKhos)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <div class="d-flex align-items-center gap-2">
                                                <i class="bi bi-geo-alt text-danger"></i>
                                                <strong>@(t.Kho?.TenKho ?? "Kho #" + t.MaKho)</strong>
                                            </div>
                                        </td>
                                        <td class="text-center font-monospace fw-bold fs-6">
                                            @t.SoLuongTon @Model?.DonViTinh?.TenDonViTinh
                                        </td>
                                        <td>
                                            @if (t.SoLuongTon == 0)
                                            {
                                                <span class="badge bg-danger">Hết hàng</span>
                                            }
                                            else if (t.SoLuongTon <= (Model?.MucTonToiThieu ?? 0))
                                            {
                                                <span class="badge bg-warning text-dark">Sắp hết</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success">Đủ tồn</span>
                                            }
                                        </td>
                                        <td class="text-end pe-4 text-muted small">
                                            @t.NgayCapNhat.ToString("dd/MM/yyyy HH:mm")
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-4">
                                        <i class="bi bi-inbox fs-2 d-block text-secondary opacity-50 mb-2"></i>
                                        Chưa có bản ghi tồn kho nào cho mặt hàng này.
                                    </td>
                                </tr>
                            }
                        </tbody>
                        @if (tonKhos.Any())
                        {
                            <tfoot>
                                <tr class="table-light">
                                    <th class="ps-4">Tổng cộng toàn hệ thống</th>
                                    <th class="text-center text-primary fs-5">@tongTonHeThong @Model?.DonViTinh?.TenDonViTinh</th>
                                    <th colspan="2" class="text-end pe-4">
                                        <a asp-controller="PhieuNhaps" asp-action="Create" class="btn btn-sm btn-outline-success">
                                            <i class="bi bi-plus-circle"></i> Nhập thêm hàng
                                        </a>
                                    </th>
                                </tr>
                            </tfoot>
                        }
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
