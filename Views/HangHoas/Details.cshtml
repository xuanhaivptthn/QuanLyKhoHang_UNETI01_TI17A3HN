@model QuanLyKhoHang_UNETI01_TI17A3HN.Models.HangHoa

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>HangHoa</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.TenHang)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.TenHang)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.LoaiHang)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.LoaiHang.TenLoaiHang)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.DonViTinh)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.DonViTinh.TenDonViTinh)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.GiaNhapThamKhao)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.GiaNhapThamKhao)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.MucTonToiThieu)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.MucTonToiThieu)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.MoTa)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.MoTa)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.TrangThai)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.TrangThai)
        </dd>
    </dl>
</div>
@{
    var tonKhos = (Model?.DanhSachTonKho ?? new List<QuanLyKhoHang_UNETI01_TI17A3HN.Models.TonKho>())
        .OrderBy(t => t.Kho?.TenKho)
        .ToList();
}
<div class="mt-4">
    <h5>Số lượng tồn theo kho</h5>
    <table class="table table-sm">
        <thead>
            <tr>
                <th>Kho</th>
                <th>Số lượng tồn</th>
                <th>Ngày cập nhật</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in tonKhos)
            {
                <tr>
                    <td>@t.Kho?.TenKho</td>
                    <td>@t.SoLuongTon</td>
                    <td>@t.NgayCapNhat.ToString("dd/MM/yyyy HH:mm")</td>
                </tr>
            }
            @if (!tonKhos.Any())
            {
                <tr><td colspan="3" class="text-muted">Chưa có tồn tại kho nào.</td></tr>
            }
        </tbody>
        @if (tonKhos.Any())
        {
            <tfoot>
                <tr>
                    <th>Tổng</th>
                    <th colspan="2">@tonKhos.Sum(t => t.SoLuongTon)</th>
                </tr>
            </tfoot>
        }
    </table>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.MaHang">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
