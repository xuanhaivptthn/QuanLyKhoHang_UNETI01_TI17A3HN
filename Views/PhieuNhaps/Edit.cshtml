@*
    Họ và tên: Lê Văn Hùng
    Mã sinh viên: 23103100177
    Phụ trách Module 3: Nhà cung cấp, Phiếu nhập, Chi tiết phiếu nhập
*@
@model QuanLyKhoHang_UNETI01_TI17A3HN.Models.PhieuNhap

@{
    ViewData["Title"] = "Chỉnh sửa phiếu nhập #PN-" + Model.MaPhieuNhap;
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="page-header">
            <div>
                <h2 class="page-title"><i class="bi bi-pencil-square text-primary"></i> Chỉnh Sửa Phiếu Nhập Kho</h2>
                <p class="page-subtitle">Cập nhật thông tin phiếu nhập: <strong>#PN-@Model.MaPhieuNhap</strong></p>
            </div>
            <div>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Quay lại danh sách
                </a>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-2">
            <div class="card-body p-4 p-md-5">
                <form asp-action="Edit" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4 py-2" role="alert"></div>
                    <input type="hidden" asp-for="MaPhieuNhap" />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="MaNhaCungCap" class="form-label fw-semibold">
                                <i class="bi bi-truck me-1 text-primary"></i> Nhà cung cấp <span class="text-danger">*</span>
                            </label>
                            <select asp-for="MaNhaCungCap" class="form-select" asp-items="ViewBag.MaNhaCungCap"></select>
                            <span asp-validation-for="MaNhaCungCap" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="MaKho" class="form-label fw-semibold">
                                <i class="bi bi-building me-1 text-info"></i> Kho tiếp nhận <span class="text-danger">*</span>
                            </label>
                            <select asp-for="MaKho" class="form-select" asp-items="ViewBag.MaKho"></select>
                            <span asp-validation-for="MaKho" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="NgayNhap" class="form-label fw-semibold">
                                <i class="bi bi-calendar-event me-1 text-primary"></i> Ngày nhập hàng <span class="text-danger">*</span>
                            </label>
                            <input asp-for="NgayNhap" type="datetime-local" class="form-control" />
                            <span asp-validation-for="NgayNhap" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="NguoiLap" class="form-label fw-semibold">
                                <i class="bi bi-person me-1 text-primary"></i> Người lập phiếu <span class="text-danger">*</span>
                            </label>
                            <input asp-for="NguoiLap" class="form-control" />
                            <span asp-validation-for="NguoiLap" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="TrangThai" class="form-label fw-semibold">
                                <i class="bi bi-flag me-1 text-primary"></i> Trạng thái phiếu
                            </label>
                            <select asp-for="TrangThai" class="form-select">
                                <option value="0">Nháp (0)</option>
                                <option value="1">Chờ xác nhận (1)</option>
                            </select>
                            <span asp-validation-for="TrangThai" class="text-danger small"></span>
                        </div>

                        <div class="col-md-12">
                            <label asp-for="GhiChu" class="form-label fw-semibold">
                                <i class="bi bi-card-text me-1 text-primary"></i> Ghi chú chứng từ
                            </label>
                            <textarea asp-for="GhiChu" rows="3" class="form-control"></textarea>
                            <span asp-validation-for="GhiChu" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary">Hủy bỏ</a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-check-circle-fill"></i> Cập nhật phiếu nhập
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
