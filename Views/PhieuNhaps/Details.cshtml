@model QuanLyKhoHang_UNETI01_TI17A3HN.Models.PhieuNhap

@{
    ViewData["Title"] = "Chi tiết phiếu nhập #" + Model.MaPhieuNhap;
    var currentRole = Context.Session.GetString("VaiTro");
    var isAdmin = string.Equals(currentRole, "Admin", StringComparison.OrdinalIgnoreCase);
    var isWarehouseStaff = string.Equals(currentRole, "NhanVienKho", StringComparison.OrdinalIgnoreCase);
    var canManage = isAdmin || isWarehouseStaff;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-box-arrow-in-down"></i> Chi tiết phiếu nhập #@Model.MaPhieuNhap</h2>
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Danh sách phiếu nhập</a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-8">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-light fw-bold">Thông tin phiếu nhập</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-3 text-muted">Mã phiếu:</dt>
                    <dd class="col-sm-9 fw-semibold">PN@(Model.MaPhieuNhap.ToString("D4"))</dd>

                    <dt class="col-sm-3 text-muted">Ngày nhập:</dt>
                    <dd class="col-sm-9">@Model.NgayNhap.ToString("dd/MM/yyyy")</dd>

                    <dt class="col-sm-3 text-muted">Người lập:</dt>
                    <dd class="col-sm-9">@Model.NguoiLap</dd>

                    <dt class="col-sm-3 text-muted">Nhà cung cấp:</dt>
                    <dd class="col-sm-9">@(Model.NhaCungCap?.TenNhaCungCap ?? Model.MaNhaCungCap.ToString())</dd>

                    <dt class="col-sm-3 text-muted">Kho nhập:</dt>
                    <dd class="col-sm-9">@(Model.Kho?.TenKho ?? Model.MaKho.ToString())</dd>

                    <dt class="col-sm-3 text-muted">Ghi chú:</dt>
                    <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.GhiChu) ? "—" : Model.GhiChu)</dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-light fw-bold">Trạng thái & Tổng kết</div>
            <div class="card-body d-flex flex-column justify-content-between">
                <div>
                    <div class="mb-3">
                        <span class="text-muted d-block small">Trạng thái hiện tại:</span>
                        @switch (Model.TrangThai)
                        {
                            case TrangThaiPhieuNhap.Nhap:
                                <span class="badge bg-secondary fs-6">Nháp</span>
                                break;
                            case TrangThaiPhieuNhap.ChoXacNhan:
                                <span class="badge bg-warning text-dark fs-6">Chờ xác nhận</span>
                                break;
                            case TrangThaiPhieuNhap.DaHoanTat:
                                <span class="badge bg-success fs-6">Đã hoàn tất</span>
                                break;
                            case TrangThaiPhieuNhap.DaHuy:
                                <span class="badge bg-danger fs-6">Đã hủy</span>
                                break;
                        }
                    </div>
                    <ul class="list-unstyled mb-0">
                        <li class="d-flex justify-content-between py-1 border-bottom">
                            <span class="text-muted">Số mặt hàng:</span>
                            <span class="fw-semibold">@Model.SoMatHang</span>
                        </li>
                        <li class="d-flex justify-content-between py-1 border-bottom">
                            <span class="text-muted">Tổng số lượng nhập:</span>
                            <span class="fw-semibold text-primary">@Model.TongSoLuong</span>
                        </li>
                        <li class="d-flex justify-content-between py-1">
                            <span class="text-muted">Tổng tiền nhập:</span>
                            <span class="fw-bold text-success">@Model.TongTienNhap.ToString("N0") VNĐ</span>
                        </li>
                    </ul>
                </div>

                @if (canManage)
                {
                    <div class="mt-3 pt-3 border-top d-flex flex-wrap gap-2">
                        @if (Model.TrangThai == TrangThaiPhieuNhap.Nhap || Model.TrangThai == TrangThaiPhieuNhap.ChoXacNhan)
                        {
                            <form asp-action="HoanTat" asp-route-id="@Model.MaPhieuNhap" method="post" class="d-inline" onsubmit="return confirm('Xác nhận hoàn tất phiếu nhập này? Số lượng tồn kho sẽ được cộng dồn.');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-success btn-sm">
                                    <i class="bi bi-check-circle"></i> Hoàn tất nhập kho
                                </button>
                            </form>

                            <form asp-action="HuyPhieu" asp-route-id="@Model.MaPhieuNhap" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn hủy phiếu nhập này?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger btn-sm">
                                    <i class="bi bi-x-circle"></i> Hủy phiếu
                                </button>
                            </form>
                        }

                        @if (Model.TrangThai == TrangThaiPhieuNhap.Nhap || isAdmin)
                        {
                            <a asp-action="Edit" asp-route-id="@Model.MaPhieuNhap" class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-pencil"></i> Sửa phiếu
                            </a>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header bg-light d-flex justify-content-between align-items-center">
        <span class="fw-bold"><i class="bi bi-box-seam"></i> Danh sách mặt hàng nhập</span>
        @if (canManage && (Model.TrangThai == TrangThaiPhieuNhap.Nhap || Model.TrangThai == TrangThaiPhieuNhap.ChoXacNhan))
        {
            <a asp-controller="ChiTietPhieuNhaps" asp-action="Create" asp-route-phieuId="@Model.MaPhieuNhap" asp-route-maPhieuNhap="@Model.MaPhieuNhap" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-circle"></i> Thêm mặt hàng
            </a>
        }
    </div>
    <div class="card-body p-0 table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="text-center" style="width: 50px;">STT</th>
                    <th>Mã hàng</th>
                    <th>Tên hàng</th>
                    <th class="text-end">Số lượng</th>
                    <th class="text-end">Đơn giá nhập</th>
                    <th class="text-end">Thành tiền</th>
                    @if (canManage && (Model.TrangThai == TrangThaiPhieuNhap.Nhap || Model.TrangThai == TrangThaiPhieuNhap.ChoXacNhan))
                    {
                        <th class="text-center" style="width: 140px;">Thao tác</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (Model.ChiTietPhieuNhaps == null || !Model.ChiTietPhieuNhaps.Any())
                {
                    <tr>
                        <td colspan="@(canManage && (Model.TrangThai == TrangThaiPhieuNhap.Nhap || Model.TrangThai == TrangThaiPhieuNhap.ChoXacNhan) ? 7 : 6)" class="text-center text-muted py-4">
                            Phiếu nhập này chưa có chi tiết mặt hàng nào.
                        </td>
                    </tr>
                }
                else
                {
                    int stt = 1;
                    foreach (var ct in Model.ChiTietPhieuNhaps)
                    {
                        <tr>
                            <td class="text-center">@(stt++)</td>
                            <td>@(ct.HangHoa?.MaHang ?? ct.MaHang)</td>
                            <td class="fw-semibold">@(ct.HangHoa?.TenHang ?? "Mặt hàng #" + ct.MaHang)</td>
                            <td class="text-end fw-semibold">@ct.SoLuongNhap</td>
                            <td class="text-end">@ct.DonGiaNhap.ToString("N0") VNĐ</td>
                            <td class="text-end text-success fw-semibold">@ct.ThanhTien.ToString("N0") VNĐ</td>
                            @if (canManage && (Model.TrangThai == TrangThaiPhieuNhap.Nhap || Model.TrangThai == TrangThaiPhieuNhap.ChoXacNhan))
                            {
                                <td class="text-center">
                                    <a asp-controller="ChiTietPhieuNhaps" asp-action="Edit" asp-route-id="@ct.MaChiTietNhap" class="btn btn-outline-primary btn-sm py-0 px-2">Sửa</a>
                                    <a asp-controller="ChiTietPhieuNhaps" asp-action="Delete" asp-route-id="@ct.MaChiTietNhap" class="btn btn-outline-danger btn-sm py-0 px-2">Xóa</a>
                                </td>
                            }
                        </tr>
                    }
                }
            </tbody>
            <tfoot>
                <tr>
                    <th class="text-end" colspan="3">Tổng cộng</th>
                    <th class="text-end fw-bold text-primary">@Model.TongSoLuong</th>
                    <th></th>
                    <th class="text-end fw-bold text-success">@Model.TongTienNhap.ToString("N0") VNĐ</th>
                    @if (canManage && (Model.TrangThai == TrangThaiPhieuNhap.Nhap || Model.TrangThai == TrangThaiPhieuNhap.ChoXacNhan))
                    {
                        <th></th>
                    }
                </tr>
            </tfoot>
        </table>
    </div>
</div>
