@*
    Họ và tên: Lê Văn Hùng
    Mã sinh viên: 23103100178
    Phụ trách Module 3: Nhà cung cấp, Phiếu nhập, Chi tiết phiếu nhập
*@
@model QuanLyKhoHang_UNETI01_TI17A3HN.Models.PhieuNhap

@{
    ViewData["Title"] = "Hóa đơn nhập kho #PN-" + Model.MaPhieuNhap;
    var chiTiets = Model.ChiTietPhieuNhaps?.ToList() ?? new List<QuanLyKhoHang_UNETI01_TI17A3HN.Models.ChiTietPhieuNhap>();
    decimal tongTien = chiTiets.Sum(c => (decimal)c.SoLuongNhap * c.DonGiaNhap);
}

<div class="page-header no-print">
    <div>
        <h2 class="page-title"><i class="bi bi-receipt text-success"></i> Hóa Đơn Nhập Kho</h2>
        <p class="page-subtitle">Chi tiết chứng từ nhập hàng vào kho và danh mục sản phẩm</p>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-outline-secondary" onclick="window.print()">
            <i class="bi bi-printer"></i> In phiếu
        </button>
        @if (Model.TrangThai == 0 || Model.TrangThai == 1)
        {
            <a asp-controller="ChiTietPhieuNhaps" asp-action="Create" asp-route-maPhieuNhap="@Model.MaPhieuNhap" class="btn btn-success">
                <i class="bi bi-plus-circle"></i> Thêm hàng vào phiếu
            </a>
            <a asp-action="Edit" asp-route-id="@Model.MaPhieuNhap" class="btn btn-primary">
                <i class="bi bi-pencil-square"></i> Sửa phiếu
            </a>
        }
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Quay lại
        </a>
    </div>
</div>

<!-- Khung Hóa Đơn Chuyên Nghiệp (Purchase Order Container) -->
<div class="invoice-container mb-4">
    <!-- Header Hóa Đơn -->
    <div class="row align-items-center pb-4 border-bottom mb-4">
        <div class="col-sm-7">
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="bg-primary text-white p-2 rounded-3">
                    <i class="bi bi-box-seam-fill fs-4"></i>
                </span>
                <div>
                    <h4 class="fw-bold mb-0 text-dark">KHO HÀNG UNETI</h4>
                    <small class="text-muted">Hệ thống phân phối và bán lẻ sản phẩm</small>
                </div>
            </div>
            <p class="text-muted small mb-0">Địa chỉ: 218 Lĩnh Nam, Hoàng Mai, Hà Nội &bull; Hotline: 1900-1234</p>
        </div>
        <div class="col-sm-5 text-sm-end mt-3 mt-sm-0">
            <h3 class="fw-bold text-primary mb-1">PHIẾU NHẬP KHO</h3>
            <div class="font-monospace fw-bold text-dark fs-5">#PN-@Model.MaPhieuNhap.ToString("D5")</div>
            <div class="mt-2">
                @if (Model.TrangThai == 0)
                {
                    <span class="badge bg-secondary fs-6">Trạng thái: Nháp</span>
                }
                else if (Model.TrangThai == 1)
                {
                    <span class="badge bg-warning text-dark fs-6">Trạng thái: Chờ xác nhận</span>
                }
                else if (Model.TrangThai == 2)
                {
                    <span class="badge bg-success fs-6"><i class="bi bi-check-circle-fill me-1"></i> Đã hoàn tất nhập kho</span>
                }
                else
                {
                    <span class="badge bg-danger fs-6">Trạng thái: Đã hủy</span>
                }
            </div>
        </div>
    </div>

    <!-- Thông tin Nhà Cung Cấp & Kho Nhập -->
    <div class="row mb-4 g-4">
        <div class="col-md-6">
            <div class="p-3 bg-light rounded-3 h-100 border">
                <h6 class="fw-bold text-secondary text-uppercase small mb-2">
                    <i class="bi bi-truck text-primary me-1"></i> Đơn vị cung cấp
                </h6>
                <div class="fw-bold text-dark fs-6">@(Model.NhaCungCap?.TenNhaCungCap ?? "Chưa rõ")</div>
                <div class="text-muted small mt-1">Điện thoại: @(Model.NhaCungCap?.SoDienThoai ?? "---")</div>
                <div class="text-muted small">Email: @(Model.NhaCungCap?.Email ?? "---")</div>
                <div class="text-muted small">Địa chỉ: @(Model.NhaCungCap?.DiaChi ?? "---")</div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="p-3 bg-light rounded-3 h-100 border">
                <h6 class="fw-bold text-secondary text-uppercase small mb-2">
                    <i class="bi bi-building text-info me-1"></i> Thông tin tiếp nhận
                </h6>
                <div class="fw-bold text-dark fs-6">Kho nhập: @(Model.Kho?.TenKho ?? "Chưa chỉ định")</div>
                <div class="text-muted small mt-1">Địa điểm: @(Model.Kho?.DiaDiem ?? "---")</div>
                <div class="text-muted small">Người lập phiếu: <strong>@Model.NguoiLap</strong></div>
                <div class="text-muted small">Ngày lập: <strong>@Model.NgayNhap.ToString("dd/MM/yyyy HH:mm")</strong></div>
            </div>
        </div>
    </div>

    <!-- Bảng Chi Tiết Hàng Nhập -->
    <div class="table-responsive mb-4">
        <table class="table table-bordered align-middle">
            <thead class="table-light">
                <tr>
                    <th class="text-center" style="width: 50px;">STT</th>
                    <th>Mã hàng</th>
                    <th>Tên hàng hóa</th>
                    <th class="text-center">Số lượng</th>
                    <th class="text-end">Đơn giá nhập</th>
                    <th class="text-end">Thành tiền</th>
                    @if (Model.TrangThai == 0 || Model.TrangThai == 1)
                    {
                        <th class="text-center no-print" style="width: 100px;">Thao tác</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (chiTiets.Any())
                {
                    int stt = 1;
                    foreach (var ct in chiTiets)
                    {
                        var thanhTien = (decimal)ct.SoLuongNhap * ct.DonGiaNhap;
                        <tr>
                            <td class="text-center">@(stt++)</td>
                            <td class="font-monospace text-muted">#@ct.MaHang</td>
                            <td class="fw-semibold text-dark">@(ct.HangHoa?.TenHang ?? "Sản phẩm #" + ct.MaHang)</td>
                            <td class="text-center font-monospace fw-bold">@ct.SoLuongNhap</td>
                            <td class="text-end">@ct.DonGiaNhap.ToString("#,##0") VNĐ</td>
                            <td class="text-end fw-bold text-primary">@thanhTien.ToString("#,##0") VNĐ</td>
                            @if (Model.TrangThai == 0 || Model.TrangThai == 1)
                            {
                                <td class="text-center no-print text-nowrap">
                                    <div class="d-inline-flex gap-1">
                                        <a asp-controller="ChiTietPhieuNhaps" asp-action="Edit" asp-route-id="@ct.MaChiTietNhap" class="btn btn-outline-primary btn-sm text-nowrap" title="Sửa dòng mặt hàng">
                                            <i class="bi bi-pencil me-1"></i> Sửa
                                        </a>
                                        <a asp-controller="ChiTietPhieuNhaps" asp-action="Delete" asp-route-id="@ct.MaChiTietNhap" class="btn btn-outline-danger btn-sm text-nowrap" title="Xóa dòng mặt hàng">
                                            <i class="bi bi-trash me-1"></i> Xóa
                                        </a>
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="@(Model.TrangThai == 0 || Model.TrangThai == 1 ? 7 : 6)" class="text-center text-muted py-4">
                            Phiếu chưa có mặt hàng nào. Vui lòng bấm <strong>"Thêm hàng vào phiếu"</strong> để bổ sung.
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="table-light">
                    <th colspan="5" class="text-end fw-bold fs-6">TỔNG CỘNG THANH TOÁN:</th>
                    <th class="text-end fw-bold text-success fs-5">@tongTien.ToString("#,##0") VNĐ</th>
                    @if (Model.TrangThai == 0 || Model.TrangThai == 1)
                    {
                        <th class="no-print"></th>
                    }
                </tr>
            </tfoot>
        </table>
    </div>

    <!-- Ghi chú & Chữ ký -->
    <div class="row pt-3">
        <div class="col-sm-6">
            <h6 class="fw-bold small text-muted">Ghi chú phiếu nhập:</h6>
            <p class="text-secondary small fst-italic">@(string.IsNullOrEmpty(Model.GhiChu) ? "Không có ghi chú thêm." : Model.GhiChu)</p>
        </div>
        <div class="col-sm-6">
            <div class="row text-center mt-4 pt-2">
                <div class="col-6">
                    <div class="fw-bold small">Đại diện giao hàng</div>
                    <div class="text-muted small fst-italic mt-5">(Ký, ghi rõ họ tên)</div>
                </div>
                <div class="col-6">
                    <div class="fw-bold small">Thủ kho nhận hàng</div>
                    <div class="text-muted small fst-italic mt-5">@Model.NguoiLap</div>
                </div>
            </div>
        </div>
    </div>
</div>
