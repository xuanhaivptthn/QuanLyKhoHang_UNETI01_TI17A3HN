@model QuanLyKhoHang_UNETI01_TI17A3HN.Models.PhieuNhap

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div class="card mb-4">
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <dl class="row mb-0">
                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.NgayNhap)</dt>
                    <dd class="col-sm-8">@Model.NgayNhap.ToString("yyyy-MM-dd")</dd>

                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.NguoiLap)</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.NguoiLap)</dd>

                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.TrangThai)</dt>
                    <dd class="col-sm-8">@(
                        Model.TrangThai == 0 ? "Nháp" :
                        Model.TrangThai == 1 ? "Chờ xác nhận" :
                        Model.TrangThai == 2 ? "Đã hoàn tất" : "Đã hủy")</dd>
                </dl>
            </div>
            <div class="col-md-6">
                <dl class="row mb-0">
                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.NhaCungCap)</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.NhaCungCap.TenNhaCungCap)</dd>

                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Kho)</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Kho.TenKho)</dd>

                    <dt class="col-sm-4">Tổng tiền</dt>
                    <dd class="col-sm-8">@((Model.TongTienNhap % 1m) == 0m ? Model.TongTienNhap.ToString("N0") : Model.TongTienNhap.ToString("N2"))</dd>
                </dl>
            </div>
        </div>
        <hr />
        <div class="d-flex justify-content-start gap-2">
            <a asp-action="Edit" asp-route-id="@Model?.MaPhieuNhap" class="btn btn-sm btn-outline-primary">Edit</a>
            <a asp-action="Index" class="btn btn-sm btn-link">Back to List</a>
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-2">
    <h4 class="mb-0">Chi tiết phiếu nhập</h4>
    <a asp-controller="ChiTietPhieuNhaps" asp-action="Create" asp-route-phieuId="@Model?.MaPhieuNhap" class="btn btn-sm btn-primary">Thêm chi tiết</a>
</div>

<div class="table-responsive">
    <table class="table table-hover table-sm align-middle">
        <thead>
            <tr>
                <th>Hàng hóa</th>
                <th class="text-end">Số lượng</th>
                <th class="text-end">Đơn giá</th>
                <th class="text-end">Thành tiền</th>
                <th class="text-nowrap"></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var ct in Model.ChiTietPhieuNhaps)
        {
            <tr>
                <td style="min-width:280px;">@ct.HangHoa?.TenHang</td>
                <td class="text-end">@ct.SoLuongNhap</td>
                <td class="text-end">@((ct.DonGiaNhap % 1m) == 0m ? ct.DonGiaNhap.ToString("N0") : ct.DonGiaNhap.ToString("N2"))</td>
                <td class="text-end">@((ct.ThanhTien % 1m) == 0m ? ct.ThanhTien.ToString("N0") : ct.ThanhTien.ToString("N2"))</td>
                <td class="text-nowrap">
                    <a asp-controller="ChiTietPhieuNhaps" asp-action="Edit" asp-route-id="@ct.MaChiTietNhap">Edit</a> |
                    <a asp-controller="ChiTietPhieuNhaps" asp-action="Delete" asp-route-id="@ct.MaChiTietNhap">Delete</a>
                </td>
            </tr>
        }
        </tbody>
        <tfoot>
            <tr>
                <th class="text-end" colspan="3">Tổng</th>
                <th class="text-end">@((Model.TongTienNhap % 1m) == 0m ? Model.TongTienNhap.ToString("N0") : Model.TongTienNhap.ToString("N2"))</th>
                <th></th>
            </tr>
        </tfoot>
    </table>
</div>
