@*
    Họ và tên: Lê Văn Hùng
    Mã sinh viên: 23103100178
    Phụ trách Module 3: Nhà cung cấp, Phiếu nhập, Chi tiết phiếu nhập
*@
@model IEnumerable<QuanLyKhoHang_UNETI01_TI17A3HN.Models.PhieuNhap>

@{
    ViewData["Title"] = "Danh sách phiếu nhập kho";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Trang chủ</a></li>
                <li class="breadcrumb-item active" aria-current="page">Phiếu nhập</li>
            </ol>
        </nav>
        <h3 class="fw-bold mb-0 text-dark">Quản Lý Nhập Kho Hàng Hóa</h3>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Create" class="btn btn-primary d-inline-flex align-items-center gap-2">
            <i class="bi bi-plus-lg"></i>
            <span>Tạo phiếu nhập mới</span>
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-2">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <span class="fw-semibold text-secondary">
            <i class="bi bi-receipt me-1"></i> Tổng số: <strong>@(Model?.Count() ?? 0)</strong> phiếu nhập
        </span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">Mã phiếu</th>
                        <th>Nhà cung cấp</th>
                        <th>Kho tiếp nhận</th>
                        <th>Ngày nhập</th>
                        <th>Người lập</th>
                        <th class="text-center">Số món</th>
                        <th class="text-end">Tổng tiền nhập</th>
                        <th class="text-center">Trạng thái</th>
                        <th class="text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            var chiTiets = item.ChiTietPhieuNhaps?.ToList() ?? new List<QuanLyKhoHang_UNETI01_TI17A3HN.Models.ChiTietPhieuNhap>();
                            int soMon = item.SoMatHang > 0 ? item.SoMatHang : chiTiets.Count;
                            decimal tongTien = item.TongTienNhap > 0 ? item.TongTienNhap : chiTiets.Sum(c => (decimal)c.SoLuongNhap * c.DonGiaNhap);
                            <tr>
                                <td class="ps-4">
                                    <a asp-action="Details" asp-route-id="@item.MaPhieuNhap" class="fw-bold font-monospace text-primary text-decoration-none">
                                        #PN-@item.MaPhieuNhap.ToString("D4")
                                    </a>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi bi-truck text-secondary"></i>
                                        <span class="fw-semibold text-dark">@(item.NhaCungCap?.TenNhaCungCap ?? "---")</span>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        <i class="bi bi-building me-1 text-info"></i>@(item.Kho?.TenKho ?? "---")
                                    </span>
                                </td>
                                <td class="text-muted small">
                                    @item.NgayNhap.ToString("dd/MM/yyyy")
                                </td>
                                <td>
                                    <span class="text-muted small"><i class="bi bi-person me-1"></i>@item.NguoiLap</span>
                                </td>
                                <td class="text-center font-monospace">
                                    <span class="badge bg-secondary-subtle text-secondary">@soMon mặt hàng</span>
                                </td>
                                <td class="text-end fw-bold text-success">
                                    @tongTien.ToString("#,##0") VNĐ
                                </td>
                                <td class="text-center">
                                    @switch (item.TrangThai)
                                    {
                                        case TrangThaiPhieuNhap.Nhap:
                                            <span class="badge bg-secondary">Nháp</span>
                                            break;
                                        case TrangThaiPhieuNhap.ChoXacNhan:
                                            <span class="badge bg-warning text-dark">Chờ xác nhận</span>
                                            break;
                                        case TrangThaiPhieuNhap.DaHoanTat:
                                            <span class="badge bg-success"><i class="bi bi-check2-circle me-1"></i> Đã hoàn tất</span>
                                            break;
                                        case TrangThaiPhieuNhap.DaHuy:
                                            <span class="badge bg-danger">Đã hủy</span>
                                            break;
                                    }
                                </td>
                                <td class="text-end pe-4 text-nowrap">
                                    <div class="d-inline-flex gap-1" role="group">
                                        <a asp-action="Details" asp-route-id="@item.MaPhieuNhap" class="btn btn-outline-info btn-sm text-nowrap" title="Xem chi tiết hóa đơn nhập">
                                            <i class="bi bi-eye me-1"></i> Xem phiếu
                                        </a>
                                        @if (item.TrangThai == TrangThaiPhieuNhap.Nhap || item.TrangThai == TrangThaiPhieuNhap.ChoXacNhan)
                                        {
                                            <a asp-action="Edit" asp-route-id="@item.MaPhieuNhap" class="btn btn-outline-primary btn-sm text-nowrap" title="Sửa thông tin phiếu">
                                                <i class="bi bi-pencil-square me-1"></i> Sửa
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.MaPhieuNhap" class="btn btn-outline-danger btn-sm text-nowrap" title="Xóa phiếu nhập">
                                                <i class="bi bi-trash me-1"></i> Xóa
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center text-muted py-5">
                                <i class="bi bi-receipt fs-1 d-block text-secondary opacity-50 mb-2"></i>
                                Chưa có phiếu nhập kho nào.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
