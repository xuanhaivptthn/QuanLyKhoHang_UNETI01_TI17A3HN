@model IEnumerable<PhieuNhap>
@{ ViewData["Title"] = "Phiếu nhập"; string StatusName(int value) => value switch { 0 => "Bản nháp", 1 => "Chờ xác nhận", 2 => "Đã hoàn tất", 3 => "Đã hủy", _ => "Chưa xác định" }; string StatusClass(int value) => value switch { 2 => "status-active", 3 => "status-inactive", _ => "status-pending" }; }
<div class="page-heading"><div><div class="eyebrow">GIAO DỊCH</div><h1>Phiếu nhập</h1><p class="page-description">Theo dõi hàng hóa và tiến độ nhập kho.</p></div><a class="btn btn-primary" asp-action="Create">＋ Tạo phiếu nhập</a></div>
<section class="data-panel" aria-label="Danh sách phiếu nhập"><div class="table-toolbar"><div><h2>Danh sách phiếu nhập</h2><span class="muted-text">@Model.Count() phiếu</span></div></div><div class="table-responsive"><table class="table inventory-table"><thead><tr><th>Mã phiếu</th><th>Nhà cung cấp</th><th>Kho nhập</th><th>Ngày nhập</th><th>Người lập</th><th>Số mặt hàng</th><th>Trạng thái</th><th class="text-end">Thao tác</th></tr></thead><tbody>
@if (!Model.Any()) { <tr><td colspan="8"><div class="empty-state"><strong>Chưa có phiếu nhập</strong><span>Tạo phiếu để ghi nhận hàng hóa nhập kho.</span></div></td></tr> }
@foreach (var item in Model) { <tr><td><span class="item-code">PN-@item.MaPhieuNhap.ToString("D5")</span></td><td>@(item.NhaCungCap?.TenNhaCungCap ?? $"Nhà cung cấp #{item.MaNhaCungCap}")</td><td>@(item.Kho?.TenKho ?? $"Kho #{item.MaKho}")</td><td class="numeric">@item.NgayNhap.ToString("dd/MM/yyyy")</td><td>@(item.NguoiLap ?? "—")</td><td>@(item.ChiTietPhieuNhaps?.Count ?? 0)</td><td><span class="status-pill @StatusClass(item.TrangThai)">@StatusName(item.TrangThai)</span></td><td><div class="row-actions"><a asp-action="Edit" asp-route-id="@item.MaPhieuNhap">Sửa</a><a asp-action="Details" asp-route-id="@item.MaPhieuNhap">Chi tiết</a><a asp-controller="ChiTietPhieuNhaps" asp-action="Index" asp-route-maPhieuNhap="@item.MaPhieuNhap">Mặt hàng</a></div></td></tr> }
</tbody></table></div></section>
