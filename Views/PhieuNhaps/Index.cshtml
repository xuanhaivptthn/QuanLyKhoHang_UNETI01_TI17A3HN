@model IEnumerable<QuanLyKhoHang_UNETI01_TI17A3HN.Models.PhieuNhap>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>Mã phiếu nhập</th>
            <th>
                Mã nhà cung cấp
            </th>
            <th>
                Mã kho
            </th>
            <th>
                Ngày nhập
            </th>
            <th>
                Người nhập
            </th>
            <th>
                Trạng thái
            </th>
            <th>
               Ghi chú
            </th>
            <th>
                Nhà cung cấp
            </th>
            <th>
                Số lượng
            </th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.MaPhieuNhap)
            </td>
            <td>
                @Html.DisplayFor(model => item.MaNhaCungCap)
            </td>
            <td>
                @Html.DisplayFor(model => item.MaKho)
            </td>
            <td>
                @Html.DisplayFor(model => item.NgayNhap)
            </td>
            <td>
                @Html.DisplayFor(model => item.NguoiLap)
            </td>
            <td>
                @Html.DisplayFor(model => item.TrangThai)
            </td>
            <td>
                @Html.DisplayFor(model => item.GhiChu)
            </td>
            <td>
                @Html.DisplayFor(model => item.NhaCungCap)
            </td>
             @foreach (var ct in item.ChiTietPhieuNhaps)
            {
                <td>@ct.SoLuongNhap</td>
                }
            <td>
                <a asp-action="Edit" asp-route-id="@item.MaPhieuNhap">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.MaPhieuNhap">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.MaPhieuNhap">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
