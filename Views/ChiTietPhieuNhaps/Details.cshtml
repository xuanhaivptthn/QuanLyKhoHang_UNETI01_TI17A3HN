@model QuanLyKhoHang_UNETI01_TI17A3HN.Models.ChiTietPhieuNhap

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>ChiTietPhieuNhap</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.SoLuongNhap)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.SoLuongNhap)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.DonGiaNhap)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.DonGiaNhap)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.ThanhTien)
        </dt>
        <dd class = "col-sm-10">
            @(
                (Model.ThanhTien % 1m) == 0m
                ? Model.ThanhTien.ToString("N0")
                : Model.ThanhTien.ToString("N2")
            )
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.PhieuNhap)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.PhieuNhap.MaPhieuNhap)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.HangHoa)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.HangHoa.TenHang)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.MaChiTietNhap">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
