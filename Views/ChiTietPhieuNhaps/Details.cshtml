@*
    Họ và tên: Lê Văn Hùng
    Mã sinh viên: 23103100177
    Phụ trách Module 3: Nhà cung cấp, Phiếu nhập, Chi tiết phiếu nhập
*@
@model QuanLyKhoHang_UNETI01_TI17A3HN.Models.ChiTietPhieuNhap

@{
    ViewData["Title"] = "Chi tiết mặt hàng nhập";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="page-header">
            <div>
                <h2 class="page-title"><i class="bi bi-box-arrow-in-down text-success"></i> Chi Tiết Hàng Nhập Kho</h2>
                <p class="page-subtitle">Thông tin dòng nhập trong phiếu #PN-@Model.MaPhieuNhap</p>
            </div>
            <div>
                <a asp-controller="PhieuNhaps" asp-action="Details" asp-route-id="@Model.MaPhieuNhap" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Quay lại phiếu nhập
                </a>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-2">
            <div class="card-body p-4">
                <dl class="row gy-3 mb-0">
                    <dt class="col-sm-4 text-muted">Mã phiếu nhập:</dt>
                    <dd class="col-sm-8 font-monospace fw-bold text-primary">#PN-@Model.MaPhieuNhap</dd>

                    <dt class="col-sm-4 text-muted">Mặt hàng:</dt>
                    <dd class="col-sm-8 fw-bold">@(Model.HangHoa?.TenHang ?? "---")</dd>

                    <dt class="col-sm-4 text-muted">Số lượng nhập:</dt>
                    <dd class="col-sm-8 font-monospace fw-bold fs-6 text-success">@Model.SoLuongNhap</dd>

                    <dt class="col-sm-4 text-muted">Đơn giá nhập:</dt>
                    <dd class="col-sm-8 text-primary fw-semibold">@Model.DonGiaNhap.ToString("#,##0") VNĐ</dd>

                    <dt class="col-sm-4 text-muted">Thành tiền:</dt>
                    <dd class="col-sm-8 text-success fw-bold fs-5">@Model.ThanhTien.ToString("#,##0") VNĐ</dd>

                    <dt class="col-sm-4 text-muted">Người lập phiếu:</dt>
                    <dd class="col-sm-8">@(Model.PhieuNhap?.NguoiLap ?? "---")</dd>
                </dl>
            </div>
            <div class="card-footer bg-light p-3 d-flex justify-content-end gap-2">
                <a asp-action="Edit" asp-route-id="@Model.MaChiTietNhap" class="btn btn-primary">
                    <i class="bi bi-pencil-square"></i> Chỉnh sửa
                </a>
                <a asp-controller="PhieuNhaps" asp-action="Details" asp-route-id="@Model.MaPhieuNhap" class="btn btn-outline-secondary">
                    Quay lại
                </a>
            </div>
        </div>
    </div>
</div>
