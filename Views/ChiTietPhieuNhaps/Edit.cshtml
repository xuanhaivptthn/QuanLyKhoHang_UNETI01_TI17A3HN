@*
    Họ và tên: Lê Văn Hùng
    Mã sinh viên: 23103100177
    Phụ trách Module 3: Nhà cung cấp, Phiếu nhập, Chi tiết phiếu nhập
*@
@model QuanLyKhoHang_UNETI01_TI17A3HN.Models.ChiTietPhieuNhap

@{
    ViewData["Title"] = "Chỉnh sửa chi tiết phiếu nhập";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="page-header">
            <div>
                <h2 class="page-title"><i class="bi bi-pencil-square text-primary"></i> Sửa Chi Tiết Hàng Nhập</h2>
                <p class="page-subtitle">Cập nhật số lượng và đơn giá nhập cho phiếu #PN-@Model.MaPhieuNhap</p>
            </div>
            <div>
                <a asp-controller="PhieuNhaps" asp-action="Details" asp-route-id="@Model.MaPhieuNhap" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Quay lại phiếu nhập
                </a>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4 p-md-5">
                <form asp-action="Edit" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4 py-2" role="alert"></div>
                    <input type="hidden" asp-for="MaChiTietNhap" />
                    <input type="hidden" asp-for="MaPhieuNhap" />

                    <div class="mb-3">
                        <label asp-for="MaHang" class="form-label fw-semibold">
                            <i class="bi bi-box-seam me-1 text-primary"></i> Mặt hàng <span class="text-danger">*</span>
                        </label>
                        <select asp-for="MaHang" class="form-select" asp-items="ViewBag.MaHang"></select>
                        <span asp-validation-for="MaHang" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="SoLuongNhap" class="form-label fw-semibold">
                                <i class="bi bi-123 me-1 text-primary"></i> Số lượng nhập <span class="text-danger">*</span>
                            </label>
                            <input asp-for="SoLuongNhap" type="number" min="1" class="form-control" />
                            <span asp-validation-for="SoLuongNhap" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="DonGiaNhap" class="form-label fw-semibold">
                                <i class="bi bi-currency-dollar me-1 text-primary"></i> Đơn giá nhập (VNĐ) <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <input asp-for="DonGiaNhap" type="number" min="0" step="any" class="form-control" />
                                <span class="input-group-text bg-light text-muted">VNĐ</span>
                            </div>
                            <span asp-validation-for="DonGiaNhap" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                        <a asp-controller="PhieuNhaps" asp-action="Details" asp-route-id="@Model.MaPhieuNhap" class="btn btn-outline-secondary">Hủy bỏ</a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-check-circle-fill"></i> Cập nhật
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
