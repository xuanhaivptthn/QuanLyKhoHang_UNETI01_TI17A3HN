@*
    Họ và tên: Lê Văn Hùng
    Mã sinh viên: 23103100177
    Phụ trách Module 3: Nhà cung cấp, Phiếu nhập, Chi tiết phiếu nhập
*@
@model IEnumerable<QuanLyKhoHang_UNETI01_TI17A3HN.Models.ChiTietPhieuNhap>

@{
    ViewData["Title"] = "Chi tiết các mặt hàng nhập";
}

<div class="page-header">
    <div>
        <h2 class="page-title"><i class="bi bi-list-check text-success"></i> Danh Sách Chi Tiết Hàng Nhập</h2>
        <p class="page-subtitle">Nhật ký toàn bộ các dòng hàng hóa được nhập vào hệ thống kho</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-circle-fill"></i> Thêm chi tiết nhập
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-header bg-white py-3">
        <span class="fw-semibold text-secondary">
            <i class="bi bi-box-seam me-1"></i> Tổng số: <strong>@(Model?.Count() ?? 0)</strong> dòng hàng nhập
        </span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">Mã dòng</th>
                        <th>Phiếu nhập</th>
                        <th>Tên hàng hóa</th>
                        <th class="text-center">Số lượng nhập</th>
                        <th class="text-end">Đơn giá nhập</th>
                        <th class="text-end">Thành tiền</th>
                        <th class="text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 font-monospace text-muted">#@item.MaChiTietNhap</td>
                                <td>
                                    <a asp-controller="PhieuNhaps" asp-action="Details" asp-route-id="@item.MaPhieuNhap" class="fw-bold text-decoration-none">
                                        #PN-@item.MaPhieuNhap
                                    </a>
                                </td>
                                <td>
                                    <span class="fw-semibold text-dark">@(item.HangHoa?.TenHang ?? "Sản phẩm #" + item.MaHang)</span>
                                </td>
                                <td class="text-center font-monospace fw-bold text-success">
                                    @item.SoLuongNhap
                                </td>
                                <td class="text-end">
                                    @item.DonGiaNhap.ToString("#,##0") VNĐ
                                </td>
                                <td class="text-end fw-bold text-primary">
                                    @item.ThanhTien.ToString("#,##0") VNĐ
                                </td>
                                <td class="text-end pe-4 text-nowrap">
                                    <div class="d-inline-flex gap-1" role="group">
                                        <a asp-action="Details" asp-route-id="@item.MaChiTietNhap" class="btn btn-outline-info btn-sm text-nowrap" title="Xem chi tiết dòng">
                                            <i class="bi bi-eye me-1"></i> Chi tiết
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.MaChiTietNhap" class="btn btn-outline-primary btn-sm text-nowrap" title="Sửa dòng nhập">
                                            <i class="bi bi-pencil-square me-1"></i> Sửa
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.MaChiTietNhap" class="btn btn-outline-danger btn-sm text-nowrap" title="Xóa dòng nhập">
                                            <i class="bi bi-trash me-1"></i> Xóa
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">Chưa có chi tiết hàng nhập nào.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
