@*
    Họ và tên: Lê Văn Hùng
    Mã sinh viên: 23103100177
    Phụ trách Module 3: Nhà cung cấp, Phiếu nhập, Chi tiết phiếu nhập
*@
@model QuanLyKhoHang_UNETI01_TI17A3HN.Models.ChiTietPhieuNhap

@{
    ViewData["Title"] = "Xóa dòng hàng nhập";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card border-danger shadow-sm rounded-4 overflow-hidden">
            <div class="card-header bg-danger text-white p-3 d-flex align-items-center gap-2">
                <i class="bi bi-exclamation-triangle-fill fs-4"></i>
                <h5 class="mb-0 fw-bold">Xác Nhận Xóa Dòng Hàng Nhập</h5>
            </div>
            <div class="card-body p-4">
                <p class="text-danger fw-semibold">
                    Bạn có chắc chắn muốn xóa mặt hàng này khỏi phiếu nhập không?
                </p>

                <div class="bg-light p-3 rounded-3 border mb-4">
                    <dl class="row gy-2 mb-0">
                        <dt class="col-sm-4 text-muted">Mã phiếu:</dt>
                        <dd class="col-sm-8 font-monospace fw-bold text-primary">#PN-@Model.MaPhieuNhap</dd>

                        <dt class="col-sm-4 text-muted">Tên hàng hóa:</dt>
                        <dd class="col-sm-8 fw-bold">@(Model.HangHoa?.TenHang ?? "---")</dd>

                        <dt class="col-sm-4 text-muted">Số lượng nhập:</dt>
                        <dd class="col-sm-8 font-monospace fw-bold">@Model.SoLuongNhap</dd>

                        <dt class="col-sm-4 text-muted">Đơn giá nhập:</dt>
                        <dd class="col-sm-8 text-success fw-semibold">@Model.DonGiaNhap.ToString("#,##0") VNĐ</dd>
                    </dl>
                </div>

                <form asp-action="Delete" method="post" class="d-flex justify-content-end gap-2">
                    <input type="hidden" asp-for="MaChiTietNhap" />
                    <a asp-controller="PhieuNhaps" asp-action="Details" asp-route-id="@Model.MaPhieuNhap" class="btn btn-outline-secondary">
                        <i class="bi bi-x-circle"></i> Hủy bỏ
                    </a>
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash-fill"></i> Xác nhận xóa
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
