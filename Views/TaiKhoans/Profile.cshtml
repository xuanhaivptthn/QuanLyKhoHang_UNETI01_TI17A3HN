@*
    Họ và tên: Trần Xuân Hải
    Mã sinh viên: 23103100135
    Phụ trách Module 1: Tài khoản, Đăng nhập, Phân quyền & Quản lý hồ sơ
*@
@model QuanLyKhoHang_UNETI01_TI17A3HN.Models.TaiKhoan

@{
    ViewData["Title"] = "Hồ sơ cá nhân - " + Model.HoTen;
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Trang chủ</a></li>
                <li class="breadcrumb-item active" aria-current="page">Hồ sơ cá nhân</li>
            </ol>
        </nav>
        <h3 class="fw-bold mb-0 text-dark">Thông tin Hồ sơ Cá nhân</h3>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="CapNhatProfile" class="btn btn-primary d-inline-flex align-items-center gap-2">
            <i class="bi bi-pencil-square"></i>
            <span>Chỉnh sửa thông tin</span>
        </a>
        <a asp-action="DoiMatKhau" class="btn btn-outline-warning d-inline-flex align-items-center gap-2">
            <i class="bi bi-key"></i>
            <span>Đổi mật khẩu</span>
        </a>
    </div>
</div>

<div class="row g-4">
    <!-- Cột trái: Thẻ đại diện cá nhân -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-2 text-center p-4 h-100">
            <div class="card-body d-flex flex-column align-items-center justify-content-center p-0">
                <div class="mb-3">
                    <span class="d-inline-flex align-items-center justify-content-center bg-primary-subtle text-primary rounded-circle" style="width: 90px; height: 90px;">
                        <i class="bi bi-person-circle" style="font-size: 3.5rem;"></i>
                    </span>
                </div>
                <h4 class="fw-bold text-dark mb-1">@Model.HoTen</h4>
                <div class="font-monospace text-muted small mb-2">@@@Model.TenDangNhap</div>

                <div class="d-flex flex-wrap gap-2 justify-content-center mb-4">
                    <span class="badge @(Model.VaiTro == "Admin" ? "bg-danger" : "bg-primary") px-3 py-2">
                        <i class="bi bi-shield-check me-1"></i> @Model.VaiTro
                    </span>
                    @if (Model.TrangThai)
                    {
                        <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2">
                            <i class="bi bi-check-circle-fill me-1"></i> Đang hoạt động
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2">
                            <i class="bi bi-lock-fill me-1"></i> Bị khóa
                        </span>
                    }
                </div>

                <div class="w-100 pt-3 border-top mt-auto d-flex flex-column gap-2">
                    <a asp-action="CapNhatProfile" class="btn btn-outline-primary d-inline-flex align-items-center justify-content-center gap-2 w-100">
                        <i class="bi bi-person-gear"></i> Cập nhật thông tin
                    </a>
                    <a asp-action="DoiMatKhau" class="btn btn-outline-warning d-inline-flex align-items-center justify-content-center gap-2 w-100">
                        <i class="bi bi-key"></i> Đổi mật khẩu
                    </a>
                    <a asp-action="DangXuat" class="btn btn-outline-danger d-inline-flex align-items-center justify-content-center gap-2 w-100">
                        <i class="bi bi-box-arrow-right"></i> Đăng xuất
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Cột phải: Bảng chi tiết hồ sơ -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-2 h-100">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0 fw-bold text-dark">
                    <i class="bi bi-card-checklist text-primary me-2"></i> Chi Tiết Tài Khoản
                </h5>
                <span class="badge bg-light text-secondary border">Mã ID: #@Model.MaTaiKhoan</span>
            </div>
            <div class="card-body p-4">
                <dl class="row gy-3 mb-0">
                    <dt class="col-sm-4 text-secondary">
                        <i class="bi bi-person me-2 text-primary"></i> Họ và tên
                    </dt>
                    <dd class="col-sm-8 fw-bold text-dark">@Model.HoTen</dd>

                    <dt class="col-sm-4 text-secondary">
                        <i class="bi bi-at me-2 text-primary"></i> Tên đăng nhập
                    </dt>
                    <dd class="col-sm-8 font-monospace fw-semibold text-primary">@Model.TenDangNhap</dd>

                    <dt class="col-sm-4 text-secondary">
                        <i class="bi bi-envelope me-2 text-primary"></i> Địa chỉ Email
                    </dt>
                    <dd class="col-sm-8">
                        @if (!string.IsNullOrEmpty(Model.Email))
                        {
                            <a href="mailto:@Model.Email" class="text-decoration-none">@Model.Email</a>
                        }
                        else
                        {
                            <span class="text-muted small">Chưa thiết lập</span>
                        }
                    </dd>

                    <dt class="col-sm-4 text-secondary">
                        <i class="bi bi-shield-lock me-2 text-primary"></i> Vai trò &amp; Quyền hạn
                    </dt>
                    <dd class="col-sm-8">
                        <span class="badge @(Model.VaiTro == "Admin" ? "bg-danger" : "bg-primary")">
                            @Model.VaiTro
                        </span>
                        <small class="text-muted d-block mt-1">
                            @(Model.VaiTro == "Admin" ? "Toàn quyền quản trị hệ thống, dữ liệu và danh mục người dùng." :
                              Model.VaiTro == "NhanVienKho" ? "Quyền thực hiện lập chứng từ nhập, xuất kho và kiểm soát biến động tồn." :
                              "Quyền theo dõi tiếp nhận chứng từ xuất kho dành cho cửa hàng.")
                        </small>
                    </dd>

                    <dt class="col-sm-4 text-secondary">
                        <i class="bi bi-activity me-2 text-primary"></i> Trạng thái kích hoạt
                    </dt>
                    <dd class="col-sm-8">
                        @if (Model.TrangThai)
                        {
                            <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i> Đang hoạt động bình thường</span>
                        }
                        else
                        {
                            <span class="badge bg-danger"><i class="bi bi-exclamation-octagon me-1"></i> Bị tạm khóa</span>
                        }
                    </dd>
                </dl>

                <div class="mt-4 pt-3 border-top bg-light p-3 rounded-2">
                    <h6 class="fw-bold small text-dark mb-2">
                        <i class="bi bi-shield-check text-success me-1"></i> Khuyến nghị bảo mật
                    </h6>
                    <ul class="text-muted small mb-0 ps-3">
                        <li>Nên thay đổi mật khẩu định kỳ 3-6 tháng một lần để đảm bảo an toàn tài khoản kho.</li>
                        <li>Đăng xuất khỏi hệ thống sau khi kết thúc ca làm việc trên máy tính công cộng.</li>
                        <li>Nếu phát hiện hoạt động đăng nhập bất thường, hãy đổi mật khẩu ngay hoặc liên hệ Quản trị viên (Admin).</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
