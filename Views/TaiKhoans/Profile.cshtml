@*
    Họ và tên: Trần Xuân Hải
    Mã sinh viên: 23103100135
    Phụ trách Module 1: Tài khoản, Đăng nhập, Phân quyền & Quản lý hồ sơ
*@
@model QuanLyKhoHang_UNETI01_TI17A3HN.Models.TaiKhoan

@{
    ViewData["Title"] = "Thông tin Hồ sơ Cá nhân";
}

<div class="container mt-4">
    <div class="card col-md-6 mx-auto p-4 shadow-sm border">
        <h4 class="card-title text-center text-primary mb-3">Thông tin Hồ sơ Cá nhân</h4>
        <hr class="mt-0 mb-3" />

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show py-2" role="alert">
                @TempData["Success"]
                <button type="button" class="btn-close py-2" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show py-2" role="alert">
                @TempData["Error"]
                <button type="button" class="btn-close py-2" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <dl class="row mb-0">
            <dt class="col-sm-4 text-muted">Họ và tên:</dt>
            <dd class="col-sm-8 fw-semibold">@Model.HoTen</dd>

            <dt class="col-sm-4 text-muted">Tên đăng nhập:</dt>
            <dd class="col-sm-8">@Model.TenDangNhap</dd>

            <dt class="col-sm-4 text-muted">Email:</dt>
            <dd class="col-sm-8">@Model.Email</dd>

            <dt class="col-sm-4 text-muted">Vai trò:</dt>
            <dd class="col-sm-8">@Model.VaiTro</dd>

            <dt class="col-sm-4 text-muted">Trạng thái:</dt>
            <dd class="col-sm-8">@(Model.TrangThai ? "Đang hoạt động" : "Bị khóa")</dd>
        </dl>

        <div class="text-center mt-3 pt-3 border-top">
            <a asp-action="CapNhatProfile" class="btn btn-primary btn-sm me-2">Cập nhật thông tin</a>
            <a asp-action="DoiMatKhau" class="btn btn-warning btn-sm me-2">Đổi mật khẩu</a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-sm me-2">Về trang chủ</a>
            <a asp-action="DangXuat" class="btn btn-outline-danger btn-sm">Đăng xuất</a>
        </div>
    </div>
</div>
