@*
    Họ và tên: Trần Xuân Hải
    Mã sinh viên: 23103100135
    Phụ trách Module 1: Tài khoản, Đăng nhập, Phân quyền & Quản lý hồ sơ
*@
@model QuanLyKhoHang_UNETI01_TI17A3HN.Models.TaiKhoan

@{
    ViewData["Title"] = "Chi tiết Tài khoản";
}

<div class="container mt-4">
    <div class="card col-md-6 mx-auto p-4 shadow-sm border">
        <h4 class="card-title text-center text-primary mb-3">Chi tiết Tài khoản</h4>
        <hr class="mt-0 mb-3" />

        <dl class="row mb-0">
            <dt class="col-sm-4 text-muted">Mã tài khoản:</dt>
            <dd class="col-sm-8 fw-semibold">#@Model.MaTaiKhoan</dd>

            <dt class="col-sm-4 text-muted">Tên đăng nhập:</dt>
            <dd class="col-sm-8">@Model.TenDangNhap</dd>

            <dt class="col-sm-4 text-muted">Họ và tên:</dt>
            <dd class="col-sm-8 fw-semibold">@Model.HoTen</dd>

            <dt class="col-sm-4 text-muted">Email:</dt>
            <dd class="col-sm-8">@Model.Email</dd>

            <dt class="col-sm-4 text-muted">Vai trò:</dt>
            <dd class="col-sm-8"><span class="badge bg-secondary">@Model.VaiTro</span></dd>

            <dt class="col-sm-4 text-muted">Trạng thái:</dt>
            <dd class="col-sm-8">
                @if (Model.TrangThai)
                {
                    <span class="badge bg-success">Đang hoạt động</span>
                }
                else
                {
                    <span class="badge bg-danger">Bị khóa / Ngừng hoạt động</span>
                }
            </dd>
        </dl>

        <div class="text-center mt-3 pt-3 border-top">
            <a asp-action="Edit" asp-route-id="@Model.MaTaiKhoan" class="btn btn-primary btn-sm me-2">Chỉnh sửa</a>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Quay lại danh sách</a>
        </div>
    </div>
</div>
