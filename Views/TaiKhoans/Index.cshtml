@*
    Họ và tên: Trần Xuân Hải
    Mã sinh viên: 23103100135
    Phụ trách Module 1: Tài khoản, Đăng nhập, Phân quyền, Loại hàng & Đơn vị tính
*@
@model IEnumerable<QuanLyKhoHang_UNETI01_TI17A3HN.Models.TaiKhoan>

@{
    ViewData["Title"] = "Quản trị Tài khoản người dùng";
}

<div class="page-header">
    <div>
        <h2 class="page-title"><i class="bi bi-people-fill text-primary"></i> Quản Trị Tài Khoản</h2>
        <p class="page-subtitle">Danh sách người dùng và phân quyền truy cập hệ thống cửa hàng</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-person-plus-fill"></i> Thêm tài khoản mới
        </a>
    </div>
</div>

@Html.AntiForgeryToken()

<div class="card border-0 shadow-sm rounded-2">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <span class="fw-semibold text-secondary">
            <i class="bi bi-list-ul me-1"></i> Tổng cộng: <strong>@(Model?.Count() ?? 0)</strong> tài khoản
        </span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">Tên đăng nhập</th>
                        <th>Họ và tên</th>
                        <th>Email liên hệ</th>
                        <th>Vai trò hệ thống</th>
                        <th>Trạng thái</th>
                        <th class="text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi bi-person-fill text-secondary fs-5"></i>
                                        <div>
                                            <span class="fw-bold d-block text-dark">@item.TenDangNhap</span>
                                            <small class="text-muted font-monospace">ID: #@item.MaTaiKhoan</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="fw-semibold">@item.HoTen</span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.Email))
                                    {
                                        <a href="mailto:@item.Email" class="text-decoration-none text-muted small d-inline-flex align-items-center gap-1">
                                            <i class="bi bi-envelope"></i> @item.Email
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">---</span>
                                    }
                                </td>
                                <td>
                                    @if (item.VaiTro == "Admin")
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                            <i class="bi bi-shield-shaded me-1"></i> Quản trị viên (Admin)
                                        </span>
                                    }
                                    else if (item.VaiTro == "NhanVienKho")
                                    {
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                            <i class="bi bi-person-badge me-1"></i> Nhân viên kho
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">
                                            @item.VaiTro
                                        </span>
                                    }
                                </td>
                                <td>
                                    <div class="form-check form-switch d-flex align-items-center gap-2">
                                        <input class="form-check-input switch-trangthai" type="checkbox" role="switch"
                                               id="switch_@item.MaTaiKhoan"
                                               data-id="@item.MaTaiKhoan"
                                               data-username="@item.TenDangNhap"
                                               @(item.TrangThai ? "checked" : "") />
                                        <label class="form-check-label small" for="switch_@item.MaTaiKhoan" id="label_status_@item.MaTaiKhoan">
                                            @(item.TrangThai ? "Hoạt động" : "Bị khóa")
                                        </label>
                                    </div>
                                </td>
                                <td class="text-end pe-4 text-nowrap">
                                    <div class="d-inline-flex gap-1" role="group">
                                        <button type="button" class="btn btn-outline-warning btn-sm text-nowrap btn-reset-password"
                                                data-id="@item.MaTaiKhoan"
                                                data-username="@item.TenDangNhap"
                                                title="Đặt lại mật khẩu mặc định (123456@@)">
                                            <i class="bi bi-key me-1"></i> Reset MK
                                        </button>
                                        <a asp-action="Edit" asp-route-id="@item.MaTaiKhoan" class="btn btn-outline-primary btn-sm text-nowrap" title="Chỉnh sửa tài khoản">
                                            <i class="bi bi-pencil-square me-1"></i> Sửa
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.MaTaiKhoan" class="btn btn-outline-info btn-sm text-nowrap" title="Xem chi tiết tài khoản">
                                            <i class="bi bi-eye me-1"></i> Chi tiết
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.MaTaiKhoan" class="btn btn-outline-danger btn-sm text-nowrap" title="Xóa tài khoản">
                                            <i class="bi bi-trash me-1"></i> Xóa
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">Không có dữ liệu tài khoản nào.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            function getAntiForgeryToken() {
                return $('input[name="__RequestVerificationToken"]').val() || '';
            }

            // 1. Nút "Đặt lại mật khẩu mặc định" nhanh cho Admin (ResetPasswordQuick)
            $(document).on('click', '.btn-reset-password', function (e) {
                e.preventDefault();
                var btn = $(this);
                var userId = btn.data('id');
                var username = btn.data('username');

                if (!confirm('Bạn có chắc chắn muốn đặt lại mật khẩu cho tài khoản "' + username + '" về mặc định (123456@@)?')) {
                    return;
                }

                $.ajax({
                    url: '@Url.Action("ResetPasswordQuick", "TaiKhoans")',
                    type: 'POST',
                    data: {
                        id: userId,
                        __RequestVerificationToken: getAntiForgeryToken()
                    },
                    headers: {
                        'RequestVerificationToken': getAntiForgeryToken()
                    },
                    success: function (res) {
                        if (res && res.success) {
                            alert(res.message || 'Đặt lại mật khẩu thành công!');
                        } else {
                            alert((res && res.message) ? res.message : 'Không thể đặt lại mật khẩu.');
                        }
                    },
                    error: function () {
                        alert('Đã xảy ra lỗi máy chủ khi thực hiện yêu cầu.');
                    }
                });
            });

            // 2. Bật/Tắt trạng thái tài khoản (Khóa/Mở) bằng Bootstrap Switch AJAX (DoiTrangThai)
            $(document).on('change', '.switch-trangthai', function () {
                var toggle = $(this);
                var userId = toggle.data('id');
                var isChecked = toggle.is(':checked');
                var label = $('#label_status_' + userId);

                toggle.prop('disabled', true);

                $.ajax({
                    url: '@Url.Action("DoiTrangThai", "TaiKhoans")',
                    type: 'POST',
                    data: {
                        id: userId,
                        __RequestVerificationToken: getAntiForgeryToken()
                    },
                    headers: {
                        'RequestVerificationToken': getAntiForgeryToken()
                    },
                    success: function (res) {
                        toggle.prop('disabled', false);
                        if (res && res.success) {
                            label.text(res.trangThai ? 'Hoạt động' : 'Bị khóa');
                            toggle.prop('checked', res.trangThai);
                        } else {
                            toggle.prop('checked', !isChecked);
                            alert((res && res.message) ? res.message : 'Không thể thay đổi trạng thái.');
                        }
                    },
                    error: function () {
                        toggle.prop('disabled', false);
                        toggle.prop('checked', !isChecked);
                        alert('Đã xảy ra lỗi máy chủ khi cập nhật trạng thái.');
                    }
                });
            });
        });
    </script>
}
