@*
    Họ và tên: Trần Xuân Hải
    Mã sinh viên: 23103100135
    Phụ trách Module 1: Tài khoản, Đăng nhập, Phân quyền, Loại hàng & Đơn vị tính
*@
@model QuanLyKhoHang_UNETI01_TI17A3HN.Models.TaiKhoan

@{
    ViewData["Title"] = "Xác nhận xóa tài khoản";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card border-danger shadow-sm rounded-2 overflow-hidden">
            <div class="card-header bg-danger text-white p-3 d-flex align-items-center gap-2">
                <i class="bi bi-exclamation-triangle-fill fs-4"></i>
                <h5 class="mb-0 fw-bold">Xác Nhận Xóa Tài Khoản</h5>
            </div>
            <div class="card-body p-4">
                <p class="text-danger fw-semibold">
                    Cảnh báo: Bạn có chắc chắn muốn xóa tài khoản này khỏi hệ thống không? Hành động này không thể hoàn tác.
                </p>

                <div class="bg-light p-3 rounded-2 border mb-4">
                    <div class="row gy-2">
                        <div class="col-sm-4 text-muted">Tên đăng nhập:</div>
                        <div class="col-sm-8 fw-bold">@Model.TenDangNhap</div>
                        <div class="col-sm-4 text-muted">Họ và tên:</div>
                        <div class="col-sm-8">@Model.HoTen</div>
                        <div class="col-sm-4 text-muted">Vai trò:</div>
                        <div class="col-sm-8"><span class="badge bg-secondary">@Model.VaiTro</span></div>
                    </div>
                </div>

                <form asp-action="Delete" method="post" class="d-flex justify-content-end gap-2">
                    <input type="hidden" asp-for="MaTaiKhoan" />
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-x-circle"></i> Hủy bỏ
                    </a>
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash-fill"></i> Xác nhận xóa
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
