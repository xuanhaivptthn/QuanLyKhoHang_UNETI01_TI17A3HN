@*
    Họ và tên: Trần Xuân Hải
    Mã sinh viên: 23103100135
    Phụ trách Module 1: Tài khoản, Đăng nhập, Phân quyền & Quản lý hồ sơ
*@
@model QuanLyKhoHang_UNETI01_TI17A3HN.Models.TaiKhoan

@{
    ViewData["Title"] = "Xóa Tài khoản";
}

<div class="container mt-4">
    <div class="card col-md-6 mx-auto p-4 shadow-sm border border-danger">
        <h4 class="card-title text-center text-danger mb-2">Xác nhận Xóa Tài khoản</h4>
        <p class="text-center text-muted small mb-3">Bạn có chắc chắn muốn xóa vĩnh viễn tài khoản này không?</p>
        <hr class="mt-0 mb-3" />

        <dl class="row mb-0">
            <dt class="col-sm-4 text-muted">Mã tài khoản:</dt>
            <dd class="col-sm-8 fw-semibold">#@Model.MaTaiKhoan</dd>

            <dt class="col-sm-4 text-muted">Tên đăng nhập:</dt>
            <dd class="col-sm-8 fw-bold">@Model.TenDangNhap</dd>

            <dt class="col-sm-4 text-muted">Họ và tên:</dt>
            <dd class="col-sm-8">@Model.HoTen</dd>

            <dt class="col-sm-4 text-muted">Email:</dt>
            <dd class="col-sm-8">@Model.Email</dd>

            <dt class="col-sm-4 text-muted">Vai trò:</dt>
            <dd class="col-sm-8"><span class="badge bg-secondary">@Model.VaiTro</span></dd>

            <dt class="col-sm-4 text-muted">Trạng thái:</dt>
            <dd class="col-sm-8">@(Model.TrangThai ? "Đang hoạt động" : "Bị khóa")</dd>
        </dl>

        <form asp-action="Delete" method="post" class="text-center mt-4 pt-3 border-top">
            <input type="hidden" asp-for="MaTaiKhoan" />
            <button type="submit" class="btn btn-danger btn-sm me-2">Xác nhận xóa</button>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Hủy bỏ</a>
        </form>
    </div>
</div>
