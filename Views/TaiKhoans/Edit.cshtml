@*
    Họ và tên: Trần Xuân Hải
    Mã sinh viên: 23103100135
    Phụ trách Module 1: Tài khoản, Đăng nhập, Phân quyền, Loại hàng & Đơn vị tính
*@
@model QuanLyKhoHang_UNETI01_TI17A3HN.Models.TaiKhoan

@{
    ViewData["Title"] = "Chỉnh sửa tài khoản";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="page-header">
            <div>
                <h2 class="page-title"><i class="bi bi-pencil-square text-primary"></i> Chỉnh Sửa Tài Khoản</h2>
                <p class="page-subtitle">Cập nhật thông tin tài khoản: <strong>@Model.TenDangNhap</strong></p>
            </div>
            <div>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Quay lại danh sách
                </a>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4 py-2" role="alert"></div>
                    <input type="hidden" asp-for="MaTaiKhoan" />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="TenDangNhap" class="form-label fw-semibold">
                                <i class="bi bi-person me-1 text-primary"></i> Tên đăng nhập
                            </label>
                            <input asp-for="TenDangNhap" class="form-control" />
                            <span asp-validation-for="TenDangNhap" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="MatKhau" class="form-label fw-semibold">
                                <i class="bi bi-key me-1 text-primary"></i> Mật khẩu
                            </label>
                            <input asp-for="MatKhau" class="form-control" />
                            <span asp-validation-for="MatKhau" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="HoTen" class="form-label fw-semibold">
                                <i class="bi bi-card-text me-1 text-primary"></i> Họ và tên
                            </label>
                            <input asp-for="HoTen" class="form-control" />
                            <span asp-validation-for="HoTen" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold">
                                <i class="bi bi-envelope me-1 text-primary"></i> Email liên hệ
                            </label>
                            <input asp-for="Email" type="email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="VaiTro" class="form-label fw-semibold">
                                <i class="bi bi-shield-check me-1 text-primary"></i> Vai trò hệ thống
                            </label>
                            <select asp-for="VaiTro" class="form-select">
                                <option value="NhanVienKho">Nhân viên kho (NhanVienKho)</option>
                                <option value="Admin">Quản trị viên (Admin)</option>
                                <option value="BoPhanNhan">Bộ phận nhận hàng (BoPhanNhan)</option>
                            </select>
                            <span asp-validation-for="VaiTro" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 d-flex align-items-center">
                            <div class="form-check form-switch mt-4">
                                <input class="form-check-input" type="checkbox" role="switch" asp-for="TrangThai" id="chkEditTrangThai" />
                                <label class="form-check-label fw-semibold" for="chkEditTrangThai">
                                    Trạng thái hoạt động
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary">Hủy bỏ</a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-check-circle-fill"></i> Cập nhật thay đổi
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
