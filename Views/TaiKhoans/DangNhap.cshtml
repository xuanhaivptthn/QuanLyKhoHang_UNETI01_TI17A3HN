@*
    Họ và tên: Trần Xuân Hải
    Mã sinh viên: 23103100135
    Phụ trách Module 1: Tài khoản, Đăng nhập, Phân quyền, Loại hàng & Đơn vị tính
*@
@model QuanLyKhoHang_UNETI01_TI17A3HN.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Đăng nhập hệ thống";
}

<div class="row justify-content-center align-items-center my-4" style="min-height: 72vh;">
    <div class="col-11 col-sm-9 col-md-7 col-lg-5 col-xl-4">
        <div class="card shadow-lg border-0 overflow-hidden">
            <!-- Header Brand Card -->
            <div class="p-4 text-center text-white" style="background-color: #1e3a8a;">
                <div class="mb-2">
                    <i class="bi bi-box-seam-fill text-white fs-1"></i>
                </div>
                <h4 class="fw-bold mb-1">Hệ Thống Quản Lý Kho</h4>
                <p class="small text-white-50 mb-0">Đăng nhập tài khoản để truy cập hệ thống</p>
            </div>

            <!-- Body Card Form -->
            <div class="card-body p-4 p-sm-5 bg-white">
                @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Count > 0))
                {
                    <div class="alert alert-danger d-flex align-items-center gap-2 mb-4 py-2" role="alert">
                        <i class="bi bi-exclamation-triangle-fill fs-5 flex-shrink-0"></i>
                        <div asp-validation-summary="ModelOnly" class="small mb-0"></div>
                    </div>
                }

                <form asp-action="DangNhap" asp-route-returnUrl="@ViewBag.ReturnUrl" method="post" id="loginForm">
                    <!-- Tên đăng nhập -->
                    <div class="mb-3">
                        <label asp-for="TenDangNhap" class="form-label fw-semibold text-secondary small">
                            <i class="bi bi-person-fill text-primary me-1"></i> Tên đăng nhập
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted">
                                <i class="bi bi-person"></i>
                            </span>
                            <input asp-for="TenDangNhap" class="form-control border-start-0 ps-0" placeholder="Nhập tên đăng nhập..." autofocus autocomplete="username" />
                        </div>
                        <span asp-validation-for="TenDangNhap" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Mật khẩu -->
                    <div class="mb-4">
                        <label asp-for="MatKhau" class="form-label fw-semibold text-secondary small">
                            <i class="bi bi-shield-lock-fill text-primary me-1"></i> Mật khẩu
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted">
                                <i class="bi bi-key"></i>
                            </span>
                            <input asp-for="MatKhau" type="password" id="txtPassword" class="form-control border-start-0 border-end-0 px-0" placeholder="Nhập mật khẩu..." autocomplete="current-password" />
                            <button class="btn btn-outline-secondary border-start-0 bg-light text-muted px-2" type="button" id="btnTogglePassword" title="Hiện hoặc ẩn mật khẩu" aria-label="Hiện hoặc ẩn mật khẩu">
                                <i class="bi bi-eye me-1" id="toggleIcon"></i><span id="toggleText" class="small">Hiện</span>
                            </button>
                        </div>
                        <span asp-validation-for="MatKhau" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Nút Đăng nhập -->
                    <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold rounded-2 shadow-sm d-flex justify-content-center align-items-center gap-2">
                        <i class="bi bi-box-arrow-in-right fs-5"></i>
                        <span>Đăng nhập hệ thống</span>
                    </button>
                </form>

                <div class="text-center mt-4 pt-2 border-top">
                    <a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted small d-inline-flex align-items-center gap-1">
                        <i class="bi bi-arrow-left"></i> Quay lại trang chủ
                    </a>
                </div>
            </div>

            <!-- Footer Card Hint -->
            <div class="card-footer bg-light px-4 py-3 text-center border-top-0">
                <div class="accordion accordion-flush" id="accHint">
                    <div class="accordion-item bg-transparent border-0">
                        <h2 class="accordion-header" id="headingHint">
                            <button class="accordion-button collapsed bg-transparent p-0 shadow-none text-muted small justify-content-center" type="button" data-bs-toggle="collapse" data-bs-target="#collapseHint" aria-expanded="false" aria-controls="collapseHint">
                                <i class="bi bi-info-circle me-1 text-primary"></i> Gợi ý tài khoản demo kiểm thử
                            </button>
                        </h2>
                        <div id="collapseHint" class="accordion-collapse collapse" aria-labelledby="headingHint" data-bs-parent="#accHint">
                            <div class="accordion-body p-2 pt-3 small text-start">
                                <div class="p-2 rounded bg-white border">
                                    <div class="fw-semibold text-danger mb-1"><i class="bi bi-person-badge"></i> Quản trị viên (Admin):</div>
                                    <div class="font-monospace text-muted mb-2">admin / 123456</div>
                                    <div class="fw-semibold text-primary mb-1"><i class="bi bi-person"></i> Nhân viên kho (NhanVienKho):</div>
                                    <div class="font-monospace text-muted">nhanvienkho / 123456</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const btnToggle = document.getElementById("btnTogglePassword");
            const txtPassword = document.getElementById("txtPassword");
            const toggleIcon = document.getElementById("toggleIcon");
            const toggleText = document.getElementById("toggleText");

            if (btnToggle && txtPassword && toggleIcon) {
                btnToggle.addEventListener("click", function () {
                    const isPassword = txtPassword.type === "password";
                    txtPassword.type = isPassword ? "text" : "password";
                    toggleIcon.className = isPassword ? "bi bi-eye-slash me-1" : "bi bi-eye me-1";
                    if (toggleText) toggleText.textContent = isPassword ? "Ẩn" : "Hiện";
                });
            }
        });
    </script>
}
