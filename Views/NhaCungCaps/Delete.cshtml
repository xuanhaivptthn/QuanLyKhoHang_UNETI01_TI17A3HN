@*
    Họ và tên: Lê Văn Hùng
    Mã sinh viên: 23103100177
    Phụ trách Module 3: Nhà cung cấp, Phiếu nhập, Chi tiết phiếu nhập
*@
@model QuanLyKhoHang_UNETI01_TI17A3HN.Models.NhaCungCap

@{
    ViewData["Title"] = "Xác nhận xóa nhà cung cấp";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card border-danger shadow-sm rounded-4 overflow-hidden">
            <div class="card-header bg-danger text-white p-3 d-flex align-items-center gap-2">
                <i class="bi bi-exclamation-triangle-fill fs-4"></i>
                <h5 class="mb-0 fw-bold">Xác Nhận Xóa Nhà Cung Cấp</h5>
            </div>
            <div class="card-body p-4">
                <p class="text-danger fw-semibold">
                    Bạn có chắc chắn muốn xóa nhà cung cấp này không? Lưu ý: Nếu đối tác đã phát sinh phiếu nhập hàng, việc xóa có thể bị hệ thống chặn lại để bảo tồn chứng từ kế toán.
                </p>

                <div class="bg-light p-3 rounded-3 border mb-4">
                    <dl class="row gy-2 mb-0">
                        <dt class="col-sm-4 text-muted">Mã NCC:</dt>
                        <dd class="col-sm-8 font-monospace fw-bold">#@Model.MaNhaCungCap</dd>

                        <dt class="col-sm-4 text-muted">Tên công ty:</dt>
                        <dd class="col-sm-8 fw-bold">@Model.TenNhaCungCap</dd>

                        <dt class="col-sm-4 text-muted">Điện thoại:</dt>
                        <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.SoDienThoai) ? "---" : Model.SoDienThoai)</dd>

                        <dt class="col-sm-4 text-muted">Địa chỉ:</dt>
                        <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.DiaChi) ? "---" : Model.DiaChi)</dd>
                    </dl>
                </div>

                <form asp-action="Delete" method="post" class="d-flex justify-content-end gap-2">
                    <input type="hidden" asp-for="MaNhaCungCap" />
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-x-circle"></i> Hủy bỏ
                    </a>
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash-fill"></i> Xác nhận xóa
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
