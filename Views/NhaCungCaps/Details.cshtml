@*
    Họ và tên: Lê Văn Hùng
    Mã sinh viên: 23103100177
    Phụ trách Module 3: Nhà cung cấp, Phiếu nhập, Chi tiết phiếu nhập
*@
@model QuanLyKhoHang_UNETI01_TI17A3HN.Models.NhaCungCap

@{
    ViewData["Title"] = "Chi tiết nhà cung cấp - " + Model.TenNhaCungCap;
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="page-header">
            <div>
                <h2 class="page-title"><i class="bi bi-truck text-primary"></i> Chi Tiết Nhà Cung Cấp</h2>
                <p class="page-subtitle">Hồ sơ đối tác cung ứng và thông tin liên lạc</p>
            </div>
            <div>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Quay lại danh sách
                </a>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4">
                <div class="mb-3">
                    <span class="badge bg-light text-primary border font-monospace px-2 py-1">Mã NCC: #@Model.MaNhaCungCap</span>
                    <h4 class="fw-bold text-dark mt-2 mb-1">@Model.TenNhaCungCap</h4>
                </div>
                <hr class="text-secondary opacity-25" />
                <dl class="row gy-3 mb-0">
                    <dt class="col-sm-4 text-muted">Số điện thoại:</dt>
                    <dd class="col-sm-8"><i class="bi bi-telephone text-success me-1"></i>@(string.IsNullOrEmpty(Model.SoDienThoai) ? "Chưa cập nhật" : Model.SoDienThoai)</dd>

                    <dt class="col-sm-4 text-muted">Email liên hệ:</dt>
                    <dd class="col-sm-8"><i class="bi bi-envelope text-primary me-1"></i>@(string.IsNullOrEmpty(Model.Email) ? "Chưa cập nhật" : Model.Email)</dd>

                    <dt class="col-sm-4 text-muted">Địa chỉ:</dt>
                    <dd class="col-sm-8"><i class="bi bi-geo-alt text-danger me-1"></i>@(string.IsNullOrEmpty(Model.DiaChi) ? "Chưa cập nhật" : Model.DiaChi)</dd>

                    <dt class="col-sm-4 text-muted">Trạng thái:</dt>
                    <dd class="col-sm-8">
                        @if (Model.TrangThai)
                        {
                            <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i> Đang hợp tác</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary"><i class="bi bi-pause-circle me-1"></i> Ngừng hợp tác</span>
                        }
                    </dd>
                </dl>
            </div>
            <div class="card-footer bg-light p-3 d-flex justify-content-end gap-2">
                <a asp-action="Edit" asp-route-id="@Model.MaNhaCungCap" class="btn btn-primary">
                    <i class="bi bi-pencil-square"></i> Chỉnh sửa
                </a>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    Quay lại
                </a>
            </div>
        </div>
    </div>
</div>
