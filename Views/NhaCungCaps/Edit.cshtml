@*
    Họ và tên: Lê Văn Hùng
    Mã sinh viên: 23103100177
    Phụ trách Module 3: Nhà cung cấp, Phiếu nhập, Chi tiết phiếu nhập
*@
@model QuanLyKhoHang_UNETI01_TI17A3HN.Models.NhaCungCap

@{
    ViewData["Title"] = "Chỉnh sửa nhà cung cấp - " + Model.TenNhaCungCap;
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="page-header">
            <div>
                <h2 class="page-title"><i class="bi bi-pencil-square text-primary"></i> Chỉnh Sửa Nhà Cung Cấp</h2>
                <p class="page-subtitle">Cập nhật mã đối tác #@Model.MaNhaCungCap: <strong>@Model.TenNhaCungCap</strong></p>
            </div>
            <div>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Quay lại danh sách
                </a>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-2">
            <div class="card-body p-4 p-md-5">
                <form asp-action="Edit" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4 py-2" role="alert"></div>
                    <input type="hidden" asp-for="MaNhaCungCap" />

                    <div class="row g-3">
                        <div class="col-md-12">
                            <label asp-for="TenNhaCungCap" class="form-label fw-semibold">
                                <i class="bi bi-building me-1 text-primary"></i> Tên công ty / Nhà cung cấp <span class="text-danger">*</span>
                            </label>
                            <input asp-for="TenNhaCungCap" class="form-control" />
                            <span asp-validation-for="TenNhaCungCap" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="SoDienThoai" class="form-label fw-semibold">
                                <i class="bi bi-telephone me-1 text-success"></i> Số điện thoại
                            </label>
                            <input asp-for="SoDienThoai" class="form-control" />
                            <span asp-validation-for="SoDienThoai" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold">
                                <i class="bi bi-envelope me-1 text-primary"></i> Email liên hệ
                            </label>
                            <input asp-for="Email" type="email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-md-12">
                            <label asp-for="DiaChi" class="form-label fw-semibold">
                                <i class="bi bi-geo-alt me-1 text-danger"></i> Địa chỉ trụ sở / kho hàng
                            </label>
                            <input asp-for="DiaChi" class="form-control" />
                            <span asp-validation-for="DiaChi" class="text-danger small"></span>
                        </div>

                        <div class="col-md-12">
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" role="switch" asp-for="TrangThai" id="chkEditTrangThaiNCC" />
                                <label class="form-check-label fw-semibold" for="chkEditTrangThaiNCC">
                                    Đang hợp tác
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary">Hủy bỏ</a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-check-circle-fill"></i> Cập nhật thay đổi
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
