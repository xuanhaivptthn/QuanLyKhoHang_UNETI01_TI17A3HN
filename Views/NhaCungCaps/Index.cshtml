@model IEnumerable<QuanLyKhoHang_UNETI01_TI17A3HN.Models.NhaCungCap>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Thêm mới nhà cung cấp</a>
</p>

<form asp-action="Index" method="get" class="mb-3">
    <div class="row g-2">
        <div class="col-md-5">
            <input type="text" name="searchString" value="@ViewBag.SearchString" class="form-control" placeholder="Tìm theo tên, SĐT, Email..." />
        </div>
        <div class="col-md-3">
            <select name="trangThai" class="form-select">
                <option value="">-- Tất cả trạng thái --</option>
                <option value="true" selected="@(ViewBag.TrangThai == true)">Hoạt động</option>
                <option value="false" selected="@(ViewBag.TrangThai == false)">Ngừng hoạt động</option>
            </select>
        </div>
        <div class="col-md-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Lọc</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Tất cả</a>
        </div>
    </div>
</form>
<div class="table-responsive">
    <table class="table table-hover">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(model => model.TenNhaCungCap)</th>
                <th class="text-nowrap">@Html.DisplayNameFor(model => model.SoDienThoai)</th>
                <th>@Html.DisplayNameFor(model => model.Email)</th>
                <th>@Html.DisplayNameFor(model => model.DiaChi)</th>
                <th class="text-nowrap">@Html.DisplayNameFor(model => model.TrangThai)</th>
                <th class="text-nowrap"></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model) {
            <tr>
                <td class="align-middle">@Html.DisplayFor(modelItem => item.TenNhaCungCap)</td>
                <td class="align-middle text-nowrap">@Html.DisplayFor(modelItem => item.SoDienThoai)</td>
                <td class="align-middle">@Html.DisplayFor(modelItem => item.Email)</td>
                <td class="align-middle">@Html.DisplayFor(modelItem => item.DiaChi)</td>
                <td class="align-middle text-nowrap">@(item.TrangThai ? "Đang hoạt động" : "Ngừng hoạt động")</td>
                <td class="align-middle text-nowrap">
                    <a asp-action="Edit" asp-route-id="@item.MaNhaCungCap">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.MaNhaCungCap">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.MaNhaCungCap">Delete</a>
                </td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr>
                <td colspan="6" class="text-center text-muted">Chưa có nhà cung cấp nào.</td>
            </tr>
        }
        </tbody>
    </table>
</div>

@{
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 0;

    Func<int, Dictionary<string, string?>> routeFor = page => new Dictionary<string, string?>
    {
        ["searchString"] = ViewBag.SearchString,
        ["trangThai"] = ViewBag.TrangThai?.ToString().ToLower(),
        ["page"] = page.ToString()
    };
}

@if (totalPages > 1)
{
    <nav aria-label="Phân trang nhà cung cấp">
        <ul class="pagination">
            <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-all-route-data="routeFor(currentPage - 1)" aria-label="Trang trước">Trước</a>
            </li>
            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == currentPage ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-all-route-data="routeFor(i)" aria-current="@(i == currentPage ? "page" : null)">@i</a>
                </li>
            }
            <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-all-route-data="routeFor(currentPage + 1)" aria-label="Trang sau">Sau</a>
            </li>
        </ul>
    </nav>
    <p class="text-muted">Trang @currentPage / @totalPages (tổng @ViewBag.TotalItems nhà cung cấp)</p>
}
