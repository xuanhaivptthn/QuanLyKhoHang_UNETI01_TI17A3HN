@model IEnumerable<QuanLyKhoHang_UNETI01_TI17A3HN.Models.NhaCungCap>

@{
    ViewData["Title"] = "Index";
}

<h1>Nhà Cung Cấp</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>

<form asp-action="Index" method="get">
    <p>
        Tìm kiếm: <input type="text" name="searchString" value="@ViewBag.SearchString" />
        
        Trạng thái: 
        <select name="trangThai">
            <option value="">-- Tất cả --</option>
            @if (ViewBag.TrangThai == true)
            {
                <option value="true" selected>Hoạt động</option>
                <option value="false">Ngừng hoạt động</option>
            }
            else if (ViewBag.TrangThai == false)
            {
                <option value="true">Hoạt động</option>
                <option value="false" selected>Ngừng hoạt động</option>
            }
            else
            {
                <option value="true">Hoạt động</option>
                <option value="false">Ngừng hoạt động</option>
            }
        </select>
        
        <input type="submit" value="Lọc & Tìm kiếm" />
    </p>
</form>
<table class="table">
    <thead>
        <tr>
            <th>
                Mã nhà cung cấp 
            </th>
            <th>
                Tên nhà cung cấp
            </th>
            <th>
                Số điện thoại
            </th>
            <th>
                Email
            </th>
            <th>
                Địa chỉ
            </th>
            <th>
                Trạng thái
            </th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model=>item.MaNhaCungCap)
            </td>
            <td>
                @Html.DisplayFor(model => item.TenNhaCungCap)
            </td>
            <td>
                @Html.DisplayFor(model => item.SoDienThoai)
            </td>
            <td>
                @Html.DisplayFor(model => item.Email)
            </td>
            <td>
                @Html.DisplayFor(model => item.DiaChi)
            </td>
            <td>
                @Html.DisplayFor(model => item.TrangThai)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.MaNhaCungCap">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.MaNhaCungCap">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.MaNhaCungCap">Delete</a> |
                <form asp-action="DoiTrangThai" asp-route-id="@item.MaNhaCungCap" method="post" style="display:inline;" onsubmit="return confirm('Bạn có muốn thay đổi trạng thái hoạt động của nhà cung cấp này?');">
                    <input type="submit" value="Đổi trạng thái" style="background:none; border:none; color:blue; text-decoration:underline; cursor:pointer;" />
                </form>
            </td>
        </tr>
}
    </tbody>
</table>
