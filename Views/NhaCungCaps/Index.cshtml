@model IEnumerable<QuanLyKhoHang_UNETI01_TI17A3HN.Models.NhaCungCap>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Thêm mới nhà cung cấp</a>
</p>

<form asp-action="Index" method="get" class="mb-3">
    <div class="row g-2">
        <div class="col-md-5">
            <input type="text" name="searchString" value="@ViewBag.SearchString" class="form-control" placeholder="Tìm theo tên, SĐT, Email..." />
        </div>
        <div class="col-md-3">
            <select name="trangThai" class="form-select">
                <option value="">-- Tất cả trạng thái --</option>
                <option value="true" selected="@(ViewBag.TrangThai == true)">Hoạt động</option>
                <option value="false" selected="@(ViewBag.TrangThai == false)">Ngừng hoạt động</option>
            </select>
        </div>
        <div class="col-md-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Lọc</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Tất cả</a>
        </div>
    </div>
</form>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.TenNhaCungCap)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SoDienThoai)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DiaChi)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TrangThai)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.TenNhaCungCap)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.SoDienThoai)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Email)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DiaChi)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TrangThai)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.MaNhaCungCap">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.MaNhaCungCap">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.MaNhaCungCap">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
