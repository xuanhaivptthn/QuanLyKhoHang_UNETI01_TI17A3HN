@*
    Họ và tên: Nguyễn Việt Dũng
    Mã sinh viên: 23103100127
    Phụ trách Module 4: Bộ phận nhận, Phiếu xuất, Chi tiết phiếu xuất
*@
@model QuanLyKhoHang_UNETI01_TI17A3HN.Models.ChiTietPhieuXuat

@{
    ViewData["Title"] = "Thêm hàng vào phiếu xuất";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="page-header">
            <div>
                <h2 class="page-title"><i class="bi bi-cart-dash text-danger"></i> Thêm Hàng Vào Phiếu Xuất</h2>
                <p class="page-subtitle">Chọn mặt hàng và số lượng xuất thực tế giao cho đơn vị tiếp nhận</p>
            </div>
            <div>
                <a asp-controller="PhieuXuats" asp-action="Details" asp-route-id="@Model?.MaPhieuXuat" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Quay lại phiếu xuất
                </a>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4 p-md-5">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4 py-2" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="MaPhieuXuat" class="form-label fw-semibold">
                            <i class="bi bi-receipt-cutoff me-1 text-primary"></i> Phiếu xuất kho <span class="text-danger">*</span>
                        </label>
                        <select asp-for="MaPhieuXuat" class="form-select" asp-items="ViewBag.MaPhieuXuat"></select>
                        <span asp-validation-for="MaPhieuXuat" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="MaHang" class="form-label fw-semibold">
                            <i class="bi bi-box-seam me-1 text-primary"></i> Chọn mặt hàng xuất <span class="text-danger">*</span>
                        </label>
                        <select asp-for="MaHang" class="form-select" asp-items="ViewBag.MaHang">
                            <option value="">-- Chọn sản phẩm --</option>
                        </select>
                        <span asp-validation-for="MaHang" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="SoLuongXuat" class="form-label fw-semibold">
                                <i class="bi bi-123 me-1 text-danger"></i> Số lượng xuất <span class="text-danger">*</span>
                            </label>
                            <input asp-for="SoLuongXuat" type="number" min="1" class="form-control" placeholder="1" id="txtSoLuongXuat" />
                            <span asp-validation-for="SoLuongXuat" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="DonGiaXuatThamChieu" class="form-label fw-semibold">
                                <i class="bi bi-currency-dollar me-1 text-primary"></i> Đơn giá xuất tham chiếu (VNĐ) <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <input asp-for="DonGiaXuatThamChieu" type="number" min="0" step="any" class="form-control" placeholder="0" />
                                <span class="input-group-text bg-light text-muted">VNĐ</span>
                            </div>
                            <span asp-validation-for="DonGiaXuatThamChieu" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="GhiChu" class="form-label fw-semibold">
                            <i class="bi bi-card-text me-1 text-primary"></i> Ghi chú dòng xuất
                        </label>
                        <input asp-for="GhiChu" class="form-control" placeholder="Quy cách, số seri máy hoặc lô xuất..." />
                        <span asp-validation-for="GhiChu" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                        <a asp-controller="PhieuXuats" asp-action="Details" asp-route-id="@Model?.MaPhieuXuat" class="btn btn-outline-secondary">Hủy bỏ</a>
                        <button type="submit" class="btn btn-danger px-4">
                            <i class="bi bi-check-circle-fill"></i> Thêm vào phiếu xuất
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
