@model IEnumerable<QuanLyKhoHang_UNETI01_TI17A3HN.Models.ChiTietPhieuXuat>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

<p>
    <a asp-action="Create" asp-route-maPhieuXuat="@ViewData["MaPhieuXuat"]">Thêm chi tiết xuất (chỉ phiếu Nháp)</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.SoLuongXuat)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DonGiaXuatThamChieu)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.GhiChu)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PhieuXuat)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HangHoa)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.SoLuongXuat)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DonGiaXuatThamChieu)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.GhiChu)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PhieuXuat.NguoiLap)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.HangHoa.TenHang)
            </td>
            <td>
                <a asp-action="Details" asp-route-id="@item.MaChiTietXuat">Details</a> |
                @if (item.PhieuXuat?.TrangThai == TrangThaiPhieuXuat.Nhap)
                {
                    <a asp-action="Edit" asp-route-id="@item.MaChiTietXuat">Edit</a>
                    <span> | </span>
                    <a asp-action="Delete" asp-route-id="@item.MaChiTietXuat">Delete</a>
                }
            </td>
        </tr>
}
    </tbody>
</table>
