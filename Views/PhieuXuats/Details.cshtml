@*
    Họ và tên: Nguyễn Việt Dũng
    Mã sinh viên: 23103100127
    Phụ trách Module 4: Bộ phận nhận, Phiếu xuất, Chi tiết phiếu xuất
*@
@model QuanLyKhoHang_UNETI01_TI17A3HN.Models.PhieuXuat

@{
    ViewData["Title"] = "Hóa đơn xuất kho #PX-" + Model.MaPhieuXuat;
    var chiTiets = Model.ChiTietPhieuXuats?.ToList() ?? new List<QuanLyKhoHang_UNETI01_TI17A3HN.Models.ChiTietPhieuXuat>();
    decimal tongTien = chiTiets.Sum(c => (decimal)c.SoLuongXuat * c.DonGiaXuatThamChieu);
}

<div class="page-header no-print">
    <div>
        <h2 class="page-title"><i class="bi bi-receipt-cutoff text-danger"></i> Hóa Đơn Xuất Kho</h2>
        <p class="page-subtitle">Biên bản bàn giao và điều chuyển hàng hóa ra khỏi kho</p>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-outline-secondary" onclick="window.print()">
            <i class="bi bi-printer"></i> In phiếu
        </button>
        @if (Model.TrangThai == TrangThaiPhieuXuat.Nhap || Model.TrangThai == TrangThaiPhieuXuat.ChoXacNhan)
        {
            <a asp-controller="ChiTietPhieuXuats" asp-action="Create" asp-route-maPhieuXuat="@Model.MaPhieuXuat" class="btn btn-success">
                <i class="bi bi-plus-circle"></i> Thêm hàng xuất
            </a>
            <a asp-action="Edit" asp-route-id="@Model.MaPhieuXuat" class="btn btn-primary">
                <i class="bi bi-pencil-square"></i> Sửa phiếu
            </a>
        }
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Quay lại
        </a>
    </div>
</div>

<!-- Khung Hóa Đơn Xuất Kho (Delivery Order Container) -->
<div class="invoice-container mb-4">
    <!-- Header Hóa Đơn -->
    <div class="row align-items-center pb-4 border-bottom mb-4">
        <div class="col-sm-7">
            <div class="d-flex align-items-center gap-3 mb-2">
                <i class="bi bi-box-seam-fill fs-2 text-primary"></i>
                <div>
                    <h4 class="fw-bold mb-0 text-dark">KHO HÀNG UNETI</h4>
                    <small class="text-muted">Biên bản xuất kho kiêm vận chuyển nội bộ</small>
                </div>
            </div>
            <p class="text-muted small mb-0">Địa chỉ: 218 Lĩnh Nam, Hoàng Mai, Hà Nội &bull; Hotline: 1900-1234</p>
        </div>
        <div class="col-sm-5 text-sm-end mt-3 mt-sm-0">
            <h3 class="fw-bold text-danger mb-1">PHIẾU XUẤT KHO</h3>
            <div class="font-monospace fw-bold text-dark fs-5">#PX-@Model.MaPhieuXuat.ToString("D5")</div>
            <div class="mt-2">
                @if (Model.TrangThai == TrangThaiPhieuXuat.Nhap)
                {
                    <span class="badge bg-secondary fs-6">Trạng thái: Nháp</span>
                }
                else if (Model.TrangThai == TrangThaiPhieuXuat.ChoXacNhan)
                {
                    <span class="badge bg-warning text-dark fs-6">Trạng thái: Chờ xác nhận</span>
                }
                else if (Model.TrangThai == TrangThaiPhieuXuat.DaHoanTat)
                {
                    <span class="badge bg-success fs-6"><i class="bi bi-check-circle-fill me-1"></i> Đã hoàn tất xuất kho</span>
                }
                else
                {
                    <span class="badge bg-danger fs-6">Trạng thái: Đã hủy</span>
                }
            </div>
        </div>
    </div>

    <!-- Thông tin Bên Giao & Bên Nhận -->
    <div class="row mb-4 g-4">
        <div class="col-md-6">
            <div class="p-3 bg-light rounded-2 h-100 border">
                <h6 class="fw-bold text-secondary text-uppercase small mb-2">
                    <i class="bi bi-building text-primary me-1"></i> Đơn vị xuất hàng
                </h6>
                <div class="fw-bold text-dark fs-6">@(Model.Kho?.TenKho ?? "Chưa rõ")</div>
                <div class="text-muted small mt-1">Địa điểm: @(Model.Kho?.DiaDiem ?? "---")</div>
                <div class="text-muted small">Người lập phiếu: <strong>@Model.NguoiLap</strong></div>
                <div class="text-muted small">Ngày lập: <strong>@Model.NgayXuat.ToString("dd/MM/yyyy HH:mm")</strong></div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="p-3 bg-light rounded-2 h-100 border">
                <h6 class="fw-bold text-secondary text-uppercase small mb-2">
                    <i class="bi bi-shop text-success me-1"></i> Đơn vị tiếp nhận hàng
                </h6>
                <div class="fw-bold text-dark fs-6">@(Model.BoPhanNhan?.TenBoPhan ?? "Chưa chỉ định")</div>
                <div class="text-muted small mt-1">Người đại diện: @(Model.BoPhanNhan?.NguoiDaiDien ?? "---")</div>
                <div class="text-muted small">Số điện thoại: @(Model.BoPhanNhan?.SoDienThoai ?? "---")</div>
                <div class="text-muted small">Ghi chú / Địa chỉ: @(Model.BoPhanNhan?.MoTa ?? "---")</div>
            </div>
        </div>
    </div>

    <!-- Bảng Chi Tiết Hàng Xuất -->
    <div class="table-responsive mb-4">
        <table class="table table-bordered align-middle">
            <thead class="table-light">
                <tr>
                    <th class="text-center" style="width: 50px;">STT</th>
                    <th>Mã hàng</th>
                    <th>Tên hàng hóa</th>
                    <th class="text-center">Số lượng xuất</th>
                    <th class="text-end">Đơn giá tham chiếu</th>
                    <th class="text-end">Thành tiền</th>
                    <th>Ghi chú</th>
                    @if (Model.TrangThai == TrangThaiPhieuXuat.Nhap || Model.TrangThai == TrangThaiPhieuXuat.ChoXacNhan)
                    {
                        <th class="text-center no-print" style="width: 100px;">Thao tác</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (chiTiets.Any())
                {
                    int stt = 1;
                    foreach (var ct in chiTiets)
                    {
                        var thanhTien = (decimal)ct.SoLuongXuat * ct.DonGiaXuatThamChieu;
                        <tr>
                            <td class="text-center">@(stt++)</td>
                            <td class="font-monospace text-muted">#@ct.MaHang</td>
                            <td class="fw-semibold text-dark">@(ct.HangHoa?.TenHang ?? "Sản phẩm #" + ct.MaHang)</td>
                            <td class="text-center font-monospace fw-bold text-danger">@ct.SoLuongXuat</td>
                            <td class="text-end">@ct.DonGiaXuatThamChieu.ToString("#,##0") VNĐ</td>
                            <td class="text-end fw-bold text-dark">@thanhTien.ToString("#,##0") VNĐ</td>
                            <td class="text-muted small">@(string.IsNullOrEmpty(ct.GhiChu) ? "---" : ct.GhiChu)</td>
                            @if (Model.TrangThai == TrangThaiPhieuXuat.Nhap || Model.TrangThai == TrangThaiPhieuXuat.ChoXacNhan)
                            {
                                <td class="text-center no-print text-nowrap">
                                    <div class="d-inline-flex gap-1">
                                        <a asp-controller="ChiTietPhieuXuats" asp-action="Edit" asp-route-id="@ct.MaChiTietXuat" class="btn btn-outline-primary btn-sm text-nowrap" title="Sửa dòng mặt hàng">
                                            <i class="bi bi-pencil me-1"></i> Sửa
                                        </a>
                                        <a asp-controller="ChiTietPhieuXuats" asp-action="Delete" asp-route-id="@ct.MaChiTietXuat" class="btn btn-outline-danger btn-sm text-nowrap" title="Xóa dòng mặt hàng">
                                            <i class="bi bi-trash me-1"></i> Xóa
                                        </a>
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="@(Model.TrangThai == TrangThaiPhieuXuat.Nhap || Model.TrangThai == TrangThaiPhieuXuat.ChoXacNhan ? 8 : 7)" class="text-center text-muted py-4">
                            Phiếu chưa có mặt hàng nào. Vui lòng bấm <strong>"Thêm hàng xuất"</strong> để bổ sung.
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="table-light">
                    <th colspan="5" class="text-end fw-bold fs-6">TỔNG TRỊ GIÁ XUẤT THAM CHIẾU:</th>
                    <th class="text-end fw-bold text-danger fs-5">@tongTien.ToString("#,##0") VNĐ</th>
                    <th colspan="@(Model.TrangThai == TrangThaiPhieuXuat.Nhap || Model.TrangThai == TrangThaiPhieuXuat.ChoXacNhan ? 2 : 1)" class="no-print"></th>
                </tr>
            </tfoot>
        </table>
    </div>

    <!-- Ghi chú & Chữ ký -->
    <div class="row pt-3">
        <div class="col-sm-6">
            <h6 class="fw-bold small text-muted">Ghi chú xuất kho:</h6>
            <p class="text-secondary small fst-italic">@(string.IsNullOrEmpty(Model.GhiChu) ? "Không có ghi chú thêm." : Model.GhiChu)</p>
        </div>
        <div class="col-sm-6">
            <div class="row text-center mt-4 pt-2">
                <div class="col-6">
                    <div class="fw-bold small">Thủ kho giao hàng</div>
                    <div class="text-muted small fst-italic mt-5">@Model.NguoiLap</div>
                </div>
                <div class="col-6">
                    <div class="fw-bold small">Người nhận hàng</div>
                    <div class="text-muted small fst-italic mt-5">@(Model.BoPhanNhan?.NguoiDaiDien ?? "(Ký, ghi rõ họ tên)")</div>
                </div>
            </div>
        </div>
    </div>
</div>
