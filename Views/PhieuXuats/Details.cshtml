@model QuanLyKhoHang_UNETI01_TI17A3HN.Models.PhieuXuat

@{
    ViewData["Title"] = "Chi tiết phiếu xuất #" + Model.MaPhieuXuat;
    var currentRole = Context.Session.GetString("VaiTro");
    var isAdmin = string.Equals(currentRole, "Admin", StringComparison.OrdinalIgnoreCase);
    var isWarehouseStaff = string.Equals(currentRole, "NhanVienKho", StringComparison.OrdinalIgnoreCase);
    var canManage = isAdmin || isWarehouseStaff;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-receipt"></i> Chi tiết phiếu xuất #@Model.MaPhieuXuat</h2>
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Danh sách phiếu xuất</a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-8">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-light fw-bold">Thông tin phiếu xuất</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-3 text-muted">Mã phiếu:</dt>
                    <dd class="col-sm-9 fw-semibold">PX@(Model.MaPhieuXuat.ToString("D4"))</dd>

                    <dt class="col-sm-3 text-muted">Ngày xuất:</dt>
                    <dd class="col-sm-9">@Model.NgayXuat.ToString("dd/MM/yyyy HH:mm")</dd>

                    <dt class="col-sm-3 text-muted">Người lập:</dt>
                    <dd class="col-sm-9">@Model.NguoiLap</dd>

                    <dt class="col-sm-3 text-muted">Bộ phận nhận:</dt>
                    <dd class="col-sm-9">@(Model.BoPhanNhan?.TenBoPhan ?? Model.MaBoPhan.ToString())</dd>

                    <dt class="col-sm-3 text-muted">Kho xuất:</dt>
                    <dd class="col-sm-9">@(Model.Kho?.TenKho ?? Model.MaKho.ToString())</dd>

                    <dt class="col-sm-3 text-muted">Ghi chú:</dt>
                    <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.GhiChu) ? "—" : Model.GhiChu)</dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-light fw-bold">Trạng thái & Tổng kết</div>
            <div class="card-body d-flex flex-column justify-content-between">
                <div>
                    <div class="mb-3">
                        <span class="text-muted d-block small">Trạng thái hiện tại:</span>
                        @switch (Model.TrangThai)
                        {
                            case TrangThaiPhieuXuat.Nhap:
                                <span class="badge bg-secondary fs-6">Nháp</span>
                                break;
                            case TrangThaiPhieuXuat.ChoXacNhan:
                                <span class="badge bg-warning text-dark fs-6">Chờ xác nhận</span>
                                break;
                            case TrangThaiPhieuXuat.DaHoanTat:
                                <span class="badge bg-success fs-6">Đã hoàn tất</span>
                                break;
                            case TrangThaiPhieuXuat.DaHuy:
                                <span class="badge bg-danger fs-6">Đã hủy</span>
                                break;
                        }
                    </div>
                    <ul class="list-unstyled mb-0">
                        <li class="d-flex justify-content-between py-1 border-bottom">
                            <span class="text-muted">Số mặt hàng:</span>
                            <span class="fw-semibold">@Model.SoMatHang</span>
                        </li>
                        <li class="d-flex justify-content-between py-1 border-bottom">
                            <span class="text-muted">Tổng số lượng xuất:</span>
                            <span class="fw-semibold text-primary">@Model.TongSoLuong</span>
                        </li>
                        <li class="d-flex justify-content-between py-1">
                            <span class="text-muted">Tổng tiền tham chiếu:</span>
                            <span class="fw-bold text-danger">@Model.TongTien.ToString("N0") VNĐ</span>
                        </li>
                    </ul>
                </div>

                @if (canManage)
                {
                    <div class="mt-3 pt-3 border-top d-flex flex-wrap gap-2">
                        @if (Model.TrangThai == TrangThaiPhieuXuat.Nhap || Model.TrangThai == TrangThaiPhieuXuat.ChoXacNhan)
                        {
                            <form asp-action="HoanTat" asp-route-id="@Model.MaPhieuXuat" method="post" class="d-inline" onsubmit="return confirm('Xác nhận hoàn tất xuất kho phiếu này? Số lượng tồn kho sẽ bị trừ đi tương ứng.');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-success btn-sm">
                                    <i class="bi bi-check-circle"></i> Hoàn tất xuất kho
                                </button>
                            </form>

                            <form asp-action="HuyPhieu" asp-route-id="@Model.MaPhieuXuat" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn hủy phiếu xuất này?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger btn-sm">
                                    <i class="bi bi-x-circle"></i> Hủy phiếu
                                </button>
                            </form>
                        }
                        else if (Model.TrangThai == TrangThaiPhieuXuat.DaHoanTat && isAdmin)
                        {
                            <form asp-action="HuyPhieu" asp-route-id="@Model.MaPhieuXuat" method="post" class="d-inline" onsubmit="return confirm('CẢNH BÁO: Hủy phiếu đã hoàn tất sẽ hoàn trả lại số lượng tồn kho và lưu lịch sử. Bạn có chắc chắn?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-danger btn-sm">
                                    <i class="bi bi-arrow-counterclockwise"></i> Hủy & Hoàn kho
                                </button>
                            </form>
                        }

                        @if (Model.TrangThai == TrangThaiPhieuXuat.Nhap || isAdmin)
                        {
                            <a asp-action="Edit" asp-route-id="@Model.MaPhieuXuat" class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-pencil"></i> Sửa phiếu
                            </a>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header bg-light d-flex justify-content-between align-items-center">
        <span class="fw-bold"><i class="bi bi-box-seam"></i> Danh sách mặt hàng xuất</span>
        @if (canManage && Model.TrangThai == TrangThaiPhieuXuat.Nhap)
        {
            <a asp-controller="ChiTietPhieuXuats" asp-action="Create" asp-route-maPhieuXuat="@Model.MaPhieuXuat" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-circle"></i> Thêm mặt hàng
            </a>
        }
    </div>
    <div class="card-body p-0 table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="text-center" style="width: 50px;">STT</th>
                    <th>Mã hàng</th>
                    <th>Tên hàng</th>
                    <th class="text-end">Số lượng</th>
                    <th class="text-end">Đơn giá tham chiếu</th>
                    <th class="text-end">Thành tiền</th>
                    <th>Ghi chú</th>
                    @if (canManage && Model.TrangThai == TrangThaiPhieuXuat.Nhap)
                    {
                        <th class="text-center" style="width: 140px;">Thao tác</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (Model.ChiTietPhieuXuats == null || !Model.ChiTietPhieuXuats.Any())
                {
                    <tr>
                        <td colspan="@(canManage && Model.TrangThai == TrangThaiPhieuXuat.Nhap ? 8 : 7)" class="text-center text-muted py-4">
                            Phiếu xuất này chưa có chi tiết mặt hàng nào.
                        </td>
                    </tr>
                }
                else
                {
                    int stt = 1;
                    foreach (var ct in Model.ChiTietPhieuXuats)
                    {
                        <tr>
                            <td class="text-center">@(stt++)</td>
                            <td>@(ct.HangHoa?.MaHang ?? ct.MaHang)</td>
                            <td class="fw-semibold">@(ct.HangHoa?.TenHang ?? "Mặt hàng #" + ct.MaHang)</td>
                            <td class="text-end fw-semibold">@ct.SoLuongXuat</td>
                            <td class="text-end">@ct.DonGiaXuatThamChieu.ToString("N0") VNĐ</td>
                            <td class="text-end text-danger fw-semibold">@ct.ThanhTien.ToString("N0") VNĐ</td>
                            <td>@(string.IsNullOrWhiteSpace(ct.GhiChu) ? "—" : ct.GhiChu)</td>
                            @if (canManage && Model.TrangThai == TrangThaiPhieuXuat.Nhap)
                            {
                                <td class="text-center">
                                    <a asp-controller="ChiTietPhieuXuats" asp-action="Edit" asp-route-id="@ct.MaChiTietXuat" class="btn btn-outline-primary btn-sm py-0 px-2">Sửa</a>
                                    <a asp-controller="ChiTietPhieuXuats" asp-action="Delete" asp-route-id="@ct.MaChiTietXuat" class="btn btn-outline-danger btn-sm py-0 px-2">Xóa</a>
                                </td>
                            }
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
