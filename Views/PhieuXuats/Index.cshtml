@model IEnumerable<QuanLyKhoHang_UNETI01_TI17A3HN.Models.PhieuXuat>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

@{
    var currentRole = Context.Session.GetString("VaiTro");
    var isAdmin = string.Equals(currentRole, "Admin", StringComparison.OrdinalIgnoreCase);
    var canManageExports = isAdmin || string.Equals(currentRole, "NhanVienKho", StringComparison.OrdinalIgnoreCase);
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}
@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="alert">@successMessage</div>
}

@if (canManageExports)
{
    <p>
        <a asp-action="Create">Tạo phiếu xuất</a>
    </p>
}
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.NgayXuat)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NguoiLap)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TrangThai)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.GhiChu)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.BoPhanNhan)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Kho)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.NgayXuat)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.NguoiLap)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TrangThai)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.GhiChu)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.BoPhanNhan.TenBoPhan)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Kho.TenKho)
            </td>
            <td>
                <a asp-controller="ChiTietPhieuXuats" asp-action="Index" asp-route-maPhieuXuat="@item.MaPhieuXuat">Chi tiết hàng</a> |
                <a asp-action="Details" asp-route-id="@item.MaPhieuXuat">Details</a> |
                @if (canManageExports && (item.TrangThai == TrangThaiPhieuXuat.Nhap || isAdmin))
                {
                    <span> | </span>
                    <a asp-action="Edit" asp-route-id="@item.MaPhieuXuat">Xử lý phiếu</a>
                }
                @if (canManageExports && item.TrangThai == TrangThaiPhieuXuat.Nhap)
                {
                    <span> | </span>
                    <a asp-action="Delete" asp-route-id="@item.MaPhieuXuat">Xóa nháp</a>
                }
            </td>
        </tr>
}
    </tbody>
</table>
