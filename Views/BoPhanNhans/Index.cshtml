@*
    Họ và tên: Nguyễn Việt Dũng
    Mã sinh viên: 23103100127
    Phụ trách Module 4: Bộ phận nhận, Phiếu xuất, Chi tiết phiếu xuất
*@
@model IEnumerable<QuanLyKhoHang_UNETI01_TI17A3HN.Models.BoPhanNhan>

@{
    ViewData["Title"] = "Danh mục Bộ phận nhận hàng";
}

<div class="page-header">
    <div>
        <h2 class="page-title"><i class="bi bi-shop text-primary"></i> Quản Lý Bộ Phận Nhận / Điểm Bán</h2>
        <p class="page-subtitle">Danh mục chi nhánh cửa hàng, phòng ban nhận hàng và đối tác tiếp nhận</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-circle-fill"></i> Thêm bộ phận nhận
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-2">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <span class="fw-semibold text-secondary">
            <i class="bi bi-shop me-1"></i> Tổng số: <strong>@(Model?.Count() ?? 0)</strong> đơn vị nhận
        </span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">Tên bộ phận / Cửa hàng</th>
                        <th>Người đại diện</th>
                        <th>Số điện thoại</th>
                        <th>Mô tả / Ghi chú</th>
                        <th class="text-center">Trạng thái</th>
                        <th class="text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle bg-success bg-opacity-10 text-success d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                                            <i class="bi bi-shop"></i>
                                        </div>
                                        <div>
                                            <strong class="text-dark d-block">@item.TenBoPhan</strong>
                                            <small class="text-muted font-monospace">#BPN-@item.MaBoPhan</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="fw-semibold text-secondary"><i class="bi bi-person me-1"></i>@(string.IsNullOrEmpty(item.NguoiDaiDien) ? "---" : item.NguoiDaiDien)</span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.SoDienThoai))
                                    {
                                        <a href="tel:@item.SoDienThoai" class="text-decoration-none text-muted small"><i class="bi bi-telephone text-success me-1"></i>@item.SoDienThoai</a>
                                    }
                                    else { <span class="text-muted small">---</span> }
                                </td>
                                <td>
                                    <span class="text-muted small">@(string.IsNullOrEmpty(item.MoTa) ? "---" : item.MoTa)</span>
                                </td>
                                <td class="text-center">
                                    @if (item.TrangThai)
                                    {
                                        <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i> Hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Ngừng HĐ</span>
                                    }
                                </td>
                                <td class="text-end pe-4 text-nowrap">
                                    <div class="d-inline-flex gap-1" role="group">
                                        <a asp-action="Details" asp-route-id="@item.MaBoPhan" class="btn btn-outline-info btn-sm text-nowrap" title="Xem chi tiết bộ phận">
                                            <i class="bi bi-eye me-1"></i> Chi tiết
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.MaBoPhan" class="btn btn-outline-primary btn-sm text-nowrap" title="Sửa thông tin bộ phận">
                                            <i class="bi bi-pencil-square me-1"></i> Sửa
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.MaBoPhan" class="btn btn-outline-danger btn-sm text-nowrap" title="Xóa bộ phận nhận">
                                            <i class="bi bi-trash me-1"></i> Xóa
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">Chưa có bộ phận nhận nào.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
