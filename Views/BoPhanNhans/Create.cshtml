@*
    Họ và tên: Nguyễn Việt Dũng
    Mã sinh viên: 23103100127
    Phụ trách Module 4: Bộ phận nhận, Phiếu xuất, Chi tiết phiếu xuất
*@
@model QuanLyKhoHang_UNETI01_TI17A3HN.Models.BoPhanNhan

@{
    ViewData["Title"] = "Thêm bộ phận nhận mới";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="page-header">
            <div>
                <h2 class="page-title"><i class="bi bi-shop text-primary"></i> Thêm Bộ Phận Nhận Mới</h2>
                <p class="page-subtitle">Khai báo chi nhánh cửa hàng hoặc đơn vị tiếp nhận hàng hóa xuất kho</p>
            </div>
            <div>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Quay lại danh sách
                </a>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4 p-md-5">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4 py-2" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-md-12">
                            <label asp-for="TenBoPhan" class="form-label fw-semibold">
                                <i class="bi bi-shop me-1 text-primary"></i> Tên bộ phận / Cửa hàng chi nhánh <span class="text-danger">*</span>
                            </label>
                            <input asp-for="TenBoPhan" class="form-control" placeholder="Ví dụ: Cửa hàng số 1 - Cầu Giấy, Kho bán lẻ..." />
                            <span asp-validation-for="TenBoPhan" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="NguoiDaiDien" class="form-label fw-semibold">
                                <i class="bi bi-person me-1 text-primary"></i> Người đại diện
                            </label>
                            <input asp-for="NguoiDaiDien" class="form-control" placeholder="Họ và tên quản lý..." />
                            <span asp-validation-for="NguoiDaiDien" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="SoDienThoai" class="form-label fw-semibold">
                                <i class="bi bi-telephone me-1 text-success"></i> Số điện thoại
                            </label>
                            <input asp-for="SoDienThoai" class="form-control" placeholder="0912..." />
                            <span asp-validation-for="SoDienThoai" class="text-danger small"></span>
                        </div>

                        <div class="col-md-12">
                            <label asp-for="MoTa" class="form-label fw-semibold">
                                <i class="bi bi-card-text me-1 text-primary"></i> Mô tả / Ghi chú
                            </label>
                            <textarea asp-for="MoTa" rows="3" class="form-control" placeholder="Địa chỉ chi nhánh, thời gian nhận hàng..."></textarea>
                            <span asp-validation-for="MoTa" class="text-danger small"></span>
                        </div>

                        <div class="col-md-12">
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" role="switch" asp-for="TrangThai" checked id="chkTrangThaiBPN" />
                                <label class="form-check-label fw-semibold" for="chkTrangThaiBPN">
                                    Đang hoạt động (Cho phép nhận hàng)
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary">Hủy bỏ</a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-check-circle-fill"></i> Lưu thông tin
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
