@*
    Họ và tên: Nguyễn Việt Dũng
    Mã sinh viên: 23103100127
    Phụ trách Module 4: Bộ phận nhận, Phiếu xuất, Chi tiết phiếu xuất
*@
@model QuanLyKhoHang_UNETI01_TI17A3HN.Models.BoPhanNhan

@{
    ViewData["Title"] = "Ngừng hoạt động bộ phận nhận";
    var draftExportCount = ViewData["DraftExportCount"] as int? ?? 0;
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card border-warning shadow-sm rounded-2 overflow-hidden">
            <div class="card-header bg-warning text-dark p-3 d-flex align-items-center gap-2">
                <i class="bi bi-exclamation-triangle-fill fs-4"></i>
                <h5 class="mb-0 fw-bold">Ngừng Hoạt Động Bộ Phận Nhận</h5>
            </div>
            <div class="card-body p-4">
                <p class="text-secondary fw-semibold">
                    Ngừng hoạt động bộ phận này? Dữ liệu phiếu xuất cũ sẽ được giữ nguyên trong hệ thống.
                </p>

                @if (draftExportCount > 0)
                {
                    <div class="alert alert-warning d-flex align-items-center gap-2" role="alert">
                        <i class="bi bi-exclamation-circle-fill fs-5"></i>
                        <div>
                            Không thể ngừng hoạt động vì bộ phận này đang được dùng trong <strong>@draftExportCount</strong> phiếu xuất Nháp.
                            Hãy xóa hoặc chuyển các phiếu Nháp sang bộ phận khác trước.
                        </div>
                    </div>
                }

                <div class="bg-light p-3 rounded-2 border mb-4">
                    <dl class="row gy-2 mb-0">
                        <dt class="col-sm-4 text-muted">Mã BPN:</dt>
                        <dd class="col-sm-8 font-monospace fw-bold">#@Model.MaBoPhan</dd>

                        <dt class="col-sm-4 text-muted">Tên bộ phận:</dt>
                        <dd class="col-sm-8 fw-bold">@Model.TenBoPhan</dd>

                        <dt class="col-sm-4 text-muted">Người đại diện:</dt>
                        <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.NguoiDaiDien) ? "---" : Model.NguoiDaiDien)</dd>

                        <dt class="col-sm-4 text-muted">Điện thoại:</dt>
                        <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.SoDienThoai) ? "---" : Model.SoDienThoai)</dd>

                        <dt class="col-sm-4 text-muted">Mô tả:</dt>
                        <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.MoTa) ? "---" : Model.MoTa)</dd>
                    </dl>
                </div>

                <form asp-action="Delete" method="post" class="d-flex justify-content-end gap-2">
                    <input type="hidden" asp-for="MaBoPhan" />
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-x-circle"></i> Hủy bỏ
                    </a>
                    <button type="submit" class="btn btn-danger" disabled="@(draftExportCount > 0)">
                        <i class="bi bi-slash-circle"></i> Ngừng hoạt động
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
