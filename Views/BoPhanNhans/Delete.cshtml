@model QuanLyKhoHang_UNETI01_TI17A3HN.Models.BoPhanNhan

@{
    ViewData["Title"] = "Delete";
    var draftExportCount = ViewData["DraftExportCount"] as int? ?? 0;
}

<h1>Delete</h1>

<h3>Ngừng hoạt động bộ phận này? Dữ liệu phiếu xuất cũ sẽ được giữ nguyên.</h3>
@if (draftExportCount > 0)
{
    <div class="alert alert-warning" role="alert">
        Không thể ngừng hoạt động vì bộ phận này đang được dùng trong @draftExportCount phiếu xuất Nháp.
        Hãy xóa hoặc chuyển các phiếu Nháp sang bộ phận khác trước.
    </div>
}
<div>
    <h4>BoPhanNhan</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.TenBoPhan)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.TenBoPhan)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.NguoiDaiDien)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.NguoiDaiDien)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.SoDienThoai)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.SoDienThoai)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.MoTa)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.MoTa)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.TrangThai)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.TrangThai)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="MaBoPhan" />
        <input type="submit" value="Ngừng hoạt động" class="btn btn-danger" disabled="@(draftExportCount > 0)" /> |
        <a asp-action="Index">Back to List</a>
    </form>
</div>
