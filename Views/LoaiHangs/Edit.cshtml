@*
    Họ và tên: Trần Xuân Hải
    Mã sinh viên: 23103100135
    Phụ trách Module 1: Tài khoản, Đăng nhập, Phân quyền, Loại hàng & Đơn vị tính
*@
@model QuanLyKhoHang_UNETI01_TI17A3HN.Models.LoaiHang

@{
    ViewData["Title"] = "Chỉnh sửa loại hàng - " + Model.TenLoaiHang;
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="page-header">
            <div>
                <h2 class="page-title"><i class="bi bi-pencil-square text-primary"></i> Chỉnh Sửa Loại Hàng</h2>
                <p class="page-subtitle">Cập nhật thông tin mã loại #@Model.MaLoaiHang: <strong>@Model.TenLoaiHang</strong></p>
            </div>
            <div>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Quay lại danh sách
                </a>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4 p-md-5">
                <form asp-action="Edit" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4 py-2" role="alert"></div>
                    <input type="hidden" asp-for="MaLoaiHang" />

                    <div class="mb-3">
                        <label asp-for="TenLoaiHang" class="form-label fw-semibold">
                            <i class="bi bi-tag me-1 text-primary"></i> Tên loại hàng <span class="text-danger">*</span>
                        </label>
                        <input asp-for="TenLoaiHang" class="form-control" />
                        <span asp-validation-for="TenLoaiHang" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="MoTa" class="form-label fw-semibold">
                            <i class="bi bi-card-text me-1 text-primary"></i> Mô tả nhóm hàng
                        </label>
                        <textarea asp-for="MoTa" rows="3" class="form-control"></textarea>
                        <span asp-validation-for="MoTa" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch" asp-for="TrangThai" id="chkEditTrangThaiLH" />
                            <label class="form-check-label fw-semibold" for="chkEditTrangThaiLH">
                                Đang sử dụng
                            </label>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary">Hủy bỏ</a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-check-circle-fill"></i> Cập nhật thay đổi
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
