@*
    Họ và tên: Trần Xuân Hải
    Mã sinh viên: 23103100135
    Phụ trách Module 1: Tài khoản, Đăng nhập, Phân quyền, Loại hàng & Đơn vị tính
*@
@model QuanLyKhoHang_UNETI01_TI17A3HN.Models.LoaiHang

@{
    ViewData["Title"] = "Xác nhận xóa loại hàng";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card border-danger shadow-sm rounded-2 overflow-hidden">
            <div class="card-header bg-danger text-white p-3 d-flex align-items-center gap-2">
                <i class="bi bi-exclamation-triangle-fill fs-4"></i>
                <h5 class="mb-0 fw-bold">Xác Nhận Xóa Loại Hàng</h5>
            </div>
            <div class="card-body p-4">
                <p class="text-danger fw-semibold">
                    Bạn có chắc chắn muốn xóa loại hàng này không? Chú ý: Nếu loại hàng đang được liên kết với sản phẩm trong danh mục, thao tác xóa có thể bị từ chối để bảo vệ toàn vẹn dữ liệu.
                </p>

                <div class="bg-light p-3 rounded-2 border mb-4">
                    <dl class="row gy-2 mb-0">
                        <dt class="col-sm-4 text-muted">Mã loại:</dt>
                        <dd class="col-sm-8 font-monospace fw-bold">#@Model.MaLoaiHang</dd>

                        <dt class="col-sm-4 text-muted">Tên loại hàng:</dt>
                        <dd class="col-sm-8 fw-bold">@Model.TenLoaiHang</dd>

                        <dt class="col-sm-4 text-muted">Mô tả:</dt>
                        <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.MoTa) ? "---" : Model.MoTa)</dd>
                    </dl>
                </div>

                <form asp-action="Delete" method="post" class="d-flex justify-content-end gap-2">
                    <input type="hidden" asp-for="MaLoaiHang" />
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-x-circle"></i> Hủy bỏ
                    </a>
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash-fill"></i> Xác nhận xóa
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
