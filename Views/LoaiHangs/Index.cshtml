@*
    Họ và tên: Trần Xuân Hải
    Mã sinh viên: 23103100135
    Phụ trách Module 1: Tài khoản, Đăng nhập, Phân quyền, Loại hàng & Đơn vị tính
*@
@model IEnumerable<QuanLyKhoHang_UNETI01_TI17A3HN.Models.LoaiHang>

@{
    ViewData["Title"] = "Danh mục Loại hàng hóa";
}

<div class="page-header">
    <div>
        <h2 class="page-title"><i class="bi bi-tags-fill text-warning"></i> Quản Lý Loại Hàng</h2>
        <p class="page-subtitle">Phân loại ngành hàng và nhóm sản phẩm kinh doanh</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-circle-fill"></i> Thêm loại hàng mới
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <span class="fw-semibold text-secondary">
            <i class="bi bi-tag me-1"></i> Tổng cộng: <strong>@(Model?.Count() ?? 0)</strong> phân loại
        </span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">Mã loại</th>
                        <th>Tên loại hàng</th>
                        <th>Mô tả chi tiết</th>
                        <th class="text-center">Trạng thái</th>
                        <th class="text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 font-monospace text-muted">#@item.MaLoaiHang</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle bg-warning bg-opacity-10 text-warning d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                                            <i class="bi bi-tag-fill"></i>
                                        </div>
                                        <strong class="text-dark">@item.TenLoaiHang</strong>
                                    </div>
                                </td>
                                <td>
                                    <span class="text-muted small">@(string.IsNullOrEmpty(item.MoTa) ? "---" : item.MoTa)</span>
                                </td>
                                <td class="text-center">
                                    @if (item.TrangThai)
                                    {
                                        <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i> Sử dụng</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Tạm ngừng</span>
                                    }
                                </td>
                                <td class="text-end pe-4 text-nowrap">
                                    <div class="d-inline-flex gap-1" role="group">
                                        <a asp-action="Details" asp-route-id="@item.MaLoaiHang" class="btn btn-outline-info btn-sm text-nowrap" title="Xem chi tiết loại hàng">
                                            <i class="bi bi-eye me-1"></i> Chi tiết
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.MaLoaiHang" class="btn btn-outline-primary btn-sm text-nowrap" title="Sửa loại hàng">
                                            <i class="bi bi-pencil-square me-1"></i> Sửa
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.MaLoaiHang" class="btn btn-outline-danger btn-sm text-nowrap" title="Xóa loại hàng">
                                            <i class="bi bi-trash me-1"></i> Xóa
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">Chưa có loại hàng nào được tạo.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
