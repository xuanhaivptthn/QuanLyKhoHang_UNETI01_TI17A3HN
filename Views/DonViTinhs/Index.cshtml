@*
    Họ và tên: Trần Xuân Hải
    Mã sinh viên: 23103100135
    Phụ trách Module 1: Tài khoản, Đăng nhập, Phân quyền, Loại hàng & Đơn vị tính
*@
@model IEnumerable<QuanLyKhoHang_UNETI01_TI17A3HN.Models.DonViTinh>

@{
    ViewData["Title"] = "Danh mục Đơn vị tính";
}

<div class="page-header">
    <div>
        <h2 class="page-title"><i class="bi bi-rulers text-secondary"></i> Quản Lý Đơn Vị Tính</h2>
        <p class="page-subtitle">Danh mục đơn vị đo lường và đóng gói sản phẩm (Chiếc, Hộp, Thùng, Kg...)</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-circle-fill"></i> Thêm đơn vị tính
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <span class="fw-semibold text-secondary">
            <i class="bi bi-list-ol me-1"></i> Tổng cộng: <strong>@(Model?.Count() ?? 0)</strong> đơn vị đo lường
        </span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">Mã ĐVT</th>
                        <th>Tên đơn vị tính</th>
                        <th>Mô tả</th>
                        <th class="text-center">Trạng thái</th>
                        <th class="text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 font-monospace text-muted">#@item.MaDonViTinh</td>
                                <td>
                                    <span class="badge bg-secondary-subtle text-dark border px-2 py-1 fs-6">
                                        @item.TenDonViTinh
                                    </span>
                                </td>
                                <td>
                                    <span class="text-muted small">@(string.IsNullOrEmpty(item.MoTa) ? "---" : item.MoTa)</span>
                                </td>
                                <td class="text-center">
                                    @if (item.TrangThai)
                                    {
                                        <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i> Sử dụng</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Tạm ngừng</span>
                                    }
                                </td>
                                <td class="text-end pe-4 text-nowrap">
                                    <div class="d-inline-flex gap-1" role="group">
                                        <a asp-action="Details" asp-route-id="@item.MaDonViTinh" class="btn btn-outline-info btn-sm text-nowrap" title="Xem chi tiết đơn vị tính">
                                            <i class="bi bi-eye me-1"></i> Chi tiết
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.MaDonViTinh" class="btn btn-outline-primary btn-sm text-nowrap" title="Sửa đơn vị tính">
                                            <i class="bi bi-pencil-square me-1"></i> Sửa
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.MaDonViTinh" class="btn btn-outline-danger btn-sm text-nowrap" title="Xóa đơn vị tính">
                                            <i class="bi bi-trash me-1"></i> Xóa
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">Chưa có đơn vị tính nào được khai báo.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
