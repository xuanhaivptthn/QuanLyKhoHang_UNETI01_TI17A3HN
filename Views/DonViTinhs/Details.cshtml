@*
    Họ và tên: Trần Xuân Hải
    Mã sinh viên: 23103100135
    Phụ trách Module 1: Tài khoản, Đăng nhập, Phân quyền, Loại hàng & Đơn vị tính
*@
@model QuanLyKhoHang_UNETI01_TI17A3HN.Models.DonViTinh

@{
    ViewData["Title"] = "Chi tiết đơn vị tính - " + Model.TenDonViTinh;
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="page-header">
            <div>
                <h2 class="page-title"><i class="bi bi-rulers text-secondary"></i> Chi Tiết Đơn Vị Tính</h2>
                <p class="page-subtitle">Thông tin quy cách đo lường sản phẩm</p>
            </div>
            <div>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Quay lại danh sách
                </a>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4">
                <div class="mb-3">
                    <span class="badge bg-light text-primary border font-monospace px-2 py-1">Mã ĐVT: #@Model.MaDonViTinh</span>
                    <h4 class="fw-bold text-dark mt-2 mb-1">@Model.TenDonViTinh</h4>
                </div>
                <hr class="text-secondary opacity-25" />
                <dl class="row gy-3 mb-0">
                    <dt class="col-sm-4 text-muted">Mô tả quy cách:</dt>
                    <dd class="col-sm-8 text-secondary">@(string.IsNullOrEmpty(Model.MoTa) ? "Chưa có mô tả." : Model.MoTa)</dd>

                    <dt class="col-sm-4 text-muted">Trạng thái:</dt>
                    <dd class="col-sm-8">
                        @if (Model.TrangThai)
                        {
                            <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i> Đang sử dụng</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary"><i class="bi bi-pause-circle me-1"></i> Tạm ngừng</span>
                        }
                    </dd>
                </dl>
            </div>
            <div class="card-footer bg-light p-3 d-flex justify-content-end gap-2">
                <a asp-action="Edit" asp-route-id="@Model.MaDonViTinh" class="btn btn-primary">
                    <i class="bi bi-pencil-square"></i> Chỉnh sửa
                </a>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    Quay lại
                </a>
            </div>
        </div>
    </div>
</div>
