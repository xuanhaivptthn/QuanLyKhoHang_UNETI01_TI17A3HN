@* // Họ và tên: Trần Xuân Hải // MSSV: 23103100135 *@
@*
    Họ và tên: Trần Xuân Hải
    Mã sinh viên: 23103100135
    Phụ trách Module 1: Khung giao diện chính, đồng bộ Menu Navbar theo vai trò & Badge người dùng
*@
@inject QuanLyKhoHang_UNETI01_TI17A3HN.Models.DatabaseInfo DbInfo
@{
    var isAuthenticated = (User.Identity?.IsAuthenticated == true) || (Context.Session.GetInt32("MaTaiKhoan") != null);
    var currentUserRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? Context.Session.GetString("VaiTro") ?? string.Empty;
    var currentUserName = User.FindFirst("HoTen")?.Value ?? Context.Session.GetString("HoTen") ?? User.Identity?.Name ?? string.Empty;
    var isAdmin = User.IsInRole("Admin") || string.Equals(currentUserRole, "Admin", StringComparison.OrdinalIgnoreCase);
    var isNhanVienKho = User.IsInRole("NhanVienKho") || string.Equals(currentUserRole, "NhanVienKho", StringComparison.OrdinalIgnoreCase);
    var isBoPhanNhan = User.IsInRole("BoPhanNhan") || string.Equals(currentUserRole, "BoPhanNhan", StringComparison.OrdinalIgnoreCase);

    var roleBadgeClass = "bg-secondary text-white";
    if (isAdmin)
    {
        roleBadgeClass = "bg-danger text-white";
    }
    else if (isNhanVienKho)
    {
        roleBadgeClass = "bg-primary text-white";
    }
    else if (isBoPhanNhan)
    {
        roleBadgeClass = "bg-success text-white";
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - QuanLyKhoHang_UNETI01_TI17A3HN</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/QuanLyKhoHang_UNETI01_TI17A3HN.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand d-inline-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                    <span>QuanLyKhoHang_UNETI01_TI17A3HN</span>
                    @if (DbInfo != null)
                    {
                        if (DbInfo.IsRemote)
                        {
                            <span class="badge rounded-pill bg-success text-white" style="font-size: 0.72rem; font-weight: 500;" title="Remote Database (Azure SQL): @DbInfo.ServerName (@DbInfo.DatabaseName)">
                                Remote DB
                            </span>
                        }
                        else
                        {
                            <span class="badge rounded-pill bg-secondary text-white" style="font-size: 0.72rem; font-weight: 500;" title="Local Database (LocalDB): @DbInfo.ServerName (@DbInfo.DatabaseName)">
                                Local DB
                            </span>
                        }
                    }
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (isAuthenticated)
                        {
                            @* 1. Dashboard, Kho, Hàng hóa: Dành cho Admin và Nhân viên kho *@
                            @if (isAdmin || isNhanVienKho)
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="ThongKe" asp-action="Dashboard">Dashboard</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Khoes" asp-action="Index">Kho</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="HangHoas" asp-action="Index">Hàng hóa</a>
                                </li>
                            }

                            @* 2. Bộ phận nhận: Chỉ dành cho Admin (Controller có [AuthorizeRole("Admin")]) *@
                            @if (User.IsInRole("Admin") || isAdmin)
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="BoPhanNhans" asp-action="Index">Bộ phận nhận</a>
                                </li>
                            }

                            @* 3. Nhà cung cấp, Phiếu nhập: Dành cho Admin và Nhân viên kho *@
                            @if (isAdmin || isNhanVienKho)
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="NhaCungCaps" asp-action="Index">Nhà cung cấp</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="PhieuNhaps" asp-action="Index">Phiếu nhập</a>
                                </li>
                            }

                            @* 4. Phiếu xuất: Dành cho Admin, Nhân viên kho và Bộ phận nhận (theo dõi giao nhận hàng) *@
                            @if (isAdmin || isNhanVienKho || isBoPhanNhan)
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="PhieuXuats" asp-action="Index">Phiếu xuất</a>
                                </li>
                            }

                            @* 5. Loại hàng & Đơn vị tính: Dành cho Admin và Nhân viên kho *@
                            @if (isAdmin || isNhanVienKho)
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="LoaiHangs" asp-action="Index">Loại hàng</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="DonViTinhs" asp-action="Index">Đơn vị tính</a>
                                </li>
                            }

                            @* 6. Quản lý tài khoản: CHỈ hiển thị khi User.IsInRole("Admin") *@
                            @if (User.IsInRole("Admin") || isAdmin)
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark fw-semibold" asp-area="" asp-controller="TaiKhoans" asp-action="Index">Tài khoản</a>
                                </li>
                            }

                            @* 7. Cảnh báo tồn & Lịch sử tồn kho: Dành cho Admin và Nhân viên kho *@
                            @if (isAdmin || isNhanVienKho)
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="TonKho" asp-action="CanhBao">Cảnh Báo Tồn</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="TonKho" asp-action="LichSu">Lịch Sử Nhập Xuất</a>
                                </li>
                            }
                        }
                    </ul>
                    <ul class="navbar-nav align-items-center">
                        @if (isAuthenticated)
                        {
                            <li class="nav-item me-2">
                                <a class="nav-link text-dark p-0 me-2" asp-area="" asp-controller="TaiKhoans" asp-action="Profile" title="Xem hồ sơ cá nhân">
                                    Xin chào: <strong>@currentUserName</strong>
                                    <span class="badge @roleBadgeClass ms-1">@currentUserRole</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-outline-danger btn-sm" asp-area="" asp-controller="TaiKhoans" asp-action="DangXuat">Đăng xuất</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-outline-primary btn-sm" asp-area="" asp-controller="TaiKhoans" asp-action="DangNhap">Đăng nhập</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @if (TempData["Error"] != null || TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                    @(TempData["Error"] ?? TempData["ErrorMessage"])
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["Success"] != null || TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                    @(TempData["Success"] ?? TempData["SuccessMessage"])
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - QuanLyKhoHang_UNETI01_TI17A3HN
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
