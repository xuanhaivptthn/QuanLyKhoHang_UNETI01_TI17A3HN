@inject QuanLyKhoHang_UNETI01_TI17A3HN.Models.DatabaseInfo DbInfo
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Kho Vận</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/QuanLyKhoHang_UNETI01_TI17A3HN.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <a class="brand" asp-controller="Home" asp-action="Index" aria-label="Kho Vận, trang chủ">
            <span class="brand-mark" aria-hidden="true">K</span><span>Kho Vận</span>
        </a>
        <div class="topbar-right">
            <span class="connection"><span class="status-dot" aria-hidden="true"></span>@(DbInfo?.IsRemote == true ? "Đang kết nối" : "Cơ sở dữ liệu nội bộ")</span>
            @if (Context.Session.GetInt32("MaTaiKhoan") != null)
            {
                <span class="user-name">@Context.Session.GetString("HoTen")</span>
                <a class="btn btn-outline-secondary btn-sm" asp-controller="TaiKhoan" asp-action="DangXuat">Đăng xuất</a>
            }
            else
            {
                <a class="btn btn-outline-primary btn-sm" asp-controller="TaiKhoan" asp-action="DangNhap">Đăng nhập</a>
            }
        </div>
    </header>
    <div class="app-shell">
        <aside class="sidebar" aria-label="Điều hướng chính">
            <div class="nav-caption">TỔNG QUAN</div>
            <a class="side-link @(currentController == "ThongKe" ? "selected" : "")" asp-controller="ThongKe" asp-action="Dashboard"><span aria-hidden="true">▦</span> Bảng điều khiển</a>
            <div class="nav-caption">QUẢN LÝ KHO</div>
            <a class="side-link @(currentController == "HangHoas" ? "selected" : "")" asp-controller="HangHoas" asp-action="Index"><span aria-hidden="true">▤</span> Hàng hóa</a>
            <a class="side-link @(currentController == "Khoes" ? "selected" : "")" asp-controller="Khoes" asp-action="Index"><span aria-hidden="true">⌂</span> Kho hàng</a>
            <a class="side-link @(currentController == "TonKho" ? "selected" : "")" asp-controller="TonKho" asp-action="CanhBao"><span aria-hidden="true">◷</span> Tồn kho & cảnh báo</a>
            <div class="nav-caption">GIAO DỊCH</div>
            <a class="side-link @(currentController == "PhieuNhaps" ? "selected" : "")" asp-controller="PhieuNhaps" asp-action="Index"><span aria-hidden="true">↓</span> Phiếu nhập</a>
            <a class="side-link @(currentController == "PhieuXuats" ? "selected" : "")" asp-controller="PhieuXuats" asp-action="Index"><span aria-hidden="true">↑</span> Phiếu xuất</a>
            <a class="side-link @(currentController == "ThongKe" && ViewContext.RouteData.Values["action"]?.ToString() == "BaoCaoNhapXuat" ? "selected" : "")" asp-controller="ThongKe" asp-action="BaoCaoNhapXuat"><span aria-hidden="true">▥</span> Báo cáo nhập xuất</a>
            <div class="nav-caption">DANH MỤC</div>
            <a class="side-link @(currentController == "NhaCungCaps" ? "selected" : "")" asp-controller="NhaCungCaps" asp-action="Index"><span aria-hidden="true">♧</span> Nhà cung cấp</a>
            <a class="side-link @(currentController == "BoPhanNhans" ? "selected" : "")" asp-controller="BoPhanNhans" asp-action="Index"><span aria-hidden="true">♙</span> Bộ phận nhận</a>
        </aside>
        <main class="main-content" id="main-content" role="main">@RenderBody()</main>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
