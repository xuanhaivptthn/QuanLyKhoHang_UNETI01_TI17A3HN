@inject QuanLyKhoHang_UNETI01_TI17A3HN.Models.DatabaseInfo DbInfo
@{
    var isAuthenticated = (User.Identity?.IsAuthenticated == true) || (Context.Session.GetInt32("MaTaiKhoan") != null);
    var currentUserRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? Context.Session.GetString("VaiTro") ?? "";
    var currentUserName = User.FindFirst("HoTen")?.Value ?? Context.Session.GetString("HoTen") ?? User.Identity?.Name ?? "Người dùng";
    var isAdmin = User.IsInRole("Admin") || string.Equals(currentUserRole, "Admin", StringComparison.OrdinalIgnoreCase);

    string CurrentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string CurrentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    bool IsController(params string[] controllers) =>
        controllers.Any(c => string.Equals(c, CurrentController, StringComparison.OrdinalIgnoreCase));

    bool IsAction(string controller, string action) =>
        string.Equals(controller, CurrentController, StringComparison.OrdinalIgnoreCase)
        && string.Equals(action, CurrentAction, StringComparison.OrdinalIgnoreCase);

    bool groupHangHoa = IsController("HangHoas", "Khoes", "LoaiHangs", "DonViTinhs");
    bool groupNhapKho = IsController("PhieuNhaps", "NhaCungCaps");
    bool groupXuatKho = IsController("PhieuXuats", "BoPhanNhans");
    bool groupTonKho = IsController("TonKho") || IsAction("ThongKe", "BaoCaoNhapXuat");
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản Lý Kho Hàng UNETI</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/QuanLyKhoHang_UNETI01_TI17A3HN.styles.css" asp-append-version="true" />
    @* Loaded early with defer so the theme IIFE sets data-theme before first paint *@
    <script src="~/js/site.js" asp-append-version="true" defer></script>
</head>
<body class="app-shell">
    <div class="sidebar-backdrop no-print" id="sidebarBackdrop"></div>

    <aside class="app-sidebar no-print" id="appSidebar">
        <div class="sidebar-brand">
            <a class="brand-link" asp-area="" asp-controller="Home" asp-action="Index">
                <span class="brand-mark"><i class="bi bi-box-seam-fill"></i></span>
                <span>Kho Hàng <strong>UNETI</strong></span>
            </a>
            <button class="sidebar-close d-xl-none" id="sidebarClose" type="button" aria-label="Đóng menu">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        @if (DbInfo != null)
        {
            <div class="sidebar-db-status">
                @if (DbInfo.IsRemote)
                {
                    <span class="db-badge db-badge-remote" title="Remote Database (Azure SQL): @DbInfo.ServerName (@DbInfo.DatabaseName)">
                        <i class="bi bi-cloud-check-fill"></i> Remote DB
                    </span>
                }
                else
                {
                    <span class="db-badge db-badge-local" title="Local Database (LocalDB): @DbInfo.ServerName (@DbInfo.DatabaseName)">
                        <i class="bi bi-hdd-fill"></i> Local DB
                    </span>
                }
            </div>
        }

        <nav class="sidebar-nav">
            <ul class="nav-list">
                <li class="nav-item">
                    <a class="nav-link @(IsController("Home") ? "active" : "")" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-house-door"></i> <span>Trang chủ</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(IsAction("ThongKe", "Dashboard") ? "active" : "")" asp-controller="ThongKe" asp-action="Dashboard">
                        <i class="bi bi-speedometer2"></i> <span>Dashboard</span>
                    </a>
                </li>

                <!-- Nhóm Hàng hóa & Kho -->
                <li class="nav-item">
                    <button class="nav-link nav-toggle @(groupHangHoa ? "active" : "")" type="button" data-bs-toggle="collapse" data-bs-target="#submenuHangHoa" aria-expanded="@(groupHangHoa ? "true" : "false")">
                        <i class="bi bi-boxes"></i> <span>Hàng hóa &amp; Kho</span>
                        <i class="bi bi-chevron-down nav-caret"></i>
                    </button>
                    <ul class="nav-sublist collapse @(groupHangHoa ? "show" : "")" id="submenuHangHoa">
                        <li>
                            <a class="nav-sublink @(IsController("HangHoas") ? "active" : "")" asp-controller="HangHoas" asp-action="Index">
                                <i class="bi bi-box-seam"></i> Danh sách Hàng hóa
                            </a>
                        </li>
                        <li>
                            <a class="nav-sublink @(IsController("Khoes") ? "active" : "")" asp-controller="Khoes" asp-action="Index">
                                <i class="bi bi-building"></i> Quản lý Kho hàng
                            </a>
                        </li>
                        <li>
                            <a class="nav-sublink @(IsController("LoaiHangs") ? "active" : "")" asp-controller="LoaiHangs" asp-action="Index">
                                <i class="bi bi-tags"></i> Loại hàng
                            </a>
                        </li>
                        <li>
                            <a class="nav-sublink @(IsController("DonViTinhs") ? "active" : "")" asp-controller="DonViTinhs" asp-action="Index">
                                <i class="bi bi-rulers"></i> Đơn vị tính
                            </a>
                        </li>
                    </ul>
                </li>

                <!-- Nhóm Nhập kho -->
                <li class="nav-item">
                    <button class="nav-link nav-toggle @(groupNhapKho ? "active" : "")" type="button" data-bs-toggle="collapse" data-bs-target="#submenuNhapKho" aria-expanded="@(groupNhapKho ? "true" : "false")">
                        <i class="bi bi-box-arrow-in-down"></i> <span>Nhập kho</span>
                        <i class="bi bi-chevron-down nav-caret"></i>
                    </button>
                    <ul class="nav-sublist collapse @(groupNhapKho ? "show" : "")" id="submenuNhapKho">
                        <li>
                            <a class="nav-sublink @(IsAction("PhieuNhaps", "Index") ? "active" : "")" asp-controller="PhieuNhaps" asp-action="Index">
                                <i class="bi bi-receipt"></i> Danh sách Phiếu nhập
                            </a>
                        </li>
                        <li>
                            <a class="nav-sublink @(IsAction("PhieuNhaps", "Create") ? "active" : "")" asp-controller="PhieuNhaps" asp-action="Create">
                                <i class="bi bi-plus-circle"></i> Tạo phiếu nhập mới
                            </a>
                        </li>
                        <li>
                            <a class="nav-sublink @(IsController("NhaCungCaps") ? "active" : "")" asp-controller="NhaCungCaps" asp-action="Index">
                                <i class="bi bi-truck"></i> Nhà cung cấp
                            </a>
                        </li>
                    </ul>
                </li>

                <!-- Nhóm Xuất kho -->
                <li class="nav-item">
                    <button class="nav-link nav-toggle @(groupXuatKho ? "active" : "")" type="button" data-bs-toggle="collapse" data-bs-target="#submenuXuatKho" aria-expanded="@(groupXuatKho ? "true" : "false")">
                        <i class="bi bi-box-arrow-up-right"></i> <span>Xuất kho</span>
                        <i class="bi bi-chevron-down nav-caret"></i>
                    </button>
                    <ul class="nav-sublist collapse @(groupXuatKho ? "show" : "")" id="submenuXuatKho">
                        <li>
                            <a class="nav-sublink @(IsAction("PhieuXuats", "Index") ? "active" : "")" asp-controller="PhieuXuats" asp-action="Index">
                                <i class="bi bi-receipt-cutoff"></i> Danh sách Phiếu xuất
                            </a>
                        </li>
                        <li>
                            <a class="nav-sublink @(IsAction("PhieuXuats", "Create") ? "active" : "")" asp-controller="PhieuXuats" asp-action="Create">
                                <i class="bi bi-plus-circle"></i> Tạo phiếu xuất mới
                            </a>
                        </li>
                        <li>
                            <a class="nav-sublink @(IsController("BoPhanNhans") ? "active" : "")" asp-controller="BoPhanNhans" asp-action="Index">
                                <i class="bi bi-shop"></i> Bộ phận nhận / Cửa hàng
                            </a>
                        </li>
                    </ul>
                </li>

                <!-- Nhóm Tồn kho & Báo cáo -->
                <li class="nav-item">
                    <button class="nav-link nav-toggle @(groupTonKho ? "active" : "")" type="button" data-bs-toggle="collapse" data-bs-target="#submenuTonKho" aria-expanded="@(groupTonKho ? "true" : "false")">
                        <i class="bi bi-clipboard2-data"></i> <span>Tồn kho &amp; Báo cáo</span>
                        <i class="bi bi-chevron-down nav-caret"></i>
                    </button>
                    <ul class="nav-sublist collapse @(groupTonKho ? "show" : "")" id="submenuTonKho">
                        <li>
                            <a class="nav-sublink @(IsAction("TonKho", "CanhBao") ? "active" : "")" asp-controller="TonKho" asp-action="CanhBao">
                                <i class="bi bi-exclamation-triangle-fill"></i> Cảnh báo hạn mức tồn
                            </a>
                        </li>
                        <li>
                            <a class="nav-sublink @(IsAction("TonKho", "LichSu") ? "active" : "")" asp-controller="TonKho" asp-action="LichSu">
                                <i class="bi bi-clock-history"></i> Lịch sử biến động kho
                            </a>
                        </li>
                        <li>
                            <a class="nav-sublink @(IsAction("ThongKe", "BaoCaoNhapXuat") ? "active" : "")" asp-controller="ThongKe" asp-action="BaoCaoNhapXuat">
                                <i class="bi bi-file-earmark-bar-graph"></i> Báo cáo tổng hợp Nhập - Xuất
                            </a>
                        </li>
                    </ul>
                </li>

                @if (isAdmin)
                {
                    <li class="nav-item">
                        <a class="nav-link @(IsController("TaiKhoans") && !IsAction("TaiKhoans", "Profile") && !IsAction("TaiKhoans", "CapNhatProfile") && !IsAction("TaiKhoans", "DoiMatKhau") ? "active" : "")" asp-controller="TaiKhoans" asp-action="Index">
                            <i class="bi bi-people"></i> <span>Quản trị Tài khoản</span>
                        </a>
                    </li>
                }
            </ul>
        </nav>
    </aside>

    <div class="app-main">
        <header class="app-topbar no-print">
            <button class="sidebar-toggle" id="sidebarToggle" type="button" aria-label="Mở menu">
                <i class="bi bi-list"></i>
            </button>
            <span class="topbar-title">@ViewData["Title"]</span>

            @* Theme toggle — pushes to right edge, dropdown sits beside it *@
            <button class="theme-toggle ms-auto" id="themeToggle" type="button"
                    title="Chuyển chế độ sáng / tối" aria-label="Chuyển chế độ sáng / tối">
                <i class="bi bi-moon-stars-fill icon-moon"></i>
                <i class="bi bi-sun-fill icon-sun"></i>
            </button>

            @if (isAuthenticated)
            {
                <div class="dropdown">
                    <button class="btn btn-sm btn-light border d-inline-flex align-items-center gap-2 dropdown-toggle shadow-none" type="button" id="topbarUserDropdown" data-bs-toggle="dropdown" aria-expanded="false" title="Menu tài khoản">
                        <i class="bi bi-person-circle text-primary fs-6"></i>
                        <span class="fw-semibold text-dark d-none d-sm-inline">@currentUserName</span>
                        <span class="badge @(isAdmin ? "bg-danger" : "bg-primary") d-none d-md-inline-block">@currentUserRole</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm border py-2" aria-labelledby="topbarUserDropdown" style="min-width: 220px;">
                        <li class="px-3 py-2 border-bottom mb-1 bg-light bg-opacity-50">
                            <div class="fw-bold text-dark text-truncate">@currentUserName</div>
                            <small class="text-muted d-block"><i class="bi bi-shield-check me-1"></i>Vai trò: @currentUserRole</small>
                        </li>
                        <li>
                            <a class="dropdown-item d-flex align-items-center gap-2 py-2" asp-controller="TaiKhoans" asp-action="Profile">
                                <i class="bi bi-person text-primary"></i>
                                <span>Hồ sơ cá nhân</span>
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item d-flex align-items-center gap-2 py-2" asp-controller="TaiKhoans" asp-action="DoiMatKhau">
                                <i class="bi bi-key text-warning"></i>
                                <span>Đổi mật khẩu</span>
                            </a>
                        </li>
                        <li><hr class="dropdown-divider my-1"></li>
                        <li>
                            <a class="dropdown-item d-flex align-items-center gap-2 py-2 text-danger" asp-controller="TaiKhoans" asp-action="DangXuat">
                                <i class="bi bi-box-arrow-right"></i>
                                <span>Thoát tài khoản</span>
                            </a>
                        </li>
                    </ul>
                </div>
            }
            else
            {
                <a class="btn btn-sm btn-primary d-inline-flex align-items-center gap-1" asp-controller="TaiKhoans" asp-action="DangNhap">
                    <i class="bi bi-box-arrow-in-right"></i> <span>Đăng nhập</span>
                </a>
            }
        </header>


        <div class="app-content">
            <main role="main">
                @if (TempData["Error"] != null || TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-3" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        @(TempData["Error"] ?? TempData["ErrorMessage"])
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["Success"] != null || TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show shadow-sm mb-3" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i>
                        @(TempData["Success"] ?? TempData["SuccessMessage"])
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
